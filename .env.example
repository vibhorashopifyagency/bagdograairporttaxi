# Copy to .env for local work. On Vercel, set these under
# Project Settings > Environment Variables (the Neon integration adds the
# DATABASE_* ones by itself).

# Neon Postgres. Use the pooled URL (host contains "-pooler") here.
DATABASE_URL=postgres://user:password@ep-example-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# Direct (unpooled) URL, used only to run migrations.
DATABASE_URL_UNPOOLED=
# Local only: PGlite accepts one connection at a time.
# DATABASE_POOL_MAX=1

# Login system. Make the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# The site's address in this environment, e.g. https://bagdograairporttaxi.com
BETTER_AUTH_URL=http://localhost:4321

# One-time code that unlocks /admin/setup/ to create the first admin account.
# Remove it once the admin exists. Make it with: openssl rand -hex 16
SETUP_TOKEN=

# Backup email for each new booking (Resend). Optional: without these the
# booking is still saved and WhatsApp still opens.
RESEND_API_KEY=
MAIL_FROM=Bagdogra Airport Taxi <bookings@bagdograairporttaxi.com>
# Defaults to the email address shown on the site.
BOOKING_EMAIL_TO=

# Lets Vercel's nightly job remove customer details 24 months after the trip
# (/api/cron/retention/). Make it with: openssl rand -hex 32
CRON_SECRET=

# Website editing: the dashboard's Publish button calls this Vercel deploy hook
# (Project Settings > Git > Deploy Hooks, branch main), and the new deploy
# builds the site with the published edits. Not needed locally: there,
# Publish copies the edits into .content/ itself.
VERCEL_DEPLOY_HOOK_URL=
