---
/**
 * The facts an answer engine (or a traveller in a hurry) wants in one place:
 * where we are, what a ride costs, what every fare includes, how booking
 * works. A definition list, because that is the structure AI assistants
 * extract most reliably, and every value is read from the data files so it
 * can never disagree with the fare chart, the policies or the JSON-LD.
 *
 * Each fact is a card with one big figure, so the band reads like a
 * departures board rather than a terms page: a photo behind, a lime glow,
 * an icon and the number first, the sentence under it.
 */
import SectionHead from './SectionHead.astro';
import Photo from './Photo.astro';
import Icon from './Icon.astro';
import { BUSINESS, POLICY, SITE, waLink } from '../data/site';
import { ROUTES, inr } from '../data/routes';
import { VEHICLES } from '../data/vehicles';
import { GOOGLE } from '../data/reviews';

const byTo = (to: string) => ROUTES.find((r) => r.fromShort === 'Bagdogra Airport' && r.toShort === to);
const darj = byTo('Darjeeling')!;
const gtk = byTo('Gangtok')!;
const sil = byTo('Siliguri');
const njp = byTo('NJP');
const airportRoutes = ROUTES.filter((r) => r.fromShort === 'Bagdogra Airport').length;
const since = new Date().getFullYear() - Number(BUSINESS.foundingYear);
const seats = VEHICLES.map((v) => v.seats);

type IconName = 'shield' | 'map' | 'car' | 'card' | 'clock' | 'check' | 'refund' | 'phone' | 'star';
interface Fact { term: string; figure: string; unit?: string; icon: IconName; detail: string; href?: string; cta?: string }
const facts: Fact[] = [
  {
    term: 'Who we are',
    figure: `${since}+`, unit: 'years on the road', icon: 'shield',
    detail: `${SITE.name} is a unit of ${BUSINESS.legalName}, a local taxi and tour operator at ${BUSINESS.address.locality}, ${BUSINESS.address.region}, driving airport transfers and hill tours since ${BUSINESS.foundingYear}.`,
    href: '/about/', cta: 'About us',
  },
  {
    term: 'Where we pick up',
    figure: sil ? `${sil.km} km` : 'IXB', unit: sil ? 'airport to Siliguri' : 'Bagdogra Airport', icon: 'map',
    detail: `Bagdogra Airport (IXB)${njp ? `, ${njp.km} km from NJP railway station` : ''}. Also NJP, Siliguri Junction and any hotel or home in Siliguri, at the same fares.`,
    href: '/taxi/', cta: 'All pickup points',
  },
  {
    term: 'Taxi to Darjeeling',
    figure: inr(darj.fares.sedan), unit: `sedan · ${darj.km} km · ${darj.duration}`, icon: 'car',
    detail: `One way, tolls and parking included. ${inr(darj.fares.innova)} in an Innova Crysta. Up by Rohini Road and Kurseong.`,
    href: `/taxi/${darj.slug}/`, cta: 'Darjeeling fares',
  },
  {
    term: 'Taxi to Gangtok',
    figure: inr(gtk.fares.sedan), unit: `sedan · ${gtk.km} km · ${gtk.duration}`, icon: 'car',
    detail: `One way, ${inr(gtk.fares.innova)} in an Innova Crysta. The same car takes you to your hotel: no change at the Sikkim border.`,
    href: `/taxi/${gtk.slug}/`, cta: 'Gangtok fares',
  },
  {
    term: 'What a fare includes',
    figure: `${airportRoutes}`, unit: 'fixed routes from the airport', icon: 'card',
    detail: `Fuel, tolls, parking, driver allowance and GST, all in. Fares are per car, not per person, shown before you book and last updated in ${SITE.faresUpdatedLabel}.`,
    href: '/taxi/', cta: 'Full fare chart',
  },
  {
    term: 'The only extras',
    figure: inr(POLICY.nightCharge), unit: `night pickups ${POLICY.nightChargeFrom} to ${POLICY.nightChargeTo}`, icon: 'clock',
    detail: 'That, and government permit fees for protected areas in Sikkim. Nothing else is ever added to the fare.',
    href: '/guides/sikkim-permit-guide/', cta: 'Permit guide',
  },
  {
    term: 'Cars',
    figure: `${Math.min(...seats)} to ${Math.max(...seats)}`, unit: 'seats', icon: 'car',
    detail: VEHICLES.map((v) => `${v.name} (${v.seats})`).join(', ') + '. All commercially registered, insured and cleaned before each pickup.',
    href: '/book/', cta: 'Pick a car',
  },
  {
    term: 'How to book',
    figure: `${POLICY.advancePercent}%`, unit: 'advance, the rest after the trip', icon: 'check',
    detail: 'Choose the route and car online, pay the advance by UPI or card, and the confirmation arrives on WhatsApp with the driver’s details the evening before.',
    href: '/book/', cta: 'Book now',
  },
  {
    term: 'If your flight is late',
    figure: `${POLICY.freeWaitMinutes} min`, unit: 'free waiting after landing', icon: 'clock',
    detail: 'We track the flight, so the driver arrives when you do. A delay never cancels the booking.',
    href: '/faq/', cta: 'Delays and waiting',
  },
  {
    term: 'Cancellation',
    figure: `${POLICY.freeCancelHours} h`, unit: 'free cancellation before pickup', icon: 'refund',
    detail: `Full refund of the advance within ${POLICY.refundDays} working days. Inside ${POLICY.freeCancelHours} hours, ${POLICY.lateCancelRefundPercent}% is refunded.`,
    href: '/cancellation-refund-policy/', cta: 'Refund policy',
  },
  {
    term: 'Office and hours',
    figure: '24/7', unit: 'one number, always answered', icon: 'phone',
    detail: `${BUSINESS.address.street}, ${BUSINESS.address.locality} ${BUSINESS.address.postalCode}. ${BUSINESS.hours}. We speak English, Hindi, Bengali and Nepali.`,
    href: BUSINESS.phoneHref, cta: BUSINESS.phone,
  },
  ...(GOOGLE.hasSchema
    ? [{
        term: 'Google rating',
        figure: GOOGLE.rating.toFixed(1), unit: `from ${GOOGLE.count.toLocaleString('en-IN')} Google reviews`, icon: 'star',
        detail: 'Every review on this site links back to the original on our Google Business Profile.',
        href: GOOGLE.url, cta: 'See on Google',
      } satisfies Fact]
    : []),
];
const external = (href: string) => href.startsWith('http');
---

<section class="relative isolate overflow-hidden bg-ink section text-white" aria-labelledby="facts" id="key-facts">
  <Photo name="north-sikkim" class="absolute inset-0 h-full w-full object-cover object-[center_60%] opacity-30" sizes="100vw" alt="" />
  <div class="absolute inset-0 bg-gradient-to-b from-ink via-ink/80 to-ink" aria-hidden="true"></div>
  <div class="absolute -top-40 right-[-10%] h-[520px] w-[520px] rounded-full bg-lime/15 blur-3xl" aria-hidden="true"></div>
  <div class="wrap relative">
    <div class="flex flex-wrap items-end justify-between gap-x-8 gap-y-6" data-reveal>
      <SectionHead light eyebrow="Key facts" id="facts" title={`${SITE.name} at a glance`} lead="Everything a traveller usually asks before booking, in one place. Every figure here is the same one on the fare chart, the booking form and the policy pages." />
      <p class="inline-flex items-center gap-2 rounded-full bg-white/10 px-3.5 py-1.5 text-sm font-semibold text-white ring-1 ring-white/20 backdrop-blur">
        <span class="live-dot" aria-hidden="true"></span> Figures correct as of <time datetime={SITE.contentUpdated}>{SITE.contentUpdatedLabel}</time>
      </p>
    </div>

    <dl class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4" data-reveal-stagger>
      {facts.map((f) => (
        <div class="group relative flex flex-col rounded-2xl border border-white/10 bg-white/5 p-5 backdrop-blur-sm transition-colors hover:border-lime/60 hover:bg-white/10">
          <dt class="flex items-center gap-3">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-lime text-ink transition-transform group-hover:scale-110"><Icon name={f.icon} class="h-5 w-5" /></span>
            <span class="text-[0.7rem] font-bold tracking-[0.14em] text-white/70 uppercase">{f.term}</span>
          </dt>
          <dd class="mt-4 flex flex-1 flex-col">
            <span class="font-[family-name:var(--font-display)] text-3xl leading-none font-extrabold text-lime tabular-nums sm:text-[2.1rem]">{f.figure}</span>
            {f.unit && <span class="mt-1.5 text-sm font-medium text-white/85">{f.unit}</span>}
            <span class="mt-3 text-[0.95rem] leading-relaxed text-white/70">{f.detail}</span>
            {f.href && (
              <a href={f.href} target={external(f.href) ? '_blank' : undefined} rel={external(f.href) ? 'noopener' : undefined} class="mt-auto inline-flex items-center gap-1.5 pt-4 text-sm font-semibold text-white no-underline hover:text-lime">
                {f.cta} <Icon name="arrow" class="h-4 w-4 transition-transform group-hover:translate-x-1" />
              </a>
            )}
          </dd>
        </div>
      ))}
    </dl>

    <div class="mt-10 flex flex-wrap items-center gap-4" data-reveal>
      <a href="/book/" class="btn-lime">Book a taxi <Icon name="arrow" /></a>
      <a href={waLink('Hi, I have a question before booking a taxi from Bagdogra Airport.')} rel="noopener" class="btn-light"><Icon name="whatsapp" /> Ask on WhatsApp</a>
      <span class="text-sm text-white/70">Only {POLICY.advancePercent}% now. Free cancellation up to {POLICY.freeCancelHours} hours before.</span>
    </div>
  </div>
</section>
