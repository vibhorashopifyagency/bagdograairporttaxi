---
/**
 * A tiny inline icon. The paths live in src/lib/icons.ts and are drawn once
 * per page by IconSprite.astro (in BaseLayout), so each icon here is a short
 * <use> reference rather than another copy of the path.
 */
import { ICONS, type IconName } from '../lib/icons';
interface Props {
  name: IconName;
  class?: string;
}
const { name, class: cls = 'h-5 w-5' } = Astro.props;
if (!(name in ICONS)) throw new Error(`Unknown icon "${name}". Add it to src/lib/icons.ts.`);
---

{name === 'whatsapp' ? (
  <svg class={cls} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><use href="#i-whatsapp" /></svg>
) : (
  <svg class={cls} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href={`#i-${name}`} /></svg>
)}
