---
/** Google's four-colour "G". Drawn once in IconSprite.astro and referenced here, so it costs no request and no repeated markup. */
interface Props { class?: string }
const { class: cls = 'h-5 w-5' } = Astro.props;
---

<svg class={cls} viewBox="0 0 48 48" aria-hidden="true"><use href="#i-google" /></svg>
