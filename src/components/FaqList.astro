---
import type { Faq } from '../data/routes';
interface Props {
  faqs: Faq[];
  heading?: string;
}
const { faqs, heading = 'Frequently asked questions' } = Astro.props;
---

<section aria-labelledby="faq-h" class="mt-12">
  <h2 id="faq-h" class="mb-4 text-2xl font-bold">{heading}</h2>
  <div class="divide-y divide-line rounded-xl border border-line">
    {faqs.map((f) => (
      <details class="group p-4 sm:p-5">
        <summary class="flex cursor-pointer list-none items-start justify-between gap-4 font-semibold text-ink">
          <h3 class="text-base sm:text-lg">{f.q}</h3>
          <span class="mt-1 text-pine transition-transform group-open:rotate-45" aria-hidden="true">+</span>
        </summary>
        <p class="mt-3 leading-relaxed">{f.a}</p>
      </details>
    ))}
  </div>
</section>
