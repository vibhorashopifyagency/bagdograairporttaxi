---
import Icon from './Icon.astro';
import Words from './Words.astro';
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
// The words are the "Promises strip" in the dashboard (src/data/page-text.ts).
const items = [
  { icon: 'card', n: 'p1' },
  { icon: 'clock', n: 'p2' },
  { icon: 'refund', n: 'p3' },
  { icon: 'shield', n: 'p4' },
] as const;
---

<ul class:list={['grid gap-3 sm:grid-cols-2 lg:grid-cols-4', cls]}>
  {items.map((it) => (
    <li class="card flex gap-3.5 p-4 sm:p-5">
      <span class="mt-0.5 flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-lime-50 text-lime-text"><Icon name={it.icon} /></span>
      <span>
        <Words page="promises" field={`${it.n}Title`} as="strong" class="block font-[family-name:var(--font-display)] text-[1.05rem] text-ink" />
        <Words page="promises" field={`${it.n}Text`} class="mt-0.5 block text-sm leading-snug text-muted" />
      </span>
    </li>
  ))}
</ul>
