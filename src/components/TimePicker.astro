---
/**
 * A time field for the site's forms, in place of the browser's own time
 * input: one list of the day's times in 15-minute steps. Tap a time and it
 * is chosen. The list opens on the time already chosen, or on the next one
 * coming up in India. Times inside a night-charge window say so on the row.
 * The form still receives a 24-hour HH:MM value in a hidden input named
 * `name`, as the server and the night-charge check expect.
 */
import Icon from './Icon.astro';
import '../styles/picker.css';

interface Props {
  name: string;
  label: string;
  placeholder?: string;
  /** A night-charge window as 24-hour HH:MM times; the times inside it carry `nightTag`. */
  nightFrom?: string;
  nightTo?: string;
  nightTag?: string;
  class?: string;
}
const { name, label, placeholder = 'Choose a time', nightFrom, nightTo, nightTag = 'Night charge', class: cls } = Astro.props;
const id = `tp-${name}`;
const pad = (n: number) => String(n).padStart(2, '0');
const isNight = (t: string) =>
  !!nightFrom && !!nightTo && (nightFrom > nightTo ? t >= nightFrom || t < nightTo : t >= nightFrom && t < nightTo);
const SLOTS = Array.from({ length: 96 }, (_, i) => {
  const h = Math.floor(i / 4);
  const m = (i % 4) * 15;
  const value = `${pad(h)}:${pad(m)}`;
  const text = `${h % 12 || 12}:${pad(m)} ${h < 12 ? 'AM' : 'PM'}`;
  return { value, text, note: value === '00:00' ? 'midnight' : value === '12:00' ? 'noon' : '', night: isNight(value) };
});
---

<div class:list={['pk', cls]} data-picker data-timepicker data-placeholder={placeholder}>
  <span class="pk-label" id={`${id}-label`}>{label}</span>
  <input type="hidden" name={name} />
  <button
    type="button"
    class="pk-trigger"
    id={`${id}-btn`}
    aria-haspopup="dialog"
    aria-expanded="false"
    aria-controls={`${id}-pop`}
    aria-labelledby={`${id}-label ${id}-btn`}
  >
    <Icon name="clock" class="pk-icon" />
    <span class="pk-value is-empty">{placeholder}</span>
    <Icon name="down" class="pk-chev" />
  </button>

  <div class="pk-pop tp-pop" id={`${id}-pop`} role="dialog" aria-labelledby={`${id}-label`} hidden>
    <div class="tp-list" role="group" aria-labelledby={`${id}-label`}>
      {SLOTS.map((s) => (
        <button type="button" class="tp-opt" data-tp={s.value} aria-pressed="false" tabindex="-1">
          <span>{s.text}{s.note && <span class="tp-note"> ({s.note})</span>}</span>
          {s.night && <span class="tp-tag">{nightTag}</span>}
        </button>
      ))}
    </div>
  </div>
</div>

<script>
  import { picker, rove } from '../lib/picker';

  const pad = (n: number) => String(n).padStart(2, '0');
  /** "14:30" reads "2:30 PM"; noon and midnight are named, so nobody books the wrong night. */
  function label(v: string) {
    const [h, m] = v.split(':').map(Number);
    const t = `${h % 12 || 12}:${pad(m)} ${h < 12 ? 'AM' : 'PM'}`;
    return v === '00:00' ? `${t}, midnight` : v === '12:00' ? `${t}, noon` : t;
  }
  const istNow = new Intl.DateTimeFormat('en-GB', { timeZone: 'Asia/Kolkata', hour: '2-digit', minute: '2-digit', hourCycle: 'h23' });

  function init(root: HTMLElement) {
    const list = root.querySelector<HTMLElement>('.tp-list')!;
    const opts = [...list.querySelectorAll<HTMLButtonElement>('[data-tp]')];

    const p = picker(root, {
      label,
      prepare() {
        const v = p.input.value;
        // The chosen time, or else the next quarter hour coming up in India.
        let at = opts.find((b) => b.dataset.tp === v);
        if (!at) {
          const [h, m] = istNow.format(new Date()).split(':').map(Number);
          at = opts[Math.ceil((h * 60 + m) / 15) % opts.length];
        }
        opts.forEach((b) => {
          b.setAttribute('aria-pressed', String(b.dataset.tp === v));
          b.tabIndex = b === at ? 0 : -1;
        });
        // Once the panel shows, put that time in the middle of the list.
        requestAnimationFrame(() => (list.scrollTop = at.offsetTop - (list.clientHeight - at.offsetHeight) / 2));
        return at;
      },
    });

    opts.forEach((b) => b.addEventListener('click', () => p.set(b.dataset.tp!, true)));
    rove(opts, 1);
  }

  document.querySelectorAll<HTMLElement>('[data-timepicker]').forEach(init);
</script>

<style is:global>
  .tp-pop { padding: 0.375rem; }
  /* Soft top and bottom edges hint that the list scrolls. */
  .tp-list {
    position: relative; max-height: min(20rem, 55vh); overflow-y: auto; overscroll-behavior: contain;
    mask-image: linear-gradient(transparent, #000 1rem, #000 calc(100% - 1rem), transparent);
  }
  .tp-opt {
    display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; width: 100%;
    min-height: 2.75rem; padding: 0 0.875rem; border-radius: 0.625rem;
    font-size: 1rem; font-weight: 500; color: var(--color-ink); text-align: left;
    font-variant-numeric: tabular-nums; transition: background-color 0.12s ease, color 0.12s ease;
  }
  .tp-opt:hover:not([aria-pressed='true']) { background: var(--color-mist); }
  .tp-opt:focus-visible { outline-offset: -2px; }
  .tp-opt[aria-pressed='true'] { background: var(--color-ink); color: #fff; font-weight: 700; }
  .tp-note { font-weight: 400; color: var(--color-muted); }
  .tp-tag { flex: none; font-size: 0.8125rem; font-weight: 500; color: var(--color-muted); }
  .tp-opt[aria-pressed='true'] .tp-note, .tp-opt[aria-pressed='true'] .tp-tag { color: rgb(255 255 255 / 75%); }
</style>
