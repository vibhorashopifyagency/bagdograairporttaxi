---
/**
 * A small animated scene: a lime taxi driving along a hill road in front of
 * the Himalaya. Inline SVG. Two variants:
 *   footer: the wide scene, hills in ink so it runs straight into the footer.
 *           It is fitted to its height and widens sideways, so a phone shows a
 *           short stretch and a 4K screen a long one, never cropping the sky.
 *           A small script drives the car over just the stretch on screen.
 *   mark:   a cropped, pale version used as a watermark inside the mega menu,
 *           with the car moved by SMIL, so it needs no script.
 * Under prefers-reduced-motion (or with no script, in the footer) the moving
 * car is swapped for a parked one.
 */
interface Props { variant?: 'footer' | 'mark'; class?: string }
const { variant = 'footer', class: cls = '' } = Astro.props;

const W = 2000, H = 300;
const mark = variant === 'mark';
const r = (n: number) => Math.round(n * 10) / 10;
/** Catmull-Rom through the points, emitted as cubic Béziers. */
function smooth(pts: number[][]) {
  let d = `M${pts[0][0]} ${pts[0][1]}`;
  for (let i = 0; i < pts.length - 1; i++) {
    const p0 = pts[i - 1] ?? pts[i], p1 = pts[i], p2 = pts[i + 1], p3 = pts[i + 2] ?? p2;
    d += ` C${r(p1[0] + (p2[0] - p0[0]) / 6)} ${r(p1[1] + (p2[1] - p0[1]) / 6)} ${r(p2[0] - (p3[0] - p1[0]) / 6)} ${r(p2[1] - (p3[1] - p1[1]) / 6)} ${p2[0]} ${p2[1]}`;
  }
  return d;
}

// The hand-drawn scene spans 0–2000. The footer repeats it once on each side,
// nudged by a seeded jitter so the copies do not read as copies and every
// build draws the same hills; only screens wider than about 8:1 reach them.
let seed = 11;
const rand = () => (seed = (seed * 16807) % 2147483647) / 2147483647;
const nudge = (n: number, by: number) => r(n + (rand() * 2 - 1) * by);
// The original stretch keeps its own end points, so a laptop sees exactly the drawn scene.
function widen(pts: number[][], dy: number) {
  if (mark) return pts;
  const first = pts[0][0], last = pts[pts.length - 1][0];
  const copy = (dx: number) => pts.slice(1, -1).map(([x, y]) => [nudge(x + dx, 12), nudge(y, dy)]);
  return [...copy(-W).filter(([x]) => x < first - 50), ...pts, ...copy(W).filter(([x]) => x > last + 50)];
}
const [X0, X1] = mark ? [0, W] : [-W, 2 * W];
const closeDown = (d: string) => `${d} L${X1 + 20} ${H + 10} L${X0 - 20} ${H + 10} Z`;

// Far range: jagged, with snow on the tallest peaks.
const farPts = widen([[-20, 215], [80, 165], [150, 190], [240, 112], [310, 155], [380, 135], [450, 175], [540, 96], [620, 145], [690, 125], [770, 180], [860, 108], [930, 140], [1010, 82], [1080, 135], [1150, 118], [1240, 165], [1320, 124], [1400, 155], [1480, 102], [1560, 145], [1630, 128], [1720, 175], [1800, 112], [1880, 150], [1950, 135], [2020, 165]], 10);
const far = closeDown('M' + farPts.map((p) => p.join(' ')).join(' L'));
const caps = farPts.filter(([, y]) => y <= 112)
  .map(([x, y]) => `M${r(x - 20)} ${r(y + 20)} L${x} ${y} L${r(x + 20)} ${r(y + 20)} L${r(x + 11)} ${r(y + 15)} L${r(x + 4)} ${r(y + 23)} L${r(x - 5)} ${r(y + 14)} L${r(x - 13)} ${r(y + 19)} Z`).join(' ');
// Mid hills: soft and rolling.
const mid = closeDown(smooth(widen([[-20, 238], [150, 218], [300, 228], [450, 203], [600, 218], [760, 198], [900, 225], [1050, 208], [1200, 231], [1350, 203], [1500, 218], [1650, 198], [1800, 223], [1950, 208], [2020, 213]], 8)));
// The near hill carries the road; the car follows this exact path.
const road = smooth(widen([[-30, 264], [200, 252], [400, 270], [600, 244], [800, 257], [1000, 240], [1200, 262], [1400, 247], [1600, 264], [1800, 242], [2030, 258]], 5));
const near = closeDown(road);
// Two clouds over the hand-drawn stretch, two more for the widest screens.
const clouds = [
  { a: [330, 130, 60, 14], b: [360, 120, 36, 16], drift: '0 0; 40 0; 0 0', dur: '48s' },
  { a: [1130, 104, 70, 13], b: [1165, 94, 40, 16], drift: '0 0; -50 0; 0 0', dur: '60s' },
  ...(mark ? [] : [
    { a: [-560, 118, 64, 13], b: [-528, 108, 38, 15], drift: '0 0; 45 0; 0 0', dur: '54s' },
    { a: [2420, 112, 66, 14], b: [2452, 101, 38, 16], drift: '0 0; -40 0; 0 0', dur: '50s' },
  ]),
];

const uid = 'drive-' + Math.random().toString(36).slice(2, 8);
// The watermark shows the middle of the scene, and the car only drives that stretch.
// The footer viewBox is a narrow slot around the centre with the sky trimmed;
// "meet" then fits it to the height and the wider scene fills either side.
const viewBox = mark ? '640 70 720 230' : `${W / 2 - 200} 60 400 ${H - 60}`;
const carScale = mark ? 2.1 : 1.15;
---

<svg class:list={['drive', mark ? 'drive--mark' : 'drive--footer', cls]} viewBox={viewBox} preserveAspectRatio={mark ? 'xMidYMid meet' : 'xMidYMax meet'} aria-hidden="true" focusable="false">
  <defs>
    <path id={`${uid}-road`} d={road} />
    <g id={`${uid}-car`}>
      <!-- Origin is the road surface under the car, facing right. -->
      <path class="car-body" d="M-33 -6 V-14 Q-33 -17 -30 -17 H-21 L-12 -28 H13 L23 -17 H31 Q34 -17 34 -14 V-6 Z" />
      <path class="car-glass" d="M-18 -17 L-11 -25 H-1 V-17 Z M2 -17 V-25 H11 L18 -17 Z" />
      <rect class="car-sign" x="-7" y="-33" width="14" height="5" rx="1.5" />
      <circle class="car-lamp" cx="33" cy="-11" r="1.8" />
      <circle class="car-tail" cx="-32" cy="-11" r="1.6" />
      <g class="car-wheel" transform="translate(-21 -6)"><circle r="6.5" /><g class="car-spokes"><path d="M-4 0H4M0 -4V4" /><animateTransform attributeName="transform" type="rotate" from="0" to="360" dur=".55s" repeatCount="indefinite" /></g></g>
      <g class="car-wheel" transform="translate(21 -6)"><circle r="6.5" /><g class="car-spokes"><path d="M-4 0H4M0 -4V4" /><animateTransform attributeName="transform" type="rotate" from="0" to="360" dur=".55s" repeatCount="indefinite" /></g></g>
    </g>
  </defs>

  <circle class="sun" cx="1250" cy="100" r="28" />
  {clouds.map((c) => (
    <g class="cloud">
      <ellipse cx={c.a[0]} cy={c.a[1]} rx={c.a[2]} ry={c.a[3]} /><ellipse cx={c.b[0]} cy={c.b[1]} rx={c.b[2]} ry={c.b[3]} />
      <animateTransform attributeName="transform" type="translate" values={c.drift} dur={c.dur} repeatCount="indefinite" />
    </g>
  ))}
  <path class="far" d={far} />
  <path class="cap" d={caps} />
  <path class="mid" d={mid} />
  <path class="near" d={near} />
  <path class="road" d={road} />
  <path class="dash" d={road} />

  <!-- Moving car: the group gets the motion, the inner group the size. In the
       footer the script below moves the group; in the watermark SMIL does. -->
  <g class="car-anim">
    {mark && (
      <animateMotion dur="11s" repeatCount="indefinite" rotate="auto" calcMode="linear" keyPoints="0.3;0.7" keyTimes="0;1">
        <mpath href={`#${uid}-road`} />
      </animateMotion>
    )}
    <use href={`#${uid}-car`} transform={`scale(${carScale})`} />
  </g>
  <!-- Parked car for reduced motion. -->
  <g class="car-still" transform={`translate(1000 240) scale(${carScale})`}><use href={`#${uid}-car`} /></g>
</svg>

<style>
  .drive { display: block; width: 100%; }
  .drive--footer {
    --far: #e6e7ea; --cap: #fff; --mid: #3d4451; --near: #111111;
    --road: rgb(255 255 255 / 70%); --dash: rgb(255 255 255 / 95%);
    --sun: #a1e005; --cloud: rgb(17 17 17 / 5%); --wheel: #2a2f36; --glass: #111111;
  }
  .drive--mark {
    --far: #efefed; --cap: #fff; --mid: #e3e3e0; --near: #d7d8d3;
    --road: #fff; --dash: #a6a7a1;
    --sun: #c9ef66; --cloud: rgb(17 17 17 / 4%); --wheel: #111111; --glass: #111111;
  }
  .sun { fill: var(--sun); }
  .cloud { fill: var(--cloud); }
  .far { fill: var(--far); }
  .cap { fill: var(--cap); }
  .mid { fill: var(--mid); }
  .near { fill: var(--near); }
  .road { fill: none; stroke: var(--road); stroke-width: 7; stroke-linecap: round; }
  .dash { fill: none; stroke: var(--dash); stroke-width: 1.4; stroke-dasharray: 14 12; }
  .car-body { fill: #a1e005; }
  .car-glass { fill: var(--glass); opacity: .85; }
  .car-sign { fill: #111111; }
  .car-lamp { fill: #fff7c2; }
  .car-tail { fill: #ff5a3c; }
  .car-wheel circle { fill: var(--wheel); }
  .car-spokes path { stroke: #fff; stroke-width: 1.4; opacity: .6; }
  .car-still { display: none; }
  /* The footer car stays parked until the script takes the wheel. */
  .drive--footer:not(.is-driving) .car-anim { display: none; }
  .drive--footer:not(.is-driving) .car-still { display: inline; }
  @media (prefers-reduced-motion: reduce) {
    .car-anim { display: none; }
    .car-still { display: inline; }
  }
</style>

<script>
  /*
   * Drives the footer taxi over the stretch of road that is on screen. The
   * scene is fitted to its height, so that stretch is about 650 units on a
   * phone, 2000 on a laptop and 3500 on a 4K screen; the car covers it at the
   * same pace everywhere and comes straight back round, so it is never off
   * screen for long. On first sight it is already on the road. Paused while
   * the footer is out of view; under reduced motion it never starts.
   */
  const SPEED = 80; // scene units a second, the pace of the old 26s loop on a laptop
  const MARGIN = 50; // start and finish just past each edge, so the car drives in and out

  function drive(svg: SVGSVGElement) {
    const road = svg.querySelector<SVGPathElement>('.road');
    const car = svg.querySelector<SVGGElement>('.car-anim');
    if (!road || !car) return;
    const total = road.getTotalLength();
    // The road runs left to right, so length grows with x: binary search.
    const lengthAt = (x: number) => {
      let lo = 0, hi = total;
      for (let i = 0; i < 22; i++) {
        const m = (lo + hi) / 2;
        if (road.getPointAtLength(m).x < x) lo = m; else hi = m;
      }
      return lo;
    };

    let from = 0, to = total, at = -1, last = 0, frame = 0;
    const measure = () => {
      const box = svg.getBoundingClientRect();
      const vb = svg.viewBox.baseVal;
      const scale = Math.min(box.width / vb.width, box.height / vb.height);
      if (!scale) return;
      const half = box.width / scale / 2, centre = vb.x + vb.width / 2;
      from = lengthAt(centre - half - MARGIN);
      to = lengthAt(centre + half + MARGIN);
      if (at < 0) at = from + (to - from) * 0.15;
      else if (at < from || at > to) at = from;
    };
    const place = () => {
      const p = road.getPointAtLength(at), q = road.getPointAtLength(Math.min(at + 2, total));
      const deg = (Math.atan2(q.y - p.y, q.x - p.x) * 180) / Math.PI;
      car.setAttribute('transform', `translate(${p.x.toFixed(1)} ${p.y.toFixed(1)}) rotate(${deg.toFixed(2)})`);
    };
    const tick = (t: number) => {
      // Cap the step so a background tab does not make the car jump on return.
      if (last) at += (Math.min(t - last, 100) / 1000) * SPEED;
      if (at > to) at = from;
      last = t;
      place();
      frame = requestAnimationFrame(tick);
    };

    measure();
    place();
    svg.classList.add('is-driving');
    new ResizeObserver(() => { measure(); place(); }).observe(svg);
    new IntersectionObserver(([entry]) => {
      cancelAnimationFrame(frame);
      last = 0;
      if (entry.isIntersecting) frame = requestAnimationFrame(tick);
    }).observe(svg);
  }

  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll<SVGSVGElement>('svg.drive--footer').forEach(drive);
  }
</script>
