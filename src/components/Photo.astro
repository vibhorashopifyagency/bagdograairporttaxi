---
/**
 * A responsive photo from the photo library (src/data/photo-library.ts).
 * Three widths are offered and the browser picks one from `sizes`. Alt text,
 * width and height come from the library, so layout never shifts.
 */
import { PHOTOS, focusStyle, photoFile } from '../data/photo-library';
interface Props {
  name: string;
  class?: string;
  /** The image's rendered width across breakpoints, for srcset selection. */
  sizes?: string;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  /** Override when the photo is decorative in context (empty string). */
  alt?: string;
}
const {
  name,
  class: cls = '',
  sizes = '(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw',
  loading = 'lazy',
  fetchpriority,
  alt,
} = Astro.props;
const p = PHOTOS[name];
if (!p) throw new Error(`Unknown photo "${name}". Add it to the photo library (Photos in the dashboard, or scripts/fetch-photos.mjs).`);
---

<img
  src={photoFile(name, 800)}
  srcset={`${photoFile(name, 400)} 400w, ${photoFile(name, 800)} 800w, ${photoFile(name, 1600)} 1600w`}
  sizes={sizes}
  alt={alt ?? p.alt}
  width={p.width}
  height={p.height}
  loading={loading}
  decoding="async"
  fetchpriority={fetchpriority}
  class={cls}
  style={focusStyle(name)}
/>
