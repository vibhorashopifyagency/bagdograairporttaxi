---
/**
 * A responsive photo from public/img, generated by scripts/fetch-photos.mjs.
 * Three widths are offered and the browser picks one from `sizes`. Alt text,
 * width and height come from src/data/photos.json, so layout never shifts.
 */
import photos from '../data/photos.json';
interface Props {
  name: string;
  class?: string;
  /** The image's rendered width across breakpoints, for srcset selection. */
  sizes?: string;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  /** Override when the photo is decorative in context (empty string). */
  alt?: string;
}
const {
  name,
  class: cls = '',
  sizes = '(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw',
  loading = 'lazy',
  fetchpriority,
  alt,
} = Astro.props;
const p = (photos as Record<string, { alt: string; width: number; height: number }>)[name];
if (!p) throw new Error(`Unknown photo "${name}". Add it to scripts/fetch-photos.mjs and run it.`);
---

<img
  src={`/img/${name}-800.webp`}
  srcset={`/img/${name}-400.webp 400w, /img/${name}-800.webp 800w, /img/${name}-1600.webp 1600w`}
  sizes={sizes}
  alt={alt ?? p.alt}
  width={p.width}
  height={p.height}
  loading={loading}
  decoding="async"
  fetchpriority={fetchpriority}
  class={cls}
/>
