---
/**
 * The Google rating, in the look travellers already trust from Maps: the "G",
 * the score, yellow stars and the review count, linking to the listing.
 * Renders nothing until real reviews have been fetched.
 */
import GoogleLogo from './GoogleLogo.astro';
import Stars from './Stars.astro';
import { GOOGLE } from '../data/reviews';
interface Props {
  /** `card` for a section header, `chip` for a hero or price block, `inline` for the footer. */
  variant?: 'card' | 'chip' | 'inline';
  class?: string;
}
const { variant = 'card', class: cls = '' } = Astro.props;
const count = GOOGLE.count.toLocaleString('en-IN');
---

{GOOGLE.hasRating && (
  variant === 'card' ? (
    <a href={GOOGLE.url} target="_blank" rel="noopener" class={`card group flex items-center gap-4 p-4 no-underline hover:border-pine ${cls}`}>
      <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-white shadow-sm ring-1 ring-line"><GoogleLogo class="h-7 w-7" /></span>
      <span>
        <span class="block text-sm font-semibold text-muted">Google reviews</span>
        <span class="flex items-center gap-2">
          <strong class="font-[family-name:var(--font-display)] text-3xl leading-none text-ink">{GOOGLE.rating.toFixed(1)}</strong>
          <Stars rating={GOOGLE.rating} class="h-5 w-5" />
        </span>
        <span class="mt-1 block text-sm text-muted group-hover:text-pine">Based on {count} reviews</span>
      </span>
    </a>
  ) : variant === 'chip' ? (
    <a href={GOOGLE.url} target="_blank" rel="noopener" class={`inline-flex items-center gap-2 rounded-full bg-white/90 px-3 py-1.5 text-sm font-semibold text-ink no-underline shadow-sm ring-1 ring-line backdrop-blur hover:ring-pine ${cls}`}>
      <GoogleLogo class="h-4 w-4" />
      <span>{GOOGLE.rating.toFixed(1)}</span>
      <Stars rating={GOOGLE.rating} class="h-3.5 w-3.5" />
      <span class="font-normal text-muted">{count} Google reviews</span>
    </a>
  ) : (
    <a href={GOOGLE.url} target="_blank" rel="noopener" class={`inline-flex items-center gap-1.5 text-sm no-underline ${cls}`}>
      <GoogleLogo class="h-4 w-4" />
      <strong class="text-ink">{GOOGLE.rating.toFixed(1)}</strong>
      <Stars rating={GOOGLE.rating} class="h-3.5 w-3.5" />
      <span class="text-muted">({count} on Google)</span>
    </a>
  )
)}
