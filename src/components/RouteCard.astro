---
import type { Route } from '../data/routes';
import { inr, lowestFare } from '../data/routes';
import { routePhoto } from '../lib/photos';
import Photo from './Photo.astro';
interface Props {
  route: Route;
  /** No photo: for lists where every route goes to the same place. */
  compact?: boolean;
}
const { route, compact = false } = Astro.props;
---

<a href={`/taxi/${route.slug}/`} class="card lift group flex items-stretch overflow-hidden no-underline">
  {!compact && (
    <span class="relative w-28 shrink-0 overflow-hidden bg-mist sm:w-32">
      <Photo name={routePhoto(route)} class="zoom absolute inset-0 h-full w-full object-cover" sizes="160px" alt="" />
    </span>
  )}
  <span class="flex min-w-0 flex-1 flex-col p-4">
    <span class="truncate text-[0.7rem] font-bold tracking-[0.12em] text-muted uppercase">{route.fromShort}</span>
    <span class="mt-0.5 truncate font-[family-name:var(--font-display)] text-lg font-bold text-ink group-hover:text-lime-text">{route.toShort}</span>
    <span class="mt-auto flex items-end justify-between gap-3 pt-3">
      <span class="text-xs text-muted">{route.km} km · {route.duration}</span>
      <span class="text-right text-[0.7rem] text-muted">from<strong class="block font-[family-name:var(--font-display)] text-lg leading-none text-ink">{inr(lowestFare(route))}</strong></span>
    </span>
  </span>
</a>
