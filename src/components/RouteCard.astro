---
import type { Route } from '../data/routes';
import { inr, lowestFare } from '../data/routes';
interface Props { route: Route }
const { route } = Astro.props;
---

<a href={`/taxi/${route.slug}/`} class="card lift group flex flex-col p-4 no-underline">
  <span class="flex items-center gap-2 text-xs font-semibold tracking-wide text-muted uppercase">
    <span class="h-2 w-2 rounded-full bg-pine"></span>{route.fromShort}
  </span>
  <span class="my-1 ml-[3px] h-4 border-l-2 border-dashed border-pine-100" aria-hidden="true"></span>
  <span class="flex items-center gap-2 font-[family-name:var(--font-display)] text-lg font-bold text-ink group-hover:text-pine">
    <span class="h-2 w-2 shrink-0 rounded-full bg-saffron"></span>{route.toShort}
  </span>
  <span class="mt-3 flex items-end justify-between border-t border-line pt-3">
    <span class="text-sm text-muted">{route.km} km · {route.duration}</span>
    <span class="text-right text-xs text-muted">from<strong class="block text-lg text-ink">{inr(lowestFare(route))}</strong></span>
  </span>
</a>
