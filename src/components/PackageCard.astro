---
import type { TourPackage } from '../data/packages';
import { inr } from '../data/routes';
import { PACKAGES } from '../data/packages';
interface Props { pkg: TourPackage }
const { pkg } = Astro.props;
const bands = [
  ['#ffcf9f', '#e98a5b'], ['#cfe3f5', '#7fa7cf'], ['#eef6ff', '#9fb8d3'],
  ['#ffe2b3', '#f4a62a'], ['#e4f4d4', '#8cc06b'], ['#ffd8e4', '#e58fa8'],
];
const i = Math.max(0, PACKAGES.indexOf(pkg)) % bands.length;
const [a, b] = bands[i];
---

<a href={`/tour-packages/${pkg.slug}/`} class="card lift group flex flex-col overflow-hidden no-underline">
  <span class="relative block h-28" style={`background:linear-gradient(135deg, ${a}, ${b})`}>
    <svg class="absolute inset-x-0 bottom-0 h-16 w-full" viewBox="0 0 400 80" preserveAspectRatio="none" aria-hidden="true">
      <path d="M0 50 70 20l50 22 70-34 60 30 60-20 90 36v26H0Z" fill="#fff" opacity=".5" />
      <path d="M0 64 100 40l90 20 110-24 100 30v14H0Z" fill="#fff" />
    </svg>
    <span class="absolute top-3 left-3 rounded-full bg-white/90 px-3 py-1 text-xs font-bold text-ink">{pkg.nights}N / {pkg.days}D</span>
  </span>
  <span class="flex flex-1 flex-col p-5 pt-2">
    <span class="font-[family-name:var(--font-display)] text-xl font-bold text-ink group-hover:text-pine">{pkg.name}</span>
    <span class="mt-1 text-sm text-muted">{pkg.places.join(' · ')}</span>
    <span class="mt-3 flex flex-wrap gap-1.5">
      {pkg.bestFor.map((b) => <span class="rounded-full bg-pine-50 px-2.5 py-0.5 text-xs text-pine-dark">{b}</span>)}
    </span>
    <span class="mt-auto pt-4 text-sm text-muted">from <strong class="font-[family-name:var(--font-display)] text-2xl text-ink">{inr(pkg.fromPrice)}</strong> per person</span>
  </span>
</a>
