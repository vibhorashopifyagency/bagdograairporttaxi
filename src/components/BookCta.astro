---
import Icon from './Icon.astro';
import Photo from './Photo.astro';
import Words from './Words.astro';
import { BUSINESS, waLink } from '../data/site';
import { wordsText, type WordPageKey } from '../data/page-text';
import type { WordVars } from '../lib/rich-text';
interface Props {
  bookHref?: string;
  waText?: string;
  /** A heading of the page's own (a guide's), as plain text. */
  heading?: string;
  /** "guide:nathula-pass-guide:ctaHeading": marks that heading for the dashboard's page editor. */
  headingEdit?: string;
  /** The page's own heading from its page words ("packages:ctaTitle"); without either, the shared "Ready to book?". */
  words?: `${WordPageKey}:${string}`;
  /** Fill-ins for that heading. */
  vars?: WordVars;
  image?: string;
}
const {
  bookHref = '/book/',
  waText = wordsText('whatsapp', 'general'),
  heading,
  headingEdit,
  words = 'book-box:title',
  vars,
  image = 'pelling',
} = Astro.props;
const [hp, hf] = words.split(':') as [WordPageKey, string];
---

<aside class="relative mt-14 overflow-hidden rounded-[28px] bg-ink-soft text-white">
  <Photo name={image} class="absolute inset-0 h-full w-full object-cover opacity-40" sizes="(min-width: 1024px) 1152px, 100vw" alt="" />
  <div class="absolute inset-0 bg-gradient-to-r from-ink via-ink/85 to-ink/40" aria-hidden="true"></div>
  <div class="relative grid grid-cols-1 gap-6 p-7 sm:p-10 lg:grid-cols-[1fr_auto] lg:items-center">
    <div class="max-w-2xl">
      {heading ? <h2 class="text-2xl font-extrabold text-white sm:text-3xl" data-edit={headingEdit}>{heading}</h2> : <Words page={hp} field={hf} vars={vars} as="h2" class="text-2xl font-extrabold text-white sm:text-3xl" />}
      <Words page="book-box" field="text" as="p" class="mt-2 text-white/70" />
    </div>
    <div class="flex flex-wrap gap-3">
      <a class="btn-lime" href={bookHref}><Words page="book-box" field="bookButton" /> <Icon name="arrow" /></a>
      <a class="btn-light" href={waLink(waText)} rel="noopener"><Icon name="whatsapp" /> <Words page="book-box" field="whatsappButton" /></a>
      <a class="btn-light" href={BUSINESS.phoneHref}><Icon name="phone" /> {BUSINESS.phone}</a>
    </div>
  </div>
</aside>
