---
/** Five stars filled to the rating, in Google's review yellow. */
interface Props { rating: number; class?: string }
const { rating, class: cls = 'h-4 w-4' } = Astro.props;
const star = 'M12 2.5l2.94 6.1 6.56.8-4.84 4.6 1.22 6.6L12 17.4l-5.88 3.2 1.22-6.6L2.5 9.4l6.56-.8L12 2.5z';
---

<span class="inline-flex items-center gap-0.5" role="img" aria-label={`Rated ${rating} out of 5`}>
  {[0, 1, 2, 3, 4].map((i) => {
    const fill = Math.max(0, Math.min(1, rating - i));
    return (
      <svg class={cls} viewBox="0 0 24 24" aria-hidden="true">
        <path d={star} fill="#dadce0" />
        {fill > 0 && <path d={star} fill="#fbbc04" style={fill < 1 ? `clip-path:inset(0 ${Math.round((1 - fill) * 100)}% 0 0)` : undefined} />}
      </svg>
    );
  })}
</span>
