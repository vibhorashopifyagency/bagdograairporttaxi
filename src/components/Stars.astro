---
/**
 * Five stars filled to the rating, in Google's review yellow. The star shape
 * is drawn once in IconSprite.astro; each star here is two <use> references
 * (grey base, yellow fill clipped to the fraction), so a page of review cards
 * stays light.
 */
interface Props { rating: number; class?: string }
const { rating, class: cls = 'h-4 w-4' } = Astro.props;
---

<span class="inline-flex items-center gap-0.5" role="img" aria-label={`Rated ${rating} out of 5`}>
  {[0, 1, 2, 3, 4].map((i) => {
    const fill = Math.max(0, Math.min(1, rating - i));
    return (
      <svg class={cls} viewBox="0 0 24 24" aria-hidden="true">
        <use href="#i-star-solid" fill="#dadce0" />
        {fill > 0 && <use href="#i-star-solid" fill="#fbbc04" style={fill < 1 ? `clip-path:inset(0 ${Math.round((1 - fill) * 100)}% 0 0)` : undefined} />}
      </svg>
    );
  })}
</span>
