---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import MountainDrive from './MountainDrive.astro';
import GoogleRatingBadge from './GoogleRatingBadge.astro';
import { BUSINESS, SITE, POLICY, waLink } from '../data/site';
import { ROUTES } from '../data/routes';
import { PACKAGES } from '../data/packages';
const topRoutes = ROUTES.slice(0, 8);
const year = new Date().getFullYear();
---

<!-- The road into the hills runs along the top of the footer: the near hill is footer ink, so the scene flows straight into it. -->
<div class="mt-16 h-[clamp(140px,12vw,260px)] overflow-hidden sm:mt-20" aria-hidden="true">
  <MountainDrive variant="footer" class="h-full" />
</div>
<footer class="bg-ink pb-24 text-white/70 sm:pb-0">
  <div class="wrap grid gap-10 py-14 md:grid-cols-2 lg:grid-cols-[1.3fr_1fr_1fr_1fr]">
    <div>
      <Logo dark large />
      <p class="mt-4 font-[family-name:var(--font-display)] text-lg font-semibold text-white">{BUSINESS.tagline}.</p>
      <p class="mt-2 max-w-sm text-sm leading-relaxed text-white/55">Private airport taxis and tour packages from Bagdogra across Darjeeling, Sikkim, the Dooars and Bhutan. A local office, one phone number, fixed fares.</p>
      <address class="mt-5 text-sm not-italic leading-relaxed text-white/55">
        <strong class="text-white">{SITE.name}</strong><br />
        {BUSINESS.address.street}, {BUSINESS.address.locality}<br />
        {BUSINESS.address.district}, {BUSINESS.address.region} {BUSINESS.address.postalCode}<br />
        {BUSINESS.hours}
      </address>
      <div class="mt-5 flex flex-wrap gap-2">
        <a href={BUSINESS.phoneHref} class="btn-light min-h-10 px-4 py-2 text-sm"><Icon name="phone" class="h-4 w-4" />{BUSINESS.phone}</a>
        <a href={waLink('Hi, I would like to book a taxi.')} rel="noopener" class="btn-light min-h-10 px-4 py-2 text-sm"><Icon name="whatsapp" class="h-4 w-4" />WhatsApp</a>
      </div>
      {BUSINESS.gstin && <p class="mt-3 text-xs text-white/55">GSTIN {BUSINESS.gstin}</p>}
      {BUSINESS.registrations.map((r) => <p class="mt-1 text-xs text-white/55">{r.name}{r.id && ` · ${r.id}`}</p>)}
      <GoogleRatingBadge variant="inline" dark class="mt-5" />
    </div>
    <div>
      <h2 class="text-xs font-semibold tracking-[0.14em] text-white/55 uppercase">Popular taxi routes</h2>
      <ul class="mt-4 space-y-2.5 text-sm">
        {topRoutes.map((r) => <li><a href={`/taxi/${r.slug}/`} class="text-white/70 no-underline hover:text-white">{r.fromShort} to {r.toShort}</a></li>)}
        <li><a href="/taxi/" class="font-semibold text-white no-underline hover:text-lime">All {ROUTES.length} fares</a></li>
      </ul>
    </div>
    <div>
      <h2 class="text-xs font-semibold tracking-[0.14em] text-white/55 uppercase">Tour packages</h2>
      <ul class="mt-4 space-y-2.5 text-sm">
        {PACKAGES.slice(0, 7).map((p) => <li><a href={`/tour-packages/${p.slug}/`} class="text-white/70 no-underline hover:text-white">{p.name}</a></li>)}
        <li><a href="/tour-packages/" class="font-semibold text-white no-underline hover:text-lime">All {PACKAGES.length} packages</a></li>
      </ul>
    </div>
    <div>
      <h2 class="text-xs font-semibold tracking-[0.14em] text-white/55 uppercase">Help</h2>
      <ul class="mt-4 space-y-2.5 text-sm">
        <li><a href="/cancellation-refund-policy/" class="text-white/70 no-underline hover:text-white">Cancellation and refunds</a></li>
        <li><a href="/faq/" class="text-white/70 no-underline hover:text-white">FAQ</a></li>
        <li><a href="/guides/sikkim-permit-guide/" class="text-white/70 no-underline hover:text-white">Sikkim permit guide</a></li>
        <li><a href="/guides/bagdogra-airport-transport-guide/" class="text-white/70 no-underline hover:text-white">Bagdogra Airport transport guide</a></li>
        <li><a href="/guides/best-time-to-visit-darjeeling-sikkim/" class="text-white/70 no-underline hover:text-white">Best time to visit</a></li>
        <li><a href="/guides/nathula-pass-guide/" class="text-white/70 no-underline hover:text-white">Nathula Pass guide</a></li>
        <li><a href="/guides/offbeat-places-north-bengal-sikkim/" class="text-white/70 no-underline hover:text-white">Offbeat places</a></li>
        <li><a href="/gallery/" class="text-white/70 no-underline hover:text-white">Photo gallery</a></li>
        <li><a href="/about/" class="text-white/70 no-underline hover:text-white">About us</a></li>
        <li><a href="/contact/" class="text-white/70 no-underline hover:text-white">Contact</a></li>
      </ul>
      <p class="mt-5 rounded-xl border border-white/10 bg-white/5 p-3 text-xs leading-relaxed text-white/55">Free cancellation up to {POLICY.freeCancelHours} hours before pickup. Refunds in {POLICY.refundDays} working days.</p>
    </div>
  </div>
  <div class="border-t border-white/10">
    <div class="wrap flex flex-wrap items-center justify-between gap-x-6 gap-y-2 py-5 text-xs text-white/55">
      <p>© {year} {SITE.name}, a unit of {BUSINESS.legalName}. Fares in Indian rupees.</p>
      <ul class="flex flex-wrap gap-x-5 gap-y-1">
        <li><a href="/privacy/" class="text-white/55 no-underline hover:text-white">Privacy</a></li>
        <li><a href="/terms/" class="text-white/55 no-underline hover:text-white">Terms</a></li>
        <li>Designed by <a href="https://vibhora.com/" rel="noopener" target="_blank" class="text-white/55 no-underline hover:text-white">Vibhora</a></li>
      </ul>
    </div>
  </div>
</footer>
