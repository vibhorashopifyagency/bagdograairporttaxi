---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import MountainDrive from './MountainDrive.astro';
import GoogleRatingBadge from './GoogleRatingBadge.astro';
import MsmeBadge from './MsmeBadge.astro';
import Words from './Words.astro';
import { BUSINESS, MSME, SITE, waLink } from '../data/site';
import { editAttr, wordsList } from '../data/page-text';
import { ROUTES } from '../data/routes';
import { PACKAGES } from '../data/packages';
import { DESTINATIONS } from '../data/destinations';
import { GUIDES } from '../data/guides';
import { VEHICLES } from '../data/vehicles';

const airportRoutes = ROUTES.filter((r) => r.fromShort === 'Bagdogra Airport').slice(0, 7);
const njpRoutes = ROUTES.filter((r) => r.fromShort === 'NJP station').slice(0, 7);
const year = new Date().getFullYear();

// Short labels for the guide column; the full titles are too long for a footer list.
const guideLabel: Record<string, string> = {
  'sikkim-permit-guide': 'Sikkim permit guide',
  'bagdogra-airport-transport-guide': 'Bagdogra Airport transport guide',
  'best-time-to-visit-darjeeling-sikkim': 'Best time to visit',
  'nathula-pass-guide': 'Nathula Pass guide',
  'offbeat-places-north-bengal-sikkim': 'Offbeat places near Bagdogra',
};

// The footer's words are "Footer" in the dashboard (src/data/page-text.ts).
const promises = [
  { icon: 'card', n: 'p1' },
  { icon: 'clock', n: 'p2' },
  { icon: 'refund', n: 'p3' },
  { icon: 'shield', n: 'p4' },
  { icon: 'phone', n: 'p5' },
] as const;

const link = 'text-white/70 no-underline hover:text-white';
const more = 'font-semibold text-white no-underline hover:text-lime';
const heading = 'text-xs font-semibold tracking-[0.14em] text-white/55 uppercase';
---

<!-- The road into the hills runs along the top of the footer: the near hill is footer ink, so the scene flows straight into it. -->
<div class="mt-16 h-[clamp(140px,12vw,260px)] overflow-hidden sm:mt-20" aria-hidden="true">
  <MountainDrive variant="footer" class="h-full" />
</div>
<footer class="bg-ink pb-24 text-white/70 sm:pb-0">
  <!-- What every booking comes with. -->
  <div class="wrap border-b border-white/10 py-8">
    <ul class="grid gap-x-8 gap-y-5 sm:grid-cols-2 lg:grid-cols-5">
      {promises.map((p) => (
        <li class="flex gap-3">
          <span class="mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-white/10 text-lime"><Icon name={p.icon} class="h-[18px] w-[18px]" /></span>
          <span>
            <Words page="footer" field={`${p.n}Title`} as="strong" class="block text-sm font-semibold text-white" />
            <Words page="footer" field={`${p.n}Text`} class="mt-0.5 block text-xs leading-snug text-white/55" />
          </span>
        </li>
      ))}
    </ul>
  </div>

  <!-- Who we are and how to reach us. -->
  <div class="wrap grid gap-10 py-12 lg:grid-cols-[1.1fr_1fr] lg:gap-16">
    <div>
      <Logo dark large />
      <p class="mt-4 font-[family-name:var(--font-display)] text-lg font-semibold text-white">{BUSINESS.tagline}.</p>
      <Words page="footer" field="blurb" as="p" class="mt-2 max-w-md text-sm leading-relaxed text-white/55" />
      <div class="mt-5 flex flex-wrap gap-2">
        <a href="/book/" class="btn-lime min-h-10 px-4 py-2 text-sm"><Words page="footer" field="bookButton" /> <Icon name="arrow" class="h-4 w-4" /></a>
        <a href={BUSINESS.phoneHref} class="btn-light min-h-10 px-4 py-2 text-sm"><Icon name="phone" class="h-4 w-4" />{BUSINESS.phone}</a>
        <a href={waLink('Hi, I would like to book a taxi.')} rel="noopener" class="btn-light min-h-10 px-4 py-2 text-sm"><Icon name="whatsapp" class="h-4 w-4" />WhatsApp</a>
      </div>
      <GoogleRatingBadge variant="inline" dark class="mt-5" />
      {BUSINESS.gstin && <p class="mt-4 text-xs text-white/55">GSTIN {BUSINESS.gstin}</p>}
      {BUSINESS.registrations.filter((r) => r !== MSME).map((r) => <p class="mt-1 text-xs text-white/55">{r.name}{r.id && ` · ${r.id}`}</p>)}
      <MsmeBadge dark class="mt-5" />

      <Words page="footer" field="fleetTitle" as="h2" class={`${heading} mt-8`} />
      <ul class="mt-3 flex flex-wrap gap-2">
        {VEHICLES.map((v) => (
          <li>
            <a href="/book/" class="inline-flex items-center gap-2 rounded-lg border border-white/15 px-3 py-1.5 text-xs text-white/70 no-underline hover:border-white/40 hover:text-white" title={v.models}>
              <Icon name="car" class="h-3.5 w-3.5 text-lime" />
              <span class="font-semibold text-white">{v.name}</span>
              <span class="inline-flex items-center gap-1"><Icon name="users" class="h-3.5 w-3.5" />{v.seats}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div>
      <Words page="footer" field="contactTitle" as="h2" class={heading} />
      <dl class="mt-4 grid gap-x-8 gap-y-5 sm:grid-cols-2">
        <div class="flex gap-3">
          <span class="mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-white/10 text-lime"><Icon name="phone" class="h-[18px] w-[18px]" /></span>
          <div>
            <Words page="footer" field="callLabel" as="dt" class="text-xs text-white/55" />
            <dd class="mt-0.5 text-sm"><a href={BUSINESS.phoneHref} class="font-semibold text-white no-underline hover:text-lime">{BUSINESS.phone}</a></dd>
          </div>
        </div>
        <div class="flex gap-3">
          <span class="mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-white/10 text-lime"><Icon name="mail" class="h-[18px] w-[18px]" /></span>
          <div>
            <Words page="footer" field="emailLabel" as="dt" class="text-xs text-white/55" />
            <dd class="mt-0.5 text-sm break-all"><a href={`mailto:${BUSINESS.email}`} class="font-semibold text-white no-underline hover:text-lime">{BUSINESS.email}</a></dd>
          </div>
        </div>
        <div class="flex gap-3">
          <span class="mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-white/10 text-lime"><Icon name="map" class="h-[18px] w-[18px]" /></span>
          <div>
            <Words page="footer" field="officeLabel" as="dt" class="text-xs text-white/55" />
            <dd class="mt-0.5 text-sm leading-relaxed text-white/70">
              <address class="not-italic">
                <strong class="text-white">{SITE.name}</strong>, a unit of {BUSINESS.legalName}<br />
                {BUSINESS.address.street}, {BUSINESS.address.locality}<br />
                {BUSINESS.address.district}, {BUSINESS.address.region} {BUSINESS.address.postalCode}
              </address>
              <a href={BUSINESS.mapsUrl} target="_blank" rel="noopener" class="mt-1.5 inline-flex items-center gap-1 text-sm font-semibold text-white no-underline hover:text-lime"><Words page="footer" field="directions" /> <Icon name="arrow" class="h-3.5 w-3.5" /></a>
            </dd>
          </div>
        </div>
        <div class="flex gap-3">
          <span class="mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-white/10 text-lime"><Icon name="clock" class="h-[18px] w-[18px]" /></span>
          <div>
            <Words page="footer" field="pickupsLabel" as="dt" class="text-xs text-white/55" />
            <Words page="footer" field="pickupsText" as="dd" class="mt-0.5 text-sm leading-relaxed text-white/70" />
          </div>
        </div>
      </dl>
      <Words page="footer" field="stepsNote" as="p" strong="text-white" link="text-white hover:text-lime" class="mt-6 rounded-xl border border-white/10 bg-white/5 p-4 text-xs leading-relaxed text-white/55" />
    </div>
  </div>

  <!-- Every corner of the site. -->
  <div class="wrap border-t border-white/10 py-12">
    <div class="grid grid-cols-2 gap-x-6 gap-y-10 sm:grid-cols-3 lg:grid-cols-6">
      <div>
        <Words page="footer" field="colAirport" as="h2" class={heading} />
        <ul class="mt-4 space-y-2.5 text-sm">
          {airportRoutes.map((r) => <li><a href={`/taxi/${r.slug}/`} class={link}>Taxi to {r.toShort}</a></li>)}
          <li><a href="/taxi/" class={more}>All {ROUTES.length} fares</a></li>
        </ul>
      </div>
      <div>
        <Words page="footer" field="colNjp" as="h2" class={heading} />
        <ul class="mt-4 space-y-2.5 text-sm">
          {njpRoutes.map((r) => <li><a href={`/taxi/${r.slug}/`} class={link}>Taxi to {r.toShort}</a></li>)}
          <li><a href="/taxi/" class={more}>Full fare chart</a></li>
        </ul>
      </div>
      <div>
        <Words page="footer" field="colPackages" as="h2" class={heading} />
        <ul class="mt-4 space-y-2.5 text-sm">
          {PACKAGES.slice(0, 7).map((p) => <li><a href={`/tour-packages/${p.slug}/`} class={link}>{p.name}</a></li>)}
          <li><a href="/tour-packages/" class={more}>All {PACKAGES.length} packages</a></li>
        </ul>
      </div>
      <div>
        <Words page="footer" field="colDestinations" as="h2" class={heading} />
        <ul class="mt-4 space-y-2.5 text-sm">
          {DESTINATIONS.map((d) => <li><a href={`/destinations/${d.slug}/`} class={link}>{d.short ?? d.name}</a></li>)}
          <li><a href="/destinations/" class={more}>All destinations</a></li>
        </ul>
      </div>
      <div>
        <Words page="footer" field="colGuides" as="h2" class={heading} />
        <ul class="mt-4 space-y-2.5 text-sm">
          {GUIDES.map((g) => <li><a href={`/guides/${g.slug}/`} class={link}>{guideLabel[g.slug] ?? g.title}</a></li>)}
          <li><a href="/faq/" class={link}>Frequently asked questions</a></li>
          <li><a href="/gallery/" class={link}>Photo gallery</a></li>
          <li><a href="/guides/" class={more}>All guides</a></li>
        </ul>
      </div>
      <div>
        <Words page="footer" field="colCompany" as="h2" class={heading} />
        <ul class="mt-4 space-y-2.5 text-sm">
          <li><a href="/about/" class={link}>About us</a></li>
          <li><a href="/contact/" class={link}>Contact</a></li>
          <li><a href="/book/" class={link}>Book a taxi</a></li>
          <li><a href="/cancellation-refund-policy/" class={link}>Cancellation and refunds</a></li>
          <li><a href="/terms/" class={link}>Terms of service</a></li>
          <li><a href="/privacy/" class={link}>Privacy policy</a></li>
          <li><a href="/photo-credits/" class={link}>Photo credits</a></li>
          <li><a href="/sitemap-index.xml" class={link}>Sitemap</a></li>
        </ul>
      </div>
    </div>
  </div>

  <!-- Where we drive, and the small print behind the fares. -->
  <div class="wrap border-t border-white/10 py-8 text-xs leading-relaxed text-white/55">
    <p><Words page="footer" field="areasLabel" as="strong" class="text-white/70" /> <span data-edit={editAttr('footer', 'areas')} set:html={wordsList('footer', 'areas').join(' · ')} />.</p>
    <p class="mt-3"><Words page="footer" field="faresLabel" as="strong" class="text-white/70" /> <Words page="footer" field="faresText" /></p>
  </div>

  <div class="border-t border-white/10">
    <div class="wrap flex flex-wrap items-center justify-between gap-x-6 gap-y-3 py-5 text-xs text-white/55">
      <p>© {year} {SITE.name}, a unit of {BUSINESS.legalName}. <Words page="footer" field="rights" /></p>
      <ul class="flex flex-wrap items-center gap-x-5 gap-y-1">
        <li><a href="/privacy/" class="text-white/55 no-underline hover:text-white">Privacy</a></li>
        <li><a href="/terms/" class="text-white/55 no-underline hover:text-white">Terms</a></li>
        <li><a href="/cancellation-refund-policy/" class="text-white/55 no-underline hover:text-white">Refunds</a></li>
        <li>Designed by <a href="https://vibhora.com/" rel="noopener" target="_blank" class="text-white/55 no-underline hover:text-white">Vibhora</a></li>
        <li><a href="#top" class="inline-flex items-center gap-1 rounded-lg border border-white/15 px-2.5 py-1.5 text-white/70 no-underline hover:border-white/40 hover:text-white">Back to top <Icon name="up" class="h-3.5 w-3.5" /></a></li>
      </ul>
    </div>
  </div>
</footer>
