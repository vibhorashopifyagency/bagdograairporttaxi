---
/**
 * Top bar, main bar and mega menu. The four content menus open on hover and
 * keyboard focus (CSS only); a small script adds click/tap toggling, Escape
 * and click-outside. On phones the same content is a full-screen drawer built
 * from <details>, so it works without JavaScript.
 */
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import Photo from './Photo.astro';
import GoogleLogo from './GoogleLogo.astro';
import Stars from './Stars.astro';
import { BUSINESS, waLink } from '../data/site';
import { ROUTES, inr, lowestFare } from '../data/routes';
import { PACKAGES } from '../data/packages';
import { DESTINATIONS } from '../data/destinations';
import { GUIDES } from '../data/guides';
import { VEHICLES } from '../data/vehicles';
import { GOOGLE } from '../data/reviews';
import { destinationPhoto, guidePhoto, packagePhoto } from '../lib/photos';
import MountainDrive from './MountainDrive.astro';

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href);
const minFare = Math.min(...ROUTES.map(lowestFare));
const minPkg = Math.min(...PACKAGES.map((p) => p.fromPrice));
const carPhoto: Record<string, string> = { sedan: 'car-sedan', suv: 'car-suv', innova: 'car-innova', traveller: 'car-traveller' };
const themes = [...new Set(PACKAGES.flatMap((p) => p.bestFor))].slice(0, 8);
const menuPackages = PACKAGES.slice(0, 6);
const permitGuide = GUIDES.find((g) => g.slug === 'sikkim-permit-guide')!;
const [leadGuide, ...moreGuides] = GUIDES;
const airportRoutes = ROUTES.filter((r) => r.fromShort === 'Bagdogra Airport');
const njpRoutes = ROUTES.filter((r) => r.fromShort === 'NJP station');
const darj = ROUTES.find((r) => r.slug === 'bagdogra-airport-to-darjeeling-taxi') ?? ROUTES[0];
const MENU_ROWS = 8;
// Destinations fall into three columns by the region each page names.
const destGroup = (region: string) => (/Sikkim/.test(region) ? 'Sikkim' : /Darjeeling|Kalimpong/.test(region) ? 'Darjeeling hills' : 'Dooars and Bhutan');
const destGroups = ['Darjeeling hills', 'Sikkim', 'Dooars and Bhutan'].map((name) => ({ name, items: DESTINATIONS.filter((d) => destGroup(d.region) === name) }));

const menus = [
  { key: 'fares', href: '/taxi/', label: 'Taxi fares', title: 'Fixed fares, shown before you fly', text: `One price per car, one way, with tolls, parking and GST included. From ${inr(minFare)}.`, cta: `All ${ROUTES.length} fares` },
  { key: 'packages', href: '/tour-packages/', label: 'Tour packages', title: 'Hills, hotels and a car in one price', text: `${PACKAGES.length} private tours from ${inr(minPkg)} per person, with permits arranged.`, cta: 'Browse packages' },
  { key: 'destinations', href: '/destinations/', label: 'Destinations', title: 'Where we drive', text: 'Darjeeling, Sikkim, the Dooars and the Bhutan border, with how many days each needs.', cta: 'All destinations' },
  { key: 'guides', href: '/guides/', label: 'Travel guides', title: 'Answers from the driver’s seat', text: 'Permits, seasons and routes, written by the people who drive them every day.', cta: 'Read the guides' },
];
const plain = [
  { href: '/gallery/', label: 'Gallery' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];
---

<a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:rounded focus:bg-white focus:p-3">Skip to content</a>

<div class="mega-scrim hidden xl:block" aria-hidden="true"></div>
<!-- The top bar and the header travel together. Scrolling down parks the bar above the viewport
     and leaves the header pinned; scrolling up slides the bar back in. The wrapper never changes
     height, so the page never jumps. Below md the bar does not exist and the wrapper sticks at 0. -->
<div class="chrome sticky z-40" data-chrome>
<!-- Top bar: the facts a nervous first-time booker checks before anything else. -->
<div class="hidden bg-ink text-xs text-white/75 md:block" data-topbar>
  <div class="wrap flex h-9 items-center justify-between gap-4">
    <ul class="flex items-center gap-5">
      <li><a href={BUSINESS.phoneHref} class="inline-flex items-center gap-1.5 text-white/85 no-underline hover:text-lime"><Icon name="phone" class="h-3.5 w-3.5 text-lime" />{BUSINESS.phone}</a></li>
      <li><a href={`mailto:${BUSINESS.email}`} class="inline-flex items-center gap-1.5 text-white/85 no-underline hover:text-lime"><Icon name="card" class="h-3.5 w-3.5 text-lime" />{BUSINESS.email}</a></li>
      <li class="hidden items-center gap-2 lg:inline-flex"><span class="live-dot" aria-hidden="true"></span><span data-ist>{BUSINESS.hours}</span></li>
    </ul>
    <ul class="flex items-center gap-5">
      {GOOGLE.hasRating && (
        <li><a href={GOOGLE.url} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 text-white/85 no-underline hover:text-white"><GoogleLogo class="h-3.5 w-3.5" /><strong class="text-white">{GOOGLE.rating.toFixed(1)}</strong><Stars rating={GOOGLE.rating} class="h-3 w-3" /><span>on Google</span></a></li>
      )}
      <li><a href={waLink('Hi, I would like to book a taxi.')} rel="noopener" class="inline-flex items-center gap-1.5 text-white/85 no-underline hover:text-lime"><Icon name="whatsapp" class="h-3.5 w-3.5 text-lime" />WhatsApp, replies in minutes</a></li>
    </ul>
  </div>
</div>

<!-- No backdrop-filter or transform here: either would become the containing block for the fixed phone drawer. -->
<header class="relative border-b border-line bg-white" data-header>
  <div class="wrap flex h-[4.5rem] items-center justify-between gap-4">
    <Logo />

    <nav aria-label="Main" class="hidden min-w-0 shrink xl:block">
      <ul class="flex h-[4.5rem] items-center gap-1 text-[0.95rem]">
        {menus.map((m) => (
          <li class="mega flex h-full items-center" data-mega={m.key}>
            <span class:list={['nav-item', isActive(m.href) && 'is-active']}>
              <a href={m.href} class="py-2 pr-1 pl-3 font-medium whitespace-nowrap text-ink no-underline" aria-current={isActive(m.href) ? 'page' : undefined}>{m.label}</a>
              <button type="button" class="mega-toggle py-2 pr-3 pl-0.5 text-ink" aria-expanded="false" aria-haspopup="true" aria-controls={`mega-${m.key}`} aria-label={`Open ${m.label} menu`}>
                <svg class="h-4 w-4 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
              </button>
            </span>

            <div class="mega-panel" id={`mega-${m.key}`}>
              <div class="wrap grid gap-x-10 py-8 lg:grid-cols-[250px_minmax(0,1fr)_300px]">
                <!-- Intro column: what this part of the site is for, one action, and the road home. -->
                <div class="flex flex-col border-r border-line pr-8">
                  <h2 class="font-[family-name:var(--font-display)] text-[1.55rem] leading-[1.15] font-extrabold tracking-tight text-ink">{m.title}</h2>
                  <p class="mt-2.5 text-sm leading-relaxed text-muted">{m.text}</p>
                  <a href={m.href} class="btn-book mt-4 self-start min-h-11 px-4 py-2 text-sm">{m.cta} <Icon name="arrow" class="h-4 w-4" /></a>
                  <div class="mt-auto pt-6"><MountainDrive variant="mark" /></div>
                </div>

                {m.key === 'fares' && (
                  <div class="grid gap-x-8 sm:grid-cols-2">
                    <div>
                      <h3 class="text-[0.7rem] font-bold tracking-[0.14em] text-muted uppercase">From Bagdogra Airport</h3>
                      <ul class="mt-2 divide-y divide-line">
                        {airportRoutes.slice(0, MENU_ROWS).map((r) => (
                          <li><a href={`/taxi/${r.slug}/`} class="group flex items-center justify-between gap-3 py-[0.45rem] no-underline"><span class="min-w-0"><span class="block truncate text-sm font-semibold text-ink group-hover:text-lime-text">{r.toShort}</span><span class="block text-xs text-muted">{r.km} km · {r.duration}</span></span><span class="shrink-0 text-sm font-bold text-ink">{inr(lowestFare(r))}</span></a></li>
                        ))}
                      </ul>
                      {airportRoutes.length > MENU_ROWS && <a href="/taxi/" class="mt-2 inline-block text-xs font-semibold text-muted no-underline hover:text-ink">+{airportRoutes.length - MENU_ROWS} more from the airport →</a>}
                    </div>
                    <div>
                      <h3 class="text-[0.7rem] font-bold tracking-[0.14em] text-muted uppercase">From NJP station</h3>
                      <ul class="mt-2 divide-y divide-line">
                        {njpRoutes.slice(0, MENU_ROWS).map((r) => (
                          <li><a href={`/taxi/${r.slug}/`} class="group flex items-center justify-between gap-3 py-[0.45rem] no-underline"><span class="min-w-0"><span class="block truncate text-sm font-semibold text-ink group-hover:text-lime-text">{r.toShort}</span><span class="block text-xs text-muted">{r.km} km · {r.duration}</span></span><span class="shrink-0 text-sm font-bold text-ink">{inr(lowestFare(r))}</span></a></li>
                        ))}
                      </ul>
                      {njpRoutes.length > MENU_ROWS && <a href="/taxi/" class="mt-2 inline-block text-xs font-semibold text-muted no-underline hover:text-ink">+{njpRoutes.length - MENU_ROWS} more from NJP →</a>}
                    </div>
                    <p class="mt-4 text-xs text-muted sm:col-span-2">Also from Siliguri, the Dooars and the Nepal and Bhutan borders, and every return to the airport, on the <a href="/taxi/" class="font-semibold text-ink">full fare chart</a>.</p>
                  </div>
                )}
                {m.key === 'fares' && (
                  <aside class="rounded-2xl bg-cream p-4">
                    <h3 class="text-sm font-bold text-ink">Choose your car</h3>
                    <p class="mt-0.5 text-xs text-muted">Fare shown is airport to Darjeeling.</p>
                    <ul class="mt-3 space-y-2">
                      {VEHICLES.map((v) => (
                        <li><a href="/book/" class="flex items-center gap-3 rounded-xl p-1 no-underline hover:bg-white">
                          <span class="h-11 w-16 shrink-0 overflow-hidden rounded-lg bg-mist"><Photo name={carPhoto[v.key]} class="h-full w-full object-cover" sizes="64px" alt="" /></span>
                          <span class="min-w-0 flex-1 text-sm"><strong class="block text-ink">{v.name}</strong><span class="text-xs text-muted">{v.seats} seats · {v.bags}</span></span>
                          <strong class="shrink-0 text-sm text-ink">{inr(darj.fares[v.key])}</strong>
                        </a></li>
                      ))}
                    </ul>
                    <a href="/book/" class="btn-ghost mt-3 w-full min-h-11 text-sm">Check my fare <Icon name="arrow" class="h-4 w-4" /></a>
                  </aside>
                )}

                {m.key === 'packages' && (
                  <ul class="grid gap-x-4 gap-y-5 sm:grid-cols-2 lg:grid-cols-3">
                    {menuPackages.map((p) => (
                      <li>
                        <a href={`/tour-packages/${p.slug}/`} class="group block no-underline">
                          <span class="block aspect-[16/10] overflow-hidden rounded-xl bg-mist"><Photo name={packagePhoto(p)} class="zoom h-full w-full object-cover" sizes="300px" alt="" /></span>
                          <span class="mt-2 block text-sm leading-snug font-semibold text-ink group-hover:text-lime-text">{p.short}</span>
                          <span class="mt-0.5 block text-xs text-muted">{p.nights} nights · from {inr(p.fromPrice)} per person</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
                {m.key === 'packages' && (
                  <aside class="rounded-2xl bg-cream p-4">
                    <h3 class="text-sm font-bold text-ink">Popular themes</h3>
                    <ul class="mt-3 flex flex-wrap gap-1.5">
                      {themes.map((t) => <li><a href="/tour-packages/" class="rounded-full border border-line bg-white px-2.5 py-1 text-xs font-medium text-ink no-underline hover:border-ink">{t}</a></li>)}
                    </ul>
                    <p class="mt-4 text-xs leading-relaxed text-muted">Every package: one private car for the whole trip, hotels with breakfast and dinner, permits arranged, {BUSINESS.hours.toLowerCase()} support.</p>
                    <a href={waLink('Hi, I would like a custom tour quote.')} rel="noopener" class="btn-wa mt-4 w-full min-h-11 text-sm"><Icon name="whatsapp" class="h-4 w-4" /> Custom quote</a>
                  </aside>
                )}

                {m.key === 'destinations' && (
                  <div class="grid gap-x-6 sm:grid-cols-3">
                    {destGroups.map((g) => (
                      <div>
                        <h3 class="text-[0.7rem] font-bold tracking-[0.14em] text-muted uppercase">{g.name}</h3>
                        <ul class="mt-2">
                          {g.items.map((d) => (
                            <li><a href={`/destinations/${d.slug}/`} class="group flex items-center gap-3 rounded-xl py-1.5 no-underline">
                              <span class="h-11 w-11 shrink-0 overflow-hidden rounded-full bg-mist"><Photo name={destinationPhoto(d)} class="zoom h-full w-full object-cover" sizes="44px" alt="" /></span>
                              <span class="min-w-0"><span class="block truncate text-sm font-semibold text-ink group-hover:text-lime-text">{d.short ?? d.name}</span><span class="block truncate text-xs text-muted">{d.daysNeeded}</span></span>
                            </a></li>
                          ))}
                        </ul>
                      </div>
                    ))}
                  </div>
                )}
                {m.key === 'destinations' && (
                  <aside class="relative overflow-hidden rounded-2xl bg-ink p-5 text-white">
                    <Photo name="pelling" class="absolute inset-0 h-full w-full object-cover opacity-50" sizes="300px" alt="" />
                    <div class="relative flex h-full flex-col">
                      <p class="text-[0.65rem] font-bold tracking-[0.14em] text-lime uppercase">Not sure where to go?</p>
                      <h3 class="mt-2 font-[family-name:var(--font-display)] text-xl leading-tight font-extrabold text-white">Tell us your dates and who is travelling.</h3>
                      <p class="mt-2 text-sm leading-relaxed text-white/80">We will suggest a route that fits, with the fare and the permits worked out.</p>
                      <a href={waLink('Hi, I am planning a trip and would like some advice.')} rel="noopener" class="btn-wa mt-auto w-full min-h-11 pt-4 text-sm"><Icon name="whatsapp" class="h-4 w-4" /> Ask us</a>
                    </div>
                  </aside>
                )}

                {m.key === 'guides' && (
                  <div class="grid gap-6 sm:grid-cols-[minmax(0,1.1fr)_minmax(0,1fr)]">
                    <a href={`/guides/${leadGuide.slug}/`} class="group block no-underline">
                      <span class="block aspect-[16/9] overflow-hidden rounded-xl bg-mist"><Photo name={guidePhoto(leadGuide.slug)} class="zoom h-full w-full object-cover" sizes="420px" alt="" /></span>
                      <span class="mt-3 block text-[0.7rem] font-bold tracking-[0.14em] text-muted uppercase">Most read</span>
                      <span class="mt-1 block text-base leading-snug font-bold text-ink group-hover:text-lime-text">{leadGuide.title}</span>
                      <span class="mt-1 line-clamp-2 block text-sm leading-relaxed text-muted">{leadGuide.description}</span>
                    </a>
                    <ul class="divide-y divide-line">
                      {moreGuides.map((g) => (
                        <li><a href={`/guides/${g.slug}/`} class="group flex items-center gap-3 py-2.5 no-underline">
                          <span class="h-12 w-16 shrink-0 overflow-hidden rounded-lg bg-mist"><Photo name={guidePhoto(g.slug)} class="zoom h-full w-full object-cover" sizes="64px" alt="" /></span>
                          <span class="min-w-0"><span class="line-clamp-2 text-sm leading-snug font-semibold text-ink group-hover:text-lime-text">{g.title}</span><span class="block text-xs text-muted">Updated {g.updatedLabel}</span></span>
                        </a></li>
                      ))}
                    </ul>
                  </div>
                )}
                {m.key === 'guides' && (
                  <aside class="self-start rounded-2xl bg-cream p-4">
                    <p class="text-[0.65rem] font-bold tracking-[0.14em] text-lime-text uppercase">Read before you book Sikkim</p>
                    <a href={`/guides/${permitGuide.slug}/`} class="mt-2 block text-sm font-bold text-ink no-underline hover:underline">{permitGuide.title}</a>
                    <p class="mt-2 text-xs leading-relaxed text-muted">{permitGuide.description}</p>
                    <p class="mt-3 text-xs font-semibold text-ink">We arrange the permits with every booking.</p>
                  </aside>
                )}

                <div class="mt-7 flex flex-wrap items-center justify-between gap-3 border-t border-line pt-4 text-sm lg:col-span-3">
                  <p class="text-muted">Prefer to talk? <a href={BUSINESS.phoneHref} class="font-semibold text-ink no-underline">{BUSINESS.phone}</a>, {BUSINESS.hours.toLowerCase()}.</p>
                  <a href={waLink('Hi, I would like to book a taxi.')} rel="noopener" class="inline-flex items-center gap-1.5 font-semibold text-ink no-underline hover:text-wa"><Icon name="whatsapp" class="h-4 w-4 text-wa" /> WhatsApp, replies in minutes</a>
                </div>
              </div>
            </div>
          </li>
        ))}
        {plain.map((n) => (
          <li class="flex h-full items-center"><span class:list={['nav-item', isActive(n.href) && 'is-active']}><a href={n.href} class="px-3 py-2 font-medium whitespace-nowrap text-ink no-underline" aria-current={isActive(n.href) ? 'page' : undefined}>{n.label}</a></span></li>
        ))}
      </ul>
    </nav>

    <div class="flex shrink-0 items-center gap-2">
      <a href={BUSINESS.phoneHref} class="hidden items-center gap-1.5 whitespace-nowrap px-2 py-2 text-[0.92rem] font-semibold text-ink no-underline hover:text-lime-text 2xl:flex"><Icon name="phone" class="h-4 w-4" />{BUSINESS.phone}</a>
      <a href={waLink('Hi, I would like to book a taxi.')} rel="noopener" class="hidden h-11 w-11 items-center justify-center rounded-xl border border-line text-wa no-underline transition-colors hover:border-ink sm:inline-flex" aria-label="WhatsApp us"><Icon name="whatsapp" class="h-5 w-5" /></a>
      <a href="/book/" class="btn-book hidden min-h-11 whitespace-nowrap px-5 py-2 sm:inline-flex">Book a taxi</a>

      <!-- Phone drawer -->
      <details class="mnav xl:hidden">
        <summary class="flex h-11 w-11 cursor-pointer list-none items-center justify-center rounded-xl border border-line bg-white" aria-label="Menu">
          <svg class="mnav-open h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
          <svg class="mnav-close hidden h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
        </summary>
        <nav aria-label="Mobile" class="mnav-panel fixed inset-x-0 bottom-0 z-50 overflow-y-auto bg-white pb-28">
          <div class="wrap py-3">
            <div class="grid grid-cols-2 gap-2">
              <a href="/book/" class="btn-book min-h-11 text-sm">Book a taxi</a>
              <a href={waLink('Hi, I would like to book a taxi.')} rel="noopener" class="btn-wa min-h-11 text-sm"><Icon name="whatsapp" class="h-4 w-4" /> WhatsApp</a>
            </div>
            <ul class="mt-3 divide-y divide-line">
              <li>
                <details class="group">
                  <summary class="flex cursor-pointer list-none items-center justify-between py-3.5 font-semibold text-ink">Taxi fares <span class="text-xs text-muted">from {inr(minFare)}</span></summary>
                  <ul class="pb-3">
                    {ROUTES.slice(0, 10).map((r) => <li><a href={`/taxi/${r.slug}/`} class="flex justify-between py-2 text-sm text-body no-underline"><span>{r.fromShort} → {r.toShort}</span><strong class="text-ink">{inr(lowestFare(r))}</strong></a></li>)}
                    <li><a href="/taxi/" class="block py-2 text-sm font-semibold no-underline">All {ROUTES.length} fares →</a></li>
                  </ul>
                </details>
              </li>
              <li>
                <details class="group">
                  <summary class="flex cursor-pointer list-none items-center justify-between py-3.5 font-semibold text-ink">Tour packages <span class="text-xs text-muted">from {inr(minPkg)}</span></summary>
                  <ul class="pb-3">
                    {PACKAGES.slice(0, 8).map((p) => <li><a href={`/tour-packages/${p.slug}/`} class="flex justify-between gap-3 py-2 text-sm text-body no-underline"><span class="truncate">{p.name}</span><strong class="shrink-0 text-ink">{p.nights}N</strong></a></li>)}
                    <li><a href="/tour-packages/" class="block py-2 text-sm font-semibold no-underline">All {PACKAGES.length} packages →</a></li>
                  </ul>
                </details>
              </li>
              <li>
                <details class="group">
                  <summary class="flex cursor-pointer list-none items-center justify-between py-3.5 font-semibold text-ink">Destinations</summary>
                  <ul class="grid grid-cols-2 pb-3">
                    {DESTINATIONS.map((d) => <li><a href={`/destinations/${d.slug}/`} class="block py-2 text-sm text-body no-underline">{d.short ?? d.name}</a></li>)}
                  </ul>
                </details>
              </li>
              <li>
                <details class="group">
                  <summary class="flex cursor-pointer list-none items-center justify-between py-3.5 font-semibold text-ink">Travel guides</summary>
                  <ul class="pb-3">
                    {GUIDES.map((g) => <li><a href={`/guides/${g.slug}/`} class="block py-2 text-sm text-body no-underline">{g.title}</a></li>)}
                  </ul>
                </details>
              </li>
              <li><a href="/gallery/" class="block py-3.5 font-semibold text-ink no-underline">Gallery</a></li>
              <li><a href="/about/" class="block py-3.5 font-semibold text-ink no-underline">About</a></li>
              <li><a href="/contact/" class="block py-3.5 font-semibold text-ink no-underline">Contact</a></li>
            </ul>
            <p class="mt-4 text-sm text-muted"><a href={BUSINESS.phoneHref} class="font-semibold text-ink">{BUSINESS.phone}</a> · {BUSINESS.hours}</p>
          </div>
        </nav>
      </details>
    </div>
  </div>
</header>
</div>

<style>
  /* Each item shows a 2px ink bar along the bottom edge of the header on hover, open or current. */
  .nav-item { position: relative; display: flex; align-items: center; height: 4.5rem; border-radius: 0; }
  .nav-item::after {
    content: ''; position: absolute; left: .75rem; right: .75rem; bottom: 0; height: 2px;
    background: var(--color-ink); transform: scaleX(0); transform-origin: left; transition: transform .22s cubic-bezier(.2,.7,.2,1);
  }
  .nav-item.is-active::after, .nav-item:hover::after, .mega:hover .nav-item::after, .mega.is-open .nav-item::after { transform: scaleX(1); }
  .nav-item a:hover, .mega:hover .nav-item a, .mega.is-open .nav-item a { color: var(--color-ink); }
  .mega-toggle svg { color: var(--color-muted); }
  .mega:hover .mega-toggle svg, .mega.is-open .mega-toggle svg { color: var(--color-ink); transform: rotate(180deg); }

  /* The panel is a full-width band under the bar; the content inside keeps to .wrap. */
  .mega-panel {
    display: none;
    position: absolute;
    left: 0; right: 0; top: 100%;
    background: #fff;
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
    box-shadow: 0 30px 60px -30px rgb(17 17 17 / 40%);
    animation: mega-in .22s cubic-bezier(.2,.7,.2,1);
  }
  @keyframes mega-in { from { opacity: 0; transform: translateY(-8px); } to { opacity: 1; transform: none; } }
  /* While a menu is open, an invisible strip under the bar keeps the item hovered as the
     pointer crosses into the panel. */
  .mega:hover::after, .mega.is-open::after {
    content: ''; position: absolute; left: 0; right: 0; top: 100%; height: 12px;
  }
  .mega:hover > .mega-panel,
  .mega:focus-within > .mega-panel,
  .mega.is-open > .mega-panel { display: block; }

  /* The page dims and softens behind an open menu, so the panel reads as the one thing to look at. */
  .mega-scrim {
    position: fixed; inset: 0; z-index: 30; pointer-events: none;
    background: rgb(17 17 17 / 42%); backdrop-filter: blur(3px); -webkit-backdrop-filter: blur(3px);
    opacity: 0; transition: opacity .25s ease;
  }
  body:has(.mega.is-open) .mega-scrim, body:has(.mega:focus-within) .mega-scrim { opacity: 1; }
  @media (hover: hover) { body:has(.mega:hover) .mega-scrim { opacity: 1; } }

  /* Sticky offset equals minus the bar height, so the bar scrolls away naturally and the header
     pins at 0. Scrolling up sets .is-up, which animates the offset to 0 and reveals the bar. */
  .chrome { top: 0; transition: top .28s cubic-bezier(.2,.7,.2,1); }
  @media (min-width: 768px) {
    .chrome { top: -2.25rem; }
    .chrome.is-up { top: 0; }
  }
  .mnav-panel { top: var(--drawer-top, 4.5rem); }

  .mnav[open] .mnav-open { display: none; }
  .mnav[open] .mnav-close { display: block; }
  .mnav[open] > summary { background: var(--color-ink); color: #fff; border-color: var(--color-ink); }
  @media (hover: none) {
    /* On touch screens hover is sticky and confusing; the toggle button does the work. */
    .mega:hover > .mega-panel { display: none; }
    .mega:hover::after { content: none; }
    .mega.is-open > .mega-panel { display: block; }
  }
  @media (prefers-reduced-motion: reduce) { .mega-panel { animation: none; } .mega-scrim { transition: none; backdrop-filter: none; } }
</style>

<script>
  // Local time at Bagdogra in the top bar, so the "open now" claim is visibly live.
  const ist = document.querySelector<HTMLElement>('[data-ist]');
  if (ist) {
    const fmt = new Intl.DateTimeFormat('en-IN', { hour: '2-digit', minute: '2-digit', hour12: false, timeZone: 'Asia/Kolkata' });
    const tick = () => { ist.textContent = `Bagdogra ${fmt.format(new Date())} IST · drivers on duty now`; };
    tick(); setInterval(tick, 15000);
  }

  const items = [...document.querySelectorAll<HTMLElement>('.mega')];
  const close = () => items.forEach((i) => { i.classList.remove('is-open'); i.querySelector('.mega-toggle')?.setAttribute('aria-expanded', 'false'); });
  items.forEach((item) => {
    const btn = item.querySelector<HTMLButtonElement>('.mega-toggle')!;
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      const open = item.classList.contains('is-open');
      close();
      if (!open) { item.classList.add('is-open'); btn.setAttribute('aria-expanded', 'true'); }
    });
  });
  // Hover intent: opening waits a beat so a pointer crossing the bar does not flash menus,
  // and closing waits longer so a short detour outside the panel does not shut it.
  if (window.matchMedia('(hover: hover)').matches) {
    let openTimer = 0, closeTimer = 0;
    items.forEach((item) => {
      const btn = item.querySelector<HTMLButtonElement>('.mega-toggle')!;
      item.addEventListener('mouseenter', () => {
        clearTimeout(closeTimer);
        openTimer = window.setTimeout(() => { close(); item.classList.add('is-open'); btn.setAttribute('aria-expanded', 'true'); }, 60);
      });
      item.addEventListener('mouseleave', () => {
        clearTimeout(openTimer);
        closeTimer = window.setTimeout(() => { item.classList.remove('is-open'); btn.setAttribute('aria-expanded', 'false'); }, 260);
      });
    });
  }
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });
  document.addEventListener('click', (e) => { if (!(e.target as Element).closest('.mega')) close(); });
  // Lock page scroll while the phone drawer is open, and hang the drawer from the header's
  // real bottom edge, wherever the top bar has left it.
  const drawer = document.querySelector<HTMLDetailsElement>('.mnav');
  const header = document.querySelector<HTMLElement>('[data-header]');
  drawer?.addEventListener('toggle', () => {
    document.body.style.overflow = drawer.open ? 'hidden' : '';
    if (drawer.open && header) drawer.style.setProperty('--drawer-top', `${Math.round(header.getBoundingClientRect().bottom)}px`);
  });

  // Scroll direction drives the top bar: any upward scroll brings it back, any downward scroll
  // parks it again. Within the bar's own height of the page top, normal layout takes over.
  const chrome = document.querySelector<HTMLElement>('[data-chrome]');
  const topbar = document.querySelector<HTMLElement>('[data-topbar]');
  if (chrome && topbar) {
    let last = window.scrollY, queued = false;
    const update = () => {
      queued = false;
      const y = Math.max(0, window.scrollY);
      if (y <= topbar.offsetHeight) chrome.classList.remove('is-up');
      else if (y < last) chrome.classList.add('is-up');
      else if (y > last) chrome.classList.remove('is-up');
      last = y;
    };
    window.addEventListener('scroll', () => { if (!queued) { queued = true; requestAnimationFrame(update); } }, { passive: true });
  }
</script>
