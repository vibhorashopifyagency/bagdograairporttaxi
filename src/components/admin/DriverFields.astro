---
/**
 * The fields of the add-driver and edit-driver popups. Pay is shown to
 * everyone but only the admin can change it.
 */
import { VEHICLES } from '../../data/vehicles';
import type { DriverForm } from '../../server/drivers';

interface Props {
  f: DriverForm;
  canSetPay: boolean;
  /** Prefix for element ids, so two copies on one page do not clash. */
  idp: string;
  /** Prefix for field names, when the fields sit inside another form. */
  prefix?: string;
}
const { f, canSetPay, idp, prefix = '' } = Astro.props;
const n = (k: string) => `${prefix}${k}`;
---

<div class="grid gap-4 sm:grid-cols-2" data-driver-fields>
  <label class="a-field">Name<input name={n('name')} required={!prefix} maxlength="60" value={f.name} autocomplete="off" /></label>
  <label class="a-field">Phone<input name={n('phone')} type="tel" inputmode="tel" value={f.phone} placeholder="98300 12345" autocomplete="off" /></label>
  <label class="a-field">Car number<input name={n('vehicleNumber')} maxlength="20" value={f.vehicleNumber} placeholder="WB 73 F 5560" autocapitalize="characters" autocomplete="off" /></label>
  <label class="a-field">Usual car
    <select name={n('vehicle')}>
      <option value="">Any</option>
      {VEHICLES.map((v) => <option value={v.key} selected={f.vehicle === v.key}>{v.name}</option>)}
    </select>
  </label>
  <fieldset class="m-0 flex flex-col gap-2 rounded-2xl border-0 bg-mist p-4 sm:col-span-2" disabled={!canSetPay}>
    <legend class="float-left mb-1 font-display text-lg font-bold">Pay for each completed trip</legend>
    <div class="clear-both flex flex-wrap items-end gap-3">
      <label class="a-pill"><input type="radio" name={n('payType')} value="percent" checked={f.payType !== 'fixed'} class="sr-only" /><span>Share of the fare</span></label>
      <label class="a-pill"><input type="radio" name={n('payType')} value="fixed" checked={f.payType === 'fixed'} class="sr-only" /><span>Fixed amount</span></label>
      <label class="a-field w-36" for={`${idp}-pay`}>
        <span data-pay-unit>{f.payType === 'fixed' ? '₹ a trip' : '% of the fare'}</span>
        <input id={`${idp}-pay`} name={n('payValue')} inputmode="numeric" value={f.payValue} placeholder={f.payType === 'fixed' ? '800' : '25'} autocomplete="off" />
      </label>
    </div>
    <span class="text-sm text-muted">
      {canSetPay
        ? 'Worked out when the driver is put on a booking, and can be changed on that booking. Leave it empty if it is not agreed yet.'
        : 'Only the admin can change a driver’s pay.'}
    </span>
  </fieldset>
  <label class="a-field sm:col-span-2"><span>Notes <span class="font-normal text-muted">(optional)</span></span><textarea name={n('notes')} rows="2" maxlength="500">{f.notes}</textarea></label>
</div>
