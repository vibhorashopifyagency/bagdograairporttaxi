---
/**
 * A labelled password box with an eye button that shows or hides what was
 * typed. The click handler lives in AdminLayout, so it works on every admin
 * page. The label is tied to the input by id (a button may not sit inside a
 * <label>).
 */
interface Props {
  name: string;
  label: string;
  /** Grey text after the label, e.g. "(at least 10 characters)". */
  hint?: string;
  autocomplete: 'current-password' | 'new-password';
  minlength?: number;
  required?: boolean;
  /** Width class for the whole field, e.g. "w-56". Full width when omitted. */
  class?: string;
  labelClass?: string;
}
const { name, label, hint, autocomplete, minlength, required = true, class: width, labelClass } = Astro.props;
const id = `pw-${name}-${Math.random().toString(36).slice(2, 8)}`;
---

<div class:list={['a-field', width]}>
  <label for={id} class={labelClass}>{label}{hint && <span class="font-normal text-muted"> {hint}</span>}</label>
  <div class="a-pw">
    <input
      id={id}
      name={name}
      type="password"
      required={required}
      minlength={minlength}
      autocomplete={autocomplete}
      autocapitalize="none"
      spellcheck="false"
    />
    <button type="button" class="a-pw-toggle" data-pw-toggle aria-label="Show password" aria-pressed="false">
      <svg data-eye width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z"></path><circle cx="12" cy="12" r="3"></circle></svg>
      <svg data-eye-off width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10.7 5.1A10.9 10.9 0 0 1 12 5c6.4 0 10 7 10 7a17.6 17.6 0 0 1-2.2 3.2M6.6 6.6A17.4 17.4 0 0 0 2 12s3.6 7 10 7a9.7 9.7 0 0 0 5.4-1.6M9.9 9.9a3 3 0 0 0 4.2 4.2M2 2l20 20"></path></svg>
    </button>
  </div>
</div>
