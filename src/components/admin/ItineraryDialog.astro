  .it-trip-summary { display: flex; flex-direction: column; gap: 0.5rem; }
  .it-trip-summary > button { align-self: flex-end; margin-top: -0.25rem; }
  .it-trip-fields { display: none; }
  [data-trip].is-editing .it-trip-fields { display: grid; }
  [data-trip].is-editing .it-trip-summary dl { display: none; }
  @media (min-width: 1024px) {
    .it-trip-summary { display: none; }
    .it-trip-fields { display: grid; }
  }
  .it-photos { display: flex; gap: 0.5rem; overflow-x: auto; padding-bottom: 0.25rem; }
  @media (min-width: 1024px) { .it-photos { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); overflow: visible; } }
  .it-photo, .it-photo-add { position: relative; width: 88px; height: 88px; flex-shrink: 0; border-radius: 12px; }
  @media (min-width: 1024px) { .it-photo, .it-photo-add { width: auto; height: auto; aspect-ratio: 1; } }
  .it-photo img { width: 100%; height: 100%; object-fit: cover; border-radius: 12px; }
  .it-photo-x { position: absolute; top: 4px; right: 4px; width: 28px; height: 28px; display: grid; place-items: center; border: 0; border-radius: 999px; background: rgb(17 17 17 / 72%); color: #fff; }
  .it-photo-add { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.25rem; border: 1px dashed #b9bfca; background: #fff; font: inherit; font-size: 0.8125rem; font-weight: 600; color: var(--color-ink); order: -1; }
  @media (min-width: 1024px) { .it-photo-add { order: 0; } }
  .it-switch { display: flex; align-items: center; gap: 0.65rem; min-height: 2.75rem; font-size: 0.875rem; font-weight: 600; cursor: pointer; }
  .it-switch-track { position: relative; width: 44px; height: 26px; flex-shrink: 0; border-radius: 13px; background: #c9ced8; transition: background 0.15s; }
  .it-switch-track span { position: absolute; left: 3px; top: 3px; width: 20px; height: 20px; border-radius: 50%; background: #fff; transition: transform 0.15s; }
  .it-switch input:checked + .it-switch-track { background: var(--color-ink); }
  .it-switch input:checked + .it-switch-track span { transform: translateX(18px); background: var(--color-lime); }
  .it-switch input:focus-visible + .it-switch-track { outline: 3px solid var(--color-lime); outline-offset: 2px; }
  .it-switch input:disabled + .it-switch-track { opacity: 0.5; }
  .it-chips { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  @media (max-width: 1023px) { .it-chips { flex-wrap: nowrap; overflow-x: auto; padding-bottom: 0.25rem; } }
  .it-chip-wrap { display: inline-flex; flex-shrink: 0; }
  .it-chip { min-height: 2.5rem; padding: 0 0.9rem; border-radius: 999px; border: 1px solid #dfe2e7; background: #fff; font: inherit; font-size: 0.8125rem; font-weight: 600; color: var(--color-ink); white-space: nowrap; }
  .it-chip:hover { border-color: var(--color-ink); }
  .it-chip-wrap:has(.it-chip-x) .it-chip { border-radius: 999px 0 0 999px; border-right: 0; }
  .it-chip-x { display: grid; place-items: center; min-width: 2.25rem; border: 1px solid #dfe2e7; border-radius: 0 999px 999px 0; background: #fff; color: #5c6373; }
  .it-chip-save { border-style: dashed; border-color: #b9bfca; color: var(--color-body); font-weight: 500; }
  .it-pick { display: flex; flex-direction: column; width: 100%; padding: 0; overflow: hidden; border: 2px solid transparent; border-radius: 14px; background: var(--color-mist); font: inherit; color: var(--color-ink); }
  .it-pick img { width: 100%; aspect-ratio: 3 / 2; object-fit: cover; }
  .it-pick[aria-pressed='true'] { border-color: var(--color-ink); background: var(--color-lime-50); }
  .it-pick[aria-pressed='true'] img { outline: 3px solid var(--color-lime); outline-offset: -3px; }
  @media (max-width: 1023px) {
    .it-foot { flex-direction: column-reverse; align-items: stretch; }
    .it-foot > [data-status] { text-align: center; }
  }
</style>
