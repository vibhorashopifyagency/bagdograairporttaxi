---
/**
 * The toolbar above a long list: a date range (see DateRangePicker) and how
 * many rows a page shows, all one height. Choosing dates starts the list
 * again from the top and keeps its other filters (search, status, tab).
 * Anything passed in the "start" slot (the Upcoming / Past tabs) sits first;
 * the "end" slot (more filters, such as trip and payment) follows the dates.
 */
import DateRangePicker from './DateRangePicker.astro';
import RowsPicker from './RowsPicker.astro';
import { todayIST } from '../../server/dashboard';
import type { PresetKey } from '../../lib/date-range';

interface Props {
  /** Which date the range applies to, as people say it: "Last booked", "Received". */
  dateLabel: string;
  from: string | null;
  to: string | null;
  /** Quick picks offered in the calendar, in order. */
  presets: PresetKey[];
  /** A choice of which date to filter by (bookings: pickup or booked on). The first option is the default. */
  by?: { name: string; value: string; options: [value: string, label: string][] };
  /** The list's other filters, carried through when dates are applied. */
  keep?: Record<string, string | null | undefined>;
  /** The same list with the dates taken off. */
  clearHref: string;
  rows: number;
  rowsHref: (n: number) => string;
  class?: string;
}
const { dateLabel, from, to, presets, by, keep = {}, clearHref, rows, rowsHref, class: extra } = Astro.props;
---

<form method="get" class:list={['flex flex-wrap items-center gap-x-3 gap-y-2.5', extra]} aria-label="Filters">
  {Object.entries(keep).map(([k, v]) => v && <input type="hidden" name={k} value={v} />)}
  <slot name="start" />
  <DateRangePicker label={dateLabel} from={from} to={to} today={todayIST()} presets={presets} by={by} clearHref={clearHref} />
  <slot name="end" />
  <RowsPicker class="ml-auto" current={rows} href={rowsHref} />
</form>
