---
import Icon from './Icon.astro';
import { BUSINESS, waLink } from '../data/site';
---

<!-- Thumb-reach actions for phones; most bookings start on a phone at the airport. -->
<div class="fixed inset-x-0 bottom-0 z-40 grid grid-cols-3 border-t border-line bg-white text-sm font-semibold sm:hidden" style="padding-bottom: env(safe-area-inset-bottom)">
  <a href={BUSINESS.phoneHref} class="flex flex-col items-center gap-0.5 py-2.5 text-ink no-underline"><Icon name="phone" />Call</a>
  <a href={waLink('Hi, I would like to book a taxi.')} rel="noopener" class="flex flex-col items-center gap-0.5 py-2.5 text-wa no-underline"><Icon name="whatsapp" />WhatsApp</a>
  <a href="/book/" class="flex flex-col items-center gap-0.5 bg-ink py-2.5 text-white no-underline"><Icon name="car" />Book</a>
</div>
