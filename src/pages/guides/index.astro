---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import GuideCard from '../../components/GuideCard.astro';
import Photo from '../../components/Photo.astro';
import Icon from '../../components/Icon.astro';
import PhotoMarquee from '../../components/PhotoMarquee.astro';
import TrustStrip from '../../components/TrustStrip.astro';
import BookCta from '../../components/BookCta.astro';
import { GUIDES } from '../../data/guides';
import { GALLERY } from '../../data/gallery';
import { BUSINESS, waLink } from '../../data/site';
import Words from '../../components/Words.astro';
import { wordsText } from '../../data/page-text';

const [featured, ...rest] = GUIDES;
const latest = GUIDES.map((g) => g.updatedLabel).sort().at(-1);

// One-line answers to the questions the phone rings with, each pointing at the guide that explains it.
// The words are "Travel guides (all)" in the dashboard (src/data/page-text.ts).
const quick = [
  { n: 'quick1', slug: 'sikkim-permit-guide' },
  { n: 'quick2', slug: 'bagdogra-airport-transport-guide' },
  { n: 'quick3', slug: 'best-time-to-visit-darjeeling-sikkim' },
  { n: 'quick4', slug: 'nathula-pass-guide' },
  { n: 'quick5', slug: 'offbeat-places-north-bengal-sikkim' },
  { n: 'quick6', slug: 'bagdogra-airport-transport-guide' },
];

const steps = ['step1', 'step2', 'step3'];
---

<BaseLayout
  title={wordsText('guides', 'seoTitle')}
  description={wordsText('guides', 'seoDescription')}
  crumbs={[{ name: 'Travel guides', path: '/guides/' }]}
>
  <PageHero slot="hero" image="teesta" words="guides" compact>
    <Words page="guides" field="heroLead" as="p" class="mt-4 max-w-2xl text-lg text-white/85" />
    <div class="mt-5 flex flex-wrap gap-2">
      <span class="chip-light"><Icon name="map" class="h-4 w-4" /> {GUIDES.length} guides</span>
      <span class="chip-light"><Icon name="check" class="h-4 w-4" /> Updated {latest}</span>
      <span class="chip-light"><Icon name="car" class="h-4 w-4" /> <Words page="guides" field="chipWriters" /></span>
    </div>
  </PageHero>

  <section class="wrap section" aria-labelledby="guides-h">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div><Words page="guides" field="listEyebrow" as="p" class="eyebrow" /><Words page="guides" field="listTitle" as="h2" id="guides-h" class="mt-2 text-3xl font-extrabold sm:text-[2.5rem] sm:leading-[1.1]" /></div>
      <Words page="guides" field="listNote" as="p" class="max-w-md text-body" />
    </div>
    <div class="mt-8 grid gap-5 md:grid-cols-2 lg:grid-cols-3" data-reveal-stagger>
      <GuideCard guide={featured} featured />
      {rest.map((g) => <GuideCard guide={g} />)}
    </div>
  </section>

  <section class="bg-cream py-14 sm:py-16" aria-labelledby="quick-h">
    <div class="wrap">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div><Words page="guides" field="quickEyebrow" as="p" class="eyebrow" /><Words page="guides" field="quickTitle" as="h2" id="quick-h" class="mt-2 text-3xl font-extrabold sm:text-[2.5rem] sm:leading-[1.1]" /></div>
        <a href="/faq/" class="inline-flex items-center gap-1.5 font-semibold text-ink no-underline hover:text-lime-text"><Words page="guides" field="quickLink" /> <Icon name="arrow" class="h-4 w-4" /></a>
      </div>
      <ul class="mt-8 grid gap-4 sm:grid-cols-2 xl:grid-cols-3" data-reveal-stagger>
        {quick.map((it, i) => (
          <li>
            <a href={`/guides/${it.slug}/`} class="card lift group flex h-full gap-4 p-5 no-underline">
              <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-lime font-[family-name:var(--font-display)] text-sm font-extrabold text-ink">{String(i + 1).padStart(2, '0')}</span>
              <span class="min-w-0">
                <Words page="guides" field={`${it.n}Q`} as="strong" class="block font-[family-name:var(--font-display)] text-lg leading-snug text-ink group-hover:text-lime-text" />
                <Words page="guides" field={`${it.n}A`} class="mt-1.5 block text-sm leading-relaxed text-body" />
                <span class="mt-3 inline-flex items-center gap-1.5 text-sm font-semibold text-ink"><Words page="guides" field="quickMore" /> <Icon name="arrow" class="h-4 w-4 transition-transform group-hover:translate-x-1" /></span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="wrap section" aria-labelledby="how-h">
    <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
      <div>
        <Words page="guides" field="howEyebrow" as="p" class="eyebrow" />
        <Words page="guides" field="howTitle" as="h2" id="how-h" class="mt-2 text-3xl font-extrabold sm:text-[2.5rem] sm:leading-[1.1]" />
        <Words page="guides" field="howLead" as="p" class="mt-3 text-lg leading-relaxed text-body" />
        <ol class="mt-8 space-y-6" data-reveal-stagger>
          {steps.map((s, i) => (
            <li class="flex gap-5">
              <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-ink font-[family-name:var(--font-display)] text-lg font-extrabold text-lime">{i + 1}</span>
              <span><Words page="guides" field={`${s}Title`} as="strong" class="block font-[family-name:var(--font-display)] text-xl text-ink" /><Words page="guides" field={`${s}Text`} class="mt-1 block leading-relaxed text-body" /></span>
            </li>
          ))}
        </ol>
        <div class="mt-8 flex flex-wrap gap-3">
          <a class="btn-wa" href={waLink(wordsText('whatsapp', 'guides'))} rel="noopener"><Icon name="whatsapp" /> <Words page="guides" field="howWhatsapp" /></a>
          <a class="btn-ghost" href={BUSINESS.phoneHref}><Icon name="phone" /> {BUSINESS.phone}</a>
        </div>
      </div>
      <div class="relative" data-reveal>
        <div class="relative aspect-[4/3] overflow-hidden rounded-[28px] bg-mist">
          <Photo name="tea-worker" class="absolute inset-0 h-full w-full object-cover" sizes="(min-width: 1024px) 50vw, 100vw" alt="" />
        </div>
        <div class="card absolute -bottom-5 left-5 right-5 flex items-center gap-3 p-4 shadow-[var(--shadow-float)] sm:left-auto sm:right-6 sm:w-80">
          <span class="live-dot shrink-0"></span>
          <span class="text-sm"><Words page="guides" field="dutyTitle" as="strong" class="block text-ink" /><Words page="guides" field="dutyText" class="text-muted" /></span>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-cream py-14 sm:py-16" aria-labelledby="where-h">
    <div class="wrap">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div><Words page="guides" field="whereEyebrow" as="p" class="eyebrow" /><Words page="guides" field="whereTitle" as="h2" id="where-h" class="mt-2 text-3xl font-extrabold sm:text-[2.5rem] sm:leading-[1.1]" /></div>
        <a href="/gallery/" class="inline-flex items-center gap-1.5 font-semibold text-ink no-underline hover:text-lime-text"><Words page="guides" field="whereLink" /> <Icon name="arrow" class="h-4 w-4" /></a>
      </div>
    </div>
    <div class="mt-8"><PhotoMarquee items={GALLERY.filter((g) => g.category !== 'Our cars')} /></div>
  </section>

  <div class="wrap section">
    <TrustStrip />
    <BookCta waText={wordsText('whatsapp', 'guides')} words="guides:ctaTitle" image="nathula" />
  </div>
</BaseLayout>
