---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import DestinationTile from '../../components/DestinationTile.astro';
import BookCta from '../../components/BookCta.astro';
import PhotoMarquee from '../../components/PhotoMarquee.astro';
import { DESTINATIONS } from '../../data/destinations';
import { GALLERY } from '../../data/gallery';
import Words from '../../components/Words.astro';
import { wordsText } from '../../data/page-text';
---

<BaseLayout
  title={wordsText('destinations', 'seoTitle')}
  description={wordsText('destinations', 'seoDescription')}
  crumbs={[{ name: 'Destinations', path: '/destinations/' }]}
>
  <PageHero slot="hero" image="hero" words="destinations" compact>
    <Words page="destinations" field="heroLead" as="p" class="mt-4 max-w-2xl text-lg text-white/85" />
  </PageHero>
  <div class="wrap section">
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3 2xl:grid-cols-4" data-reveal-stagger>
      {DESTINATIONS.map((d) => <DestinationTile d={d} variant="card" />)}
    </div>
    <section class="mt-16" aria-labelledby="dest-gallery">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div><Words page="destinations" field="galleryEyebrow" as="p" class="eyebrow" /><Words page="destinations" field="galleryTitle" as="h2" id="dest-gallery" class="mt-2 text-3xl font-extrabold sm:text-[2.5rem] sm:leading-[1.1]" /></div>
        <Words page="destinations" field="galleryLink" as="a" href="/gallery/" class="font-semibold text-lime-text no-underline hover:text-ink" />
      </div>
      <div class="mt-8"><PhotoMarquee items={GALLERY.filter((g) => g.category !== 'Our cars')} /></div>
    </section>
    <BookCta waText="Hi, I am planning a trip and would like some advice." words="destinations:ctaTitle" image="tsomgo" />
  </div>
</BaseLayout>
