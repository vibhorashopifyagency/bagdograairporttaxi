---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import FaqList from '../../components/FaqList.astro';
import BookCta from '../../components/BookCta.astro';
import RouteCard from '../../components/RouteCard.astro';
import PackageCard from '../../components/PackageCard.astro';
import Icon from '../../components/Icon.astro';
import { DESTINATIONS, type Destination } from '../../data/destinations';
import { ROUTES } from '../../data/routes';
import { PACKAGES } from '../../data/packages';
import { SITE } from '../../data/site';
import { destinationPhoto } from '../../lib/photos';
import { article, faqPage, touristDestination } from '../../lib/schema';
import { photoFile } from '../../data/photo-library';
import Words from '../../components/Words.astro';
import { destinationVars, wordsText } from '../../data/page-text';

export function getStaticPaths() {
  return DESTINATIONS.map((d) => ({ params: { slug: d.slug }, props: { d } }));
}
const { d } = Astro.props as { d: Destination };
const path = `/destinations/${d.slug}/`;
const routes = ROUTES.filter((r) => r.destination === d.slug);
const packages = PACKAGES.filter((p) => p.destinations.includes(d.slug));
// The fixed words are "Every destination page" in the dashboard (src/data/page-text.ts), with this place's name as a fill-in.
const vars = destinationVars(d);
const w = (field: string) => wordsText('destination-page', field, vars);
const faqs = [
  { q: w('bestQ'), a: d.bestTime },
  { q: w('daysQ'), a: `${d.daysNeeded}. ${d.faqs[0]?.q.toLowerCase().includes('days') ? '' : w('daysExtra')}`.trim() },
  { q: w('reachQ'), a: d.howToReach },
  ...d.faqs,
];
const desc = w('seoDescription');
---

<BaseLayout
  title={w('seoTitle')}
  description={desc}
  crumbs={[{ name: 'Destinations', path: '/destinations/' }, { name: d.name, path }]}
  schema={[touristDestination(d, path), article({ headline: w('heroTitle'), description: desc, path, modified: SITE.destinationsUpdated, image: photoFile(destinationPhoto(d), 1600) }), faqPage(faqs, path)]}
  ogType="article"
  ogImage={photoFile(destinationPhoto(d), 1600)}
>
  <PageHero slot="hero" image={destinationPhoto(d)} edit={`destination:${d.slug}`} words="destination-page" vars={vars}>
    <div class="mt-5 flex flex-wrap gap-2">
      <span class="chip-light"><Icon name="clock" class="h-4 w-4" /> {d.daysNeeded}</span>
      <span class="chip-light"><Icon name="map" class="h-4 w-4" /> {d.howToReach.split('.')[0]}</span>
    </div>
  </PageHero>

  <article class="wrap mt-10 grid grid-cols-1 gap-10 lg:grid-cols-[minmax(0,1fr)_340px] lg:gap-14">
    <div class="min-w-0">
      <p class="answer" data-edit={`destination:${d.slug}:summary`}>{d.summary}</p>
      <dl class="mt-6 grid gap-3 sm:grid-cols-2">
        <div class="card p-5"><Words page="destination-page" field="bestTimeLabel" vars={vars} as="dt" class="text-xs font-semibold tracking-wide text-muted uppercase" /><dd class="mt-1.5 text-ink" data-edit={`destination:${d.slug}:bestTime`}>{d.bestTime}</dd></div>
        <div class="card p-5"><Words page="destination-page" field="daysLabel" vars={vars} as="dt" class="text-xs font-semibold tracking-wide text-muted uppercase" /><dd class="mt-1.5 text-ink" data-edit={`destination:${d.slug}:daysNeeded`}>{d.daysNeeded}</dd></div>
      </dl>

      <Words page="destination-page" field="highlightsTitle" vars={vars} as="h2" class="mt-12 text-2xl font-extrabold sm:text-3xl" />
      <ol class="mt-5 grid gap-3 sm:grid-cols-2" data-edit={`destination:${d.slug}:highlights`}>
        {d.highlights.map((h, i) => (
          <li class="card flex gap-4 p-5">
            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-lime font-[family-name:var(--font-display)] text-sm font-extrabold text-ink">{i + 1}</span>
            <span><strong class="block text-ink">{h.name}</strong><span class="mt-0.5 block text-sm leading-relaxed">{h.note}</span></span>
          </li>
        ))}
      </ol>

      <div class="prose-site mt-6">
        <Words page="destination-page" field="reachTitle" vars={vars} as="h2" />
        <p data-edit={`destination:${d.slug}:howToReach`}>{d.howToReach}</p>
        {d.permit && (<><Words page="destination-page" field="permitTitle" vars={vars} as="h2" /><p><span data-edit={`destination:${d.slug}:permit`}>{d.permit}</span> <Words page="destination-page" field="permitLink" vars={vars} /></p></>)}
      </div>

      <FaqList faqs={faqs} edit={`destination:${d.slug}:faqs`} />
    </div>

    <aside class="space-y-5 lg:sticky lg:top-24 lg:self-start">
      {routes.length > 0 && (
        <section class="card p-5" aria-labelledby="tx-h">
          <Words page="destination-page" field="taxiTitle" vars={vars} as="h2" id="tx-h" class="text-lg font-bold" />
          <div class="mt-4 grid gap-3">{routes.map((r) => <RouteCard route={r} compact />)}</div>
        </section>
      )}
      <a href="/book/" class="btn-book w-full"><Words page="destination-page" field="bookButton" vars={vars} /> <Icon name="arrow" /></a>
    </aside>
  </article>

  <div class="wrap">
    {packages.length > 0 && (
      <section class="mt-16" aria-labelledby="pk-h">
        <Words page="destination-page" field="packagesTitle" vars={vars} as="h2" id="pk-h" class="mb-6 text-2xl font-extrabold sm:text-3xl" />
        <div class="grid gap-5 md:grid-cols-3">{packages.slice(0, 3).map((p) => <PackageCard pkg={p} />)}</div>
      </section>
    )}
    <BookCta waText={`Hi, I am planning a trip to ${d.name}.`} words="destination-page:ctaTitle" vars={vars} image={destinationPhoto(d)} />
  </div>
</BaseLayout>
