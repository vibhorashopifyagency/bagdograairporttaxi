---
import BaseLayout from '../layouts/BaseLayout.astro';
import FaqList from '../components/FaqList.astro';
import BookCta from '../components/BookCta.astro';
import { GENERAL_FAQS } from '../data/faqs';
import { faqPage } from '../lib/schema';
import Words from '../components/Words.astro';
import { editAttr, words, wordsText } from '../data/page-text';
---

<BaseLayout
  title={wordsText('faq', 'seoTitle')}
  description={wordsText('faq', 'seoDescription')}
  crumbs={[{ name: 'FAQ', path: '/faq/' }]}
  schema={[faqPage(GENERAL_FAQS, '/faq/')]}
>
  <div class="wrap mt-6 max-w-3xl">
    <Words page="faq" field="title" as="h1" class="text-3xl font-extrabold sm:text-4xl" />
    <FaqList faqs={GENERAL_FAQS} heading={words('faq', 'listTitle')} headingEdit={editAttr('faq', 'listTitle')} edit="faq:main:list" />
    <BookCta />
  </div>
</BaseLayout>
