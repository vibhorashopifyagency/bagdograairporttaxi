---
import BaseLayout from '../layouts/BaseLayout.astro';
import RouteCard from '../components/RouteCard.astro';
import { ROUTES } from '../data/routes';
import Words from '../components/Words.astro';
import { wordsText } from '../data/page-text';
---

<!-- Served with a real 404 status by the host and marked noindex, so it can
     never be indexed with the homepage title as the old /404.php was. -->
<BaseLayout title={wordsText('not-found', 'seoTitle')} description={wordsText('not-found', 'seoDescription')} noindex>
  <div class="wrap mt-12 text-center">
    <Words page="not-found" field="eyebrow" as="p" class="eyebrow" />
    <Words page="not-found" field="title" as="h1" class="mt-2 text-4xl font-extrabold" />
    <Words page="not-found" field="text" as="p" class="mx-auto mt-4 max-w-xl text-lg" />
    <div class="mt-8 grid gap-3 text-left sm:grid-cols-2 lg:grid-cols-4">{ROUTES.slice(0, 4).map((r) => <RouteCard route={r} />)}</div>
    <Words page="not-found" field="button" as="a" class="btn-book mt-8" href="/" />
  </div>
</BaseLayout>
