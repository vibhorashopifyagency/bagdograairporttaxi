---
import BaseLayout from '../layouts/BaseLayout.astro';
import Words from '../components/Words.astro';
import { editAttr, wordsList, wordsText } from '../data/page-text';
// The words are "Cancellation and refund policy" in the dashboard's Edit pages (src/data/page-text.ts); the numbers are fill-ins from the policies.
const rows = ['row1', 'row2', 'row3'];
---

<BaseLayout
  title={wordsText('cancellation', 'seoTitle')}
  description={wordsText('cancellation', 'seoDescription')}
  crumbs={[{ name: 'Cancellation and refund policy', path: '/cancellation-refund-policy/' }]}
>
  <div class="wrap mt-6">
    <div class="prose-site">
      <Words page="cancellation" field="title" as="h1" class="text-3xl font-extrabold sm:text-4xl" />
      <Words page="cancellation" field="answer" as="p" class="answer mt-5" />
      <Words page="cancellation" field="taxiTitle" as="h2" />
      <div class="table-scroll">
        <table>
          <thead><tr><Words page="cancellation" field="tableWhen" as="th" /><Words page="cancellation" field="tableRefund" as="th" /></tr></thead>
          <tbody>
            {rows.map((r) => <tr><Words page="cancellation" field={`${r}When`} as="td" /><Words page="cancellation" field={`${r}Refund`} as="td" /></tr>)}
          </tbody>
        </table>
      </div>
      <Words page="cancellation" field="delayTitle" as="h2" />
      <Words page="cancellation" field="delayText" as="p" />
      <Words page="cancellation" field="weCancelTitle" as="h2" />
      <Words page="cancellation" field="weCancelText" as="p" />
      <Words page="cancellation" field="toursTitle" as="h2" />
      <ul data-edit={editAttr('cancellation', 'tours')}>
        {wordsList('cancellation', 'tours').map((t) => <li set:html={t} />)}
      </ul>
      <Words page="cancellation" field="howTitle" as="h2" />
      <Words page="cancellation" field="howText" as="p" />
      <Words page="cancellation" field="effective" as="p" class="text-sm text-muted" />
    </div>
  </div>
</BaseLayout>
