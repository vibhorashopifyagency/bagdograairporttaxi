---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import GalleryGrid from '../../components/GalleryGrid.astro';
import BookCta from '../../components/BookCta.astro';
import Icon from '../../components/Icon.astro';
import { GALLERY, GALLERY_CATEGORIES } from '../../data/gallery';
import { PHOTOS } from '../../lib/photos';
import { SITE, waLink } from '../../data/site';
import { abs } from '../../lib/schema';

const title = 'Photo Gallery: Darjeeling, Sikkim, Dooars and Our Cars';
const description = `${GALLERY.length} photographs of the places we drive to from Bagdogra Airport: Darjeeling, Gangtok, Tsomgo Lake, Nathula, Pelling, North Sikkim, the Dooars and Bhutan, plus our cars.`;
const gallery = {
  '@type': 'ImageGallery',
  '@id': abs('/gallery/#gallery'),
  name: 'Photo gallery',
  url: abs('/gallery/'),
  description,
  image: GALLERY.map((g) => ({
    '@type': 'ImageObject',
    contentUrl: abs(`/img/${g.photo}-1600.webp`),
    name: `${g.title}, ${g.place}`,
    description: PHOTOS[g.photo].alt,
    creditText: PHOTOS[g.photo].artist,
    license: PHOTOS[g.photo].licenseUrl || undefined,
    acquireLicensePage: PHOTOS[g.photo].source || undefined,
  })),
};
---

<BaseLayout title={title} description={description} crumbs={[{ name: 'Gallery', path: '/gallery/' }]} schema={[gallery]} ogImage="/img/north-sikkim-1600.webp">
  <PageHero slot="hero" image="north-sikkim" eyebrow={`${GALLERY.length} photographs · ${GALLERY_CATEGORIES.length} regions`} title="The roads we drive, in pictures" compact>
    <p class="mt-4 max-w-2xl text-lg text-white/85">Where a taxi from Bagdogra Airport can take you. Open any photo for the place, the fare and the trip it belongs to.</p>
  </PageHero>

  <div class="wrap section">
    <GalleryGrid items={GALLERY} filters />

    <div class="mt-12 grid gap-4 md:grid-cols-2" data-reveal>
      <div class="card p-6">
        <h2 class="text-xl font-bold">Travelled with us? Send your photos</h2>
        <p class="mt-2 leading-relaxed">We would love to show real trips here: your car, your driver, the view you stopped for. Send a few pictures on WhatsApp and we will add them with your name, or without, as you prefer.</p>
        <a href={waLink('Hi, I travelled with you and would like to share some photos for your gallery.')} rel="noopener" class="btn-wa mt-5"><Icon name="whatsapp" /> Share photos on WhatsApp</a>
      </div>
      <div class="card p-6">
        <h2 class="text-xl font-bold">About these photographs</h2>
        <p class="mt-2 leading-relaxed">The landscape pictures are by photographers who published them under open licences, credited on our <a href="/photo-credits/">photo credits page</a> with links to the originals. Car photos show the models we run; the exact car you get is confirmed with your driver's details the evening before.</p>
        <p class="mt-3 text-sm text-muted">Fares last updated {SITE.faresUpdatedLabel}.</p>
      </div>
    </div>

    <BookCta heading="Seen somewhere you want to go?" waText="Hi, I saw a place in your gallery and would like to plan a trip there." image="pelling" />
  </div>
</BaseLayout>
