---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import GalleryGrid from '../../components/GalleryGrid.astro';
import BookCta from '../../components/BookCta.astro';
import Icon from '../../components/Icon.astro';
import Words from '../../components/Words.astro';
import { wordsText } from '../../data/page-text';
import { GALLERY } from '../../data/gallery';
import { PHOTOS } from '../../lib/photos';
import { waLink } from '../../data/site';
import { abs } from '../../lib/schema';
import { photoFile } from '../../data/photo-library';

const title = wordsText('gallery', 'seoTitle');
const description = wordsText('gallery', 'seoDescription');
const gallery = {
  '@type': 'ImageGallery',
  '@id': abs('/gallery/#gallery'),
  name: 'Photo gallery',
  url: abs('/gallery/'),
  description,
  image: GALLERY.map((g) => ({
    '@type': 'ImageObject',
    contentUrl: abs(photoFile(g.photo, 1600)),
    name: `${g.title}, ${g.place}`,
    description: PHOTOS[g.photo].alt,
    creditText: PHOTOS[g.photo].artist,
    license: PHOTOS[g.photo].licenseUrl || undefined,
    acquireLicensePage: PHOTOS[g.photo].source || undefined,
  })),
};
---

<BaseLayout title={title} description={description} crumbs={[{ name: 'Gallery', path: '/gallery/' }]} schema={[gallery]} ogImage="/img/north-sikkim-1600.webp">
  <PageHero slot="hero" image="north-sikkim" words="gallery" compact>
    <Words page="gallery" field="heroLead" as="p" class="mt-4 max-w-2xl text-lg text-white/85" />
  </PageHero>

  <div class="wrap section">
    <GalleryGrid items={GALLERY} filters />

    <div class="mt-12 grid gap-4 md:grid-cols-2" data-reveal>
      <div class="card p-6">
        <Words page="gallery" field="shareTitle" as="h2" class="text-xl font-bold" />
        <Words page="gallery" field="shareText" as="p" class="mt-2 leading-relaxed" />
        <a href={waLink(wordsText('whatsapp', 'galleryShare'))} rel="noopener" class="btn-wa mt-5"><Icon name="whatsapp" /> <Words page="gallery" field="shareButton" /></a>
      </div>
      <div class="card p-6">
        <Words page="gallery" field="aboutTitle" as="h2" class="text-xl font-bold" />
        <Words page="gallery" field="aboutText" as="p" class="mt-2 leading-relaxed" />
        <Words page="gallery" field="aboutDate" as="p" class="mt-3 text-sm text-muted" />
      </div>
    </div>

    <BookCta words="gallery:ctaTitle" waText={wordsText('whatsapp', 'gallery')} image="pelling" />
  </div>
</BaseLayout>
