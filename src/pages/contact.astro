---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { BUSINESS, ORG_ID, SITE, waLink } from '../data/site';
const contact = { '@type': 'ContactPage', name: `Contact ${SITE.name}`, url: `${SITE.url}/contact/`, about: { '@id': ORG_ID } };
---

<BaseLayout
  title="Contact Bagdogra Airport Taxi: Call or WhatsApp 24 Hours"
  description={`Call or WhatsApp ${BUSINESS.phone}, 24 hours a day, to book a taxi or tour from Bagdogra Airport, NJP or Siliguri. Office at ${BUSINESS.address.locality}.`}
  crumbs={[{ name: 'Contact', path: '/contact/' }]}
  schema={[contact]}
>
  <PageHero slot="hero" image="airport" eyebrow={BUSINESS.hours} title="Contact us, day or night" compact />
  <div class="wrap section">
    <p class="answer max-w-3xl">The quickest way to reach us is WhatsApp on {BUSINESS.phone}. The same number takes calls 24 hours a day, every day of the year.</p>
    <div class="mt-10 grid gap-4 md:grid-cols-3">
      <a href={waLink('Hi, I have a question about a booking.')} rel="noopener" class="card lift flex flex-col gap-3 p-6 no-underline">
        <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-wa/10 text-wa"><Icon name="whatsapp" class="h-6 w-6" /></span><strong class="text-lg text-ink">WhatsApp</strong><span>{BUSINESS.phone}</span>
      </a>
      <a href={BUSINESS.phoneHref} class="card lift flex flex-col gap-3 p-6 no-underline">
        <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-lime-50 text-lime-text"><Icon name="phone" class="h-6 w-6" /></span><strong class="text-lg text-ink">Call</strong><span>{BUSINESS.phone}</span>
      </a>
      <a href={`mailto:${BUSINESS.email}`} class="card lift flex flex-col gap-3 p-6 no-underline">
        <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-lime-50 text-lime-text"><Icon name="card" class="h-6 w-6" /></span><strong class="text-lg text-ink">Email</strong><span class="break-all">{BUSINESS.email}</span>
      </a>
    </div>
    <section class="card mt-8 grid gap-6 p-6 sm:p-8 md:grid-cols-2" aria-labelledby="office-h">
      <div>
        <h2 id="office-h" class="text-xl font-bold">Our office</h2>
        <address class="mt-3 not-italic leading-relaxed">
          {SITE.name}<br />{BUSINESS.address.street}, {BUSINESS.address.locality}<br />
          {BUSINESS.address.district}, {BUSINESS.address.region} {BUSINESS.address.postalCode}, India
        </address>
        <p class="mt-2 text-muted">{BUSINESS.hours}</p>
        <a href={BUSINESS.mapsUrl} rel="noopener" class="btn-ghost mt-5"><Icon name="map" class="h-4 w-4 text-lime-text" /> Open in Google Maps</a>
      </div>
      <div class="rounded-2xl bg-cream p-5 text-sm leading-relaxed">
        <strong class="text-ink">Landing soon?</strong> Message us your flight number on WhatsApp. We track it and your driver is at arrivals with a name board, even if you are late.
      </div>
    </section>
  </div>
</BaseLayout>
