---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import Words from '../components/Words.astro';
import { wordsText } from '../data/page-text';
import { BUSINESS, ORG_ID, SITE, waLink } from '../data/site';
const contact = { '@type': 'ContactPage', name: `Contact ${SITE.name}`, url: `${SITE.url}/contact/`, about: { '@id': ORG_ID } };
---

<BaseLayout
  title={wordsText('contact', 'seoTitle')}
  description={wordsText('contact', 'seoDescription')}
  crumbs={[{ name: 'Contact', path: '/contact/' }]}
  schema={[contact]}
>
  <PageHero slot="hero" image="airport" eyebrow={BUSINESS.hours} words="contact" compact />
  <div class="wrap section">
    <Words page="contact" field="answer" as="p" class="answer max-w-3xl" />
    <div class="mt-10 grid gap-4 md:grid-cols-3">
      <a href={waLink(wordsText('whatsapp', 'contact'))} rel="noopener" class="card lift flex flex-col gap-3 p-6 no-underline">
        <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-wa/10 text-wa"><Icon name="whatsapp" class="h-6 w-6" /></span><Words page="contact" field="cardWhatsapp" as="strong" class="text-lg text-ink" /><span>{BUSINESS.phone}</span>
      </a>
      <a href={BUSINESS.phoneHref} class="card lift flex flex-col gap-3 p-6 no-underline">
        <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-lime-50 text-lime-text"><Icon name="phone" class="h-6 w-6" /></span><Words page="contact" field="cardCall" as="strong" class="text-lg text-ink" /><span>{BUSINESS.phone}</span>
      </a>
      <a href={`mailto:${BUSINESS.email}`} class="card lift flex flex-col gap-3 p-6 no-underline">
        <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-lime-50 text-lime-text"><Icon name="card" class="h-6 w-6" /></span><Words page="contact" field="cardEmail" as="strong" class="text-lg text-ink" /><span class="break-all">{BUSINESS.email}</span>
      </a>
    </div>
    <section class="card mt-8 grid gap-6 p-6 sm:p-8 md:grid-cols-2" aria-labelledby="office-h">
      <div>
        <Words page="contact" field="officeTitle" as="h2" id="office-h" class="text-xl font-bold" />
        <address class="mt-3 not-italic leading-relaxed">
          {SITE.name}<br />{BUSINESS.address.street}, {BUSINESS.address.locality}<br />
          {BUSINESS.address.district}, {BUSINESS.address.region} {BUSINESS.address.postalCode}, India
        </address>
        <p class="mt-2 text-muted">{BUSINESS.hours}</p>
        <a href={BUSINESS.mapsUrl} rel="noopener" class="btn-ghost mt-5"><Icon name="map" class="h-4 w-4 text-lime-text" /> <Words page="contact" field="mapsButton" /></a>
      </div>
      <Words page="contact" field="landingNote" as="div" strong="text-ink" class="rounded-2xl bg-cream p-5 text-sm leading-relaxed" />
    </section>
  </div>
</BaseLayout>
