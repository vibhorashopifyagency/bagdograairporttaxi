---
import GoogleRatingBadge from '../../components/GoogleRatingBadge.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import DatePicker from '../../components/DatePicker.astro';
import TimePicker from '../../components/TimePicker.astro';
import { ROUTES, ROUTE_GROUPS } from '../../data/routes';
import { PACKAGES } from '../../data/packages';
import { VEHICLES } from '../../data/vehicles';
import Words from '../../components/Words.astro';
import { BUSINESS, POLICY } from '../../data/site';
import { wordsText } from '../../data/page-text';

// Every word on this page is "Booking form" in the dashboard (src/data/page-text.ts).
// The ones the script writes go to it as text, with the amounts it works out
// ({amount}, {total}, {ref}...) still in brackets for it to fill.
const SCRIPT_WORDS = [
  'fareLabel', 'fareLabelPackage', 'baseLabel', 'baseLabelPackage', 'nightLabel', 'nightLabelPackage', 'balanceLabel', 'balanceLabelPackage',
  'packageFrom', 'packageNote', 'payNote', 'payNotePackage', 'missing', 'missingDate', 'missingTime', 'missingName', 'missingPhone',
  'badPhone', 'payRest', 'payPays', 'payCopy', 'payCopied', 'payApp', 'paySend', 'payConfirm', 'waIntro', 'waPaid',
] as const;
const w = (field: string) => wordsText('book', field);

// Only what the script needs, so the inline payload stays a few kB.
const data = {
  routes: Object.fromEntries(ROUTES.map((r) => [r.slug, { name: `${r.from} to ${r.to}`, fares: r.fares }])),
  packages: Object.fromEntries(PACKAGES.map((p) => [p.slug, { name: `${p.name} (${p.nights}N/${p.days}D)`, fromPrice: p.fromPrice, priceNote: p.priceNote }])),
  vehicles: Object.fromEntries(VEHICLES.map((v) => [v.key, v.name])),
  policy: POLICY,
  whatsapp: BUSINESS.whatsapp,
  words: Object.fromEntries(SCRIPT_WORDS.map((k) => [k, w(k)])),
};
/** An empty element the script fills in, standing where a fill-in is in the words. */
const slot = (html: string) => ({ text: '', html });
/** The calendar check: cars every one of the office's own is booked for at the chosen time (src/lib/car-availability.ts). */
const carCheck = {
  whatsapp: BUSINESS.whatsapp,
  vehicles: data.vehicles,
  seats: Object.fromEntries(VEHICLES.map((v) => [v.key, v.seats])),
  words: Object.fromEntries((['carFull', 'carAsk', 'carFullNote', 'allFull', 'carFullWa'] as const).map((k) => [k, w(k)])),
};
---

<BaseLayout
  welcome={false}
  actionBar={false}
  title={w('seoTitle')}
  description={w('seoDescription')}
  crumbs={[{ name: 'Book a taxi', path: '/book/' }]}
>
  <div class="wrap mt-6 grid grid-cols-1 gap-8 lg:grid-cols-[minmax(0,1fr)_380px]">
    <div>
      <Words page="book" field="title" as="h1" class="text-3xl font-extrabold sm:text-4xl" />
      <Words page="book" field="lead" as="p" class="mt-2 text-muted" />
      <GoogleRatingBadge variant="chip" class="mt-4" />

      {/*
        Only what a booking needs is in view: trip, car, date and time, name
        and mobile. Flight, hotel and passengers fold away under one line,
        and on a phone the fare bar at the bottom keeps the button in reach.
      */}
      <form id="book" class="mt-6 space-y-6" novalidate>
        <div class="space-y-4">
          <div class="flex flex-wrap gap-2" role="radiogroup" aria-label="Trip type">
            <label class="chip"><input type="radio" name="kind" value="taxi" checked class="sr-only" /><Words page="book" field="kindTaxi" /></label>
            <label class="chip"><input type="radio" name="kind" value="package" class="sr-only" /><Words page="book" field="kindPackage" /></label>
          </div>
          <label class="field" data-for="taxi">
            <Words page="book" field="routeLabel" />
            <select name="route" required>
              {ROUTE_GROUPS.map((g) => (
                <optgroup label={g}>
                  {ROUTES.filter((r) => r.group === g).map((r) => <option value={r.slug}>{r.from} to {r.to}</option>)}
                </optgroup>
              ))}
            </select>
          </label>
          <label class="field" data-for="package" hidden>
            <Words page="book" field="packageLabel" />
            <select name="package">
              {PACKAGES.map((p) => <option value={p.slug}>{p.name} ({p.nights}N/{p.days}D)</option>)}
            </select>
          </label>
        </div>

        <fieldset>
          <Words page="book" field="carLabel" as="legend" class="mb-2 text-[0.95rem] font-semibold text-ink" />
          <div class="grid grid-cols-2 gap-2.5 sm:gap-3 xl:grid-cols-4">
            {VEHICLES.map((v, i) => (
              <label class="vehicle">
                <input type="radio" name="vehicle" value={v.key} checked={i === 0} class="sr-only" />
                <span class="v-dot" aria-hidden="true"><Icon name="check" class="h-3.5 w-3.5" /></span>
                <strong class="pr-7 text-ink">{v.name}</strong>
                <span class="text-xs leading-snug text-muted"><Words page="book" field="seats" each={{ seats: { text: String(v.seats) } }} /> · {v.models}</span>
                <span class="mt-auto pt-1 text-lg font-bold text-ink" data-price={v.key}></span>
              </label>
            ))}
          </div>
        </fieldset>

        <div class="grid items-end gap-4 sm:grid-cols-2">
          <DatePicker name="date" label={w('dateLabel')} />
          <TimePicker name="time" label={w('timeLabel')} nightFrom={POLICY.nightChargeFrom} nightTo={POLICY.nightChargeTo} nightTag={w('nightTag')} />
        </div>

        <div class="grid items-end gap-4 sm:grid-cols-2">
          <label class="field"><Words page="book" field="nameLabel" /><input name="name" required autocomplete="name" autocapitalize="words" /></label>
          <label class="field">
            <Words page="book" field="phoneLabel" />
            {/* +91 is shown, not sent: the server adds it to a 10-digit number. It hides once a number starts with + or 0. */}
            <span class="tel"><span class="tel-cc" aria-hidden="true">+91</span><input name="phone" type="tel" required autocomplete="tel" inputmode="tel" placeholder={w('phoneHint')} /></span>
          </label>
        </div>

        <details class="more" id="more">
          <summary>
            <span><Words page="book" field="moreToggle" /> <Words page="book" field="optional" as="em" class="font-normal text-muted" /></span>
            <Icon name="down" class="more-chev h-5 w-5 shrink-0" />
          </summary>
          <div class="grid gap-4 pt-4 sm:grid-cols-2">
            <label class="field"><Words page="book" field="flightLabel" /><input name="flight" placeholder={w('flightHint')} autocomplete="off" /></label>
            <label class="field"><Words page="book" field="paxLabel" /><input type="number" name="pax" min="1" max="12" value="2" inputmode="numeric" /></label>
            <label class="field sm:col-span-2"><Words page="book" field="dropLabel" /><input name="drop" placeholder={w('dropHint')} /></label>
          </div>
        </details>
        <div class="hp" aria-hidden="true">
          <label>Leave this empty<input name="website" tabindex="-1" autocomplete="off" /></label>
        </div>
        {/* Each problem shows under its own field; this reads them out in one line. */}
        <p id="err" class="sr-only" role="alert"></p>
      </form>
    </div>

    <aside class="lg:sticky lg:top-24 lg:self-start">
      <div class="ring-shell">
      <div class="card overflow-hidden">
        <div class="bg-ink p-5 text-white">
          <p class="text-sm text-white/70" id="fare-label">{w('fareLabel')}</p>
          <p class="text-4xl font-extrabold" id="total" aria-live="polite">–</p>
          <p class="text-sm text-white/70" id="trip-name"></p>
          <p class="mt-1 text-xs text-white/60" id="fare-note" hidden></p>
        </div>
        <dl class="space-y-2 p-5 text-sm">
          <div class="flex justify-between"><dt id="base-label">{w('baseLabel')}</dt><dd id="base" class="font-semibold text-ink">–</dd></div>
          <div class="flex justify-between"><dt id="night-label">{w('nightLabel')}</dt><dd id="night" class="font-semibold text-ink">₹0</dd></div>
          <div class="flex justify-between border-t border-line pt-2"><dt><Words page="book" field="advanceLabel" as="strong" class="text-ink" /></dt><dd id="adv" class="font-bold text-ink">–</dd></div>
          <div class="flex justify-between"><dt id="bal-label">{w('balanceLabel')}</dt><dd id="bal">–</dd></div>
        </dl>
        <div class="space-y-3 px-5 pb-5">
          <button type="button" id="wa" class="btn-wa w-full"><Icon name="whatsapp" /> <Words page="book" field="waButton" /></button>
          <button type="button" id="pay" class="btn-book w-full"><Icon name="shield" /> <Words page="book" field="payButton" /></button>
          <p class="text-xs text-muted" id="pay-note"></p>
          <Words page="book" field="privacy" as="p" class="text-xs text-muted" />
        </div>
        <ul class="space-y-2 border-t border-line bg-mist p-5 text-sm">
          <li class="flex gap-2"><Icon name="refund" class="h-5 w-5 shrink-0 text-lime-text" /><Words page="book" field="promise1" /></li>
          <li class="flex gap-2"><Icon name="clock" class="h-5 w-5 shrink-0 text-lime-text" /><Words page="book" field="promise2" /></li>
          <li class="flex gap-2"><Icon name="check" class="h-5 w-5 shrink-0 text-lime-text" /><Words page="book" field="promise3" /></li>
        </ul>
      </div>
      </div>
      <Words page="book" field="talk" as="p" class="mt-4 text-center text-sm" />
    </aside>
  </div>

  {/* On a phone the fare and the WhatsApp button stay at the bottom of the screen, until the fare box itself scrolls into view. */}
  <div id="bar" class="book-bar">
    <div class="min-w-0 flex-1">
      <p class="text-xl leading-tight font-extrabold text-ink" id="bar-total">–</p>
      <p class="truncate text-xs text-muted" id="bar-trip"></p>
    </div>
    <button type="button" id="bar-wa" class="btn-wa shrink-0 px-4"><Icon name="whatsapp" /> <Words page="book" field="waButton" /></button>
  </div>

  {/* Paying the advance first: the office UPI QR code, from /api/upi/ when the button is pressed. */}
  <dialog id="pay-dlg" class="pay-dlg" aria-labelledby="pay-title">
    <div class="pay-head">
      <Words page="book" field="payTitle" as="h2" id="pay-title" class="m-0 text-xl font-extrabold" />
      <button type="button" class="pay-x" data-pay-close aria-label="Close">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12" /></svg>
      </button>
    </div>
    <div class="pay-main">
      <div class="pay-amount">
        <Words page="book" field="payFor" class="text-sm text-white/70" vars={{ ref: slot('<strong class="font-mono text-white" data-pay-ref></strong>') }} />
        <strong class="text-4xl font-extrabold text-lime" data-pay-amt></strong>
        <span class="text-sm text-white/70" data-pay-rest></span>
      </div>

      <div data-pay-loading class="pay-note">{w('payLoading')}</div>
      <div data-pay-qr hidden class="pay-qr">
        {/* The QR picture and the UPI app link are made by the script once /api/upi/ answers. */}
        <div class="flex min-w-0 flex-col gap-1.5">
          <Words page="book" field="payScan" class="font-bold text-ink" />
          <Words page="book" field="payApps" class="text-sm text-body" />
          <span class="text-sm text-body" data-pay-payee></span>
          <span class="flex flex-wrap items-center gap-2 text-sm" data-pay-idrow hidden>
            <Words page="book" field="payId" class="text-muted" />
            <code class="pay-id" data-pay-id></code>
            <button type="button" class="pay-copy" data-pay-copy>{w('payCopy')}</button>
          </span>
        </div>
      </div>
      <Words page="book" field="payNone" as="p" data-pay-none hidden class="pay-note" />

      <ol class="pay-steps" data-pay-steps>
        <Words page="book" field="payStep1" as="li" vars={{ amount: slot('<strong data-pay-amt2></strong>'), ref: slot('<strong data-pay-ref2></strong>') }} />
        <Words page="book" field="payStep2" as="li" />
      </ol>
      <button type="button" class="btn-wa w-full" data-pay-wa><Icon name="whatsapp" /> <span data-pay-wa-label>{w('paySend')}</span></button>
      <Words page="book" field="payFoot" as="p" class="m-0 text-center text-xs text-muted" />
    </div>
  </dialog>

  <script type="application/json" id="book-data" set:html={JSON.stringify(data)} />
  <script>
    type Data = {
      routes: Record<string, { name: string; fares: Record<string, number> }>;
      packages: Record<string, { name: string; fromPrice: number; priceNote: string }>;
      vehicles: Record<string, string>;
      policy: { advancePercent: number; nightCharge: number; nightChargeFrom: string; nightChargeTo: string };
      whatsapp: string;
      words: Record<string, string>;
    };
    const d: Data = JSON.parse(document.getElementById('book-data')!.textContent!);
    const W = d.words;
    /** The page's words with what the script worked out written in: fill(W.payApp, { amount: '₹560' }). */
    const fill = (words: string, values: Record<string, string>) => words.replace(/\{([a-zA-Z][a-zA-Z0-9]*)\}/g, (all, k: string) => values[k] ?? all);
    const f = document.getElementById('book') as HTMLFormElement;
    const $ = (id: string) => document.getElementById(id)!;
    const inr = (n: number) => '₹' + n.toLocaleString('en-IN');
    const val = (n: string) => ((f.elements.namedItem(n) as HTMLInputElement | null)?.value ?? '').trim();
    const kind = () => (f.querySelector('input[name=kind]:checked') as HTMLInputElement).value;

    // Every request gets a short reference, shown in the WhatsApp message and
    // saved with the booking so the office can match the two. The same details
    // sent twice keep the same reference, so the server saves them once.
    const ALPHABET = 'ABCDEFGHJKMNPQRSTUVWXYZ23456789';
    const newRef = () => 'BAT-' + Array.from(crypto.getRandomValues(new Uint8Array(6)), (x) => ALPHABET[x % ALPHABET.length]).join('');
    let ref = newRef();
    let lastSent = '';
    function payload(channel: 'whatsapp' | 'payment') {
      const c = calc();
      const p = {
        kind: kind(), route: val('route'), package: val('package'), vehicle: c.vehicle,
        date: val('date'), time: val('time'), flight: val('flight'), pax: Math.max(1, parseInt(val('pax'), 10) || 1),
        drop: val('drop'), name: val('name'), phone: val('phone'),
        fareShown: c.total, advanceShown: c.adv, consent: true, website: val('website'),
      };
      const sig = JSON.stringify(p);
      if (lastSent && sig !== lastSent) ref = newRef();
      lastSent = sig;
      return { ...p, ref, channel };
    }
    // Save the booking without making the customer wait. If the network or
    // the server fails, keep it in this browser; BaseLayout retries it on the
    // next page view, and the server ignores a reference it already has.
    const PENDING = 'bat-pending-bookings';
    function keep(p: object) {
      try {
        const q = JSON.parse(localStorage.getItem(PENDING) || '[]');
        q.push({ ...p, savedAt: Date.now() });
        localStorage.setItem(PENDING, JSON.stringify(q.slice(-10)));
      } catch { /* private mode: nothing more we can do; WhatsApp still has it */ }
    }
    function save(p: object) {
      fetch('/api/bookings/', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(p), keepalive: true })
        .then((r) => { if (r.status >= 500 || r.status === 429) keep(p); })
        .catch(() => keep(p));
    }

    // Prefill from links such as /book/?route=…&vehicle=… or ?package=…
    const q = new URLSearchParams(location.search);
    if (q.get('route') && d.routes[q.get('route')!]) (f.elements.namedItem('route') as HTMLSelectElement).value = q.get('route')!;
    if (q.get('package') && d.packages[q.get('package')!]) {
      (f.querySelector('input[value=package]') as HTMLInputElement).checked = true;
      (f.elements.namedItem('package') as HTMLSelectElement).value = q.get('package')!;
    }
    if (q.get('vehicle')) {
      const v = f.querySelector(`input[name=vehicle][value="${CSS.escape(q.get('vehicle')!)}"]`) as HTMLInputElement | null;
      if (v) v.checked = true;
    }
    const isNight = (t: string) => {
      if (!t) return false;
      const { nightChargeFrom: a, nightChargeTo: b } = d.policy;
      return t >= a || t < b;
    };

    function calc() {
      const pkg = kind() === 'package';
      document.querySelectorAll<HTMLElement>('[data-for]').forEach((el) => (el.hidden = el.dataset.for !== (pkg ? 'package' : 'taxi')));
      const route = d.routes[val('route')];
      const vehicle = (f.querySelector('input[name=vehicle]:checked') as HTMLInputElement).value;
      document.querySelectorAll<HTMLElement>('[data-price]').forEach((el) => {
        el.textContent = pkg ? '' : inr(route.fares[el.dataset.price!]);
      });
      $('fare-label').textContent = pkg ? W.fareLabelPackage : W.fareLabel;
      $('base-label').textContent = pkg ? W.baseLabelPackage : W.baseLabel;
      $('night-label').textContent = pkg ? W.nightLabelPackage : W.nightLabel;
      $('bal-label').textContent = pkg ? W.balanceLabelPackage : W.balanceLabel;
      $('fare-note').hidden = !pkg;
      if (pkg) {
        // Packages are priced per person (two sharing), so the total is the
        // lowest season price times the party. The office confirms the final
        // figure on WhatsApp once season, hotels and group size are known.
        const p = d.packages[val('package')];
        const pax = Math.max(1, parseInt(val('pax'), 10) || 1);
        const total = p.fromPrice * pax;
        const adv = Math.round((total * d.policy.advancePercent) / 100);
        $('trip-name').textContent = `${p.name} · ${p.priceNote}`;
        $('fare-note').textContent = W.packageNote;
        $('total').textContent = fill(W.packageFrom, { amount: inr(p.fromPrice) });
        $('base').textContent = inr(p.fromPrice);
        $('night').textContent = `${pax} × ${inr(p.fromPrice)} = ${inr(total)}`;
        $('adv').textContent = fill(W.packageFrom, { amount: inr(adv) });
        $('bal').textContent = fill(W.packageFrom, { amount: inr(total - adv) });
        $('bar-total').textContent = $('total').textContent;
        $('bar-trip').textContent = p.name;
        return { route: null, vehicle, total, adv, pax, pkg: p };
      }
      const base = route.fares[vehicle];
      const night = isNight(val('time')) ? d.policy.nightCharge : 0;
      const total = base + night;
      const adv = Math.round((total * d.policy.advancePercent) / 100);
      $('trip-name').textContent = `${route.name} · ${d.vehicles[vehicle]}`;
      $('total').textContent = inr(total);
      $('base').textContent = inr(base);
      $('night').textContent = inr(night);
      $('adv').textContent = inr(adv);
      $('bal').textContent = inr(total - adv);
      $('bar-total').textContent = inr(total);
      $('bar-trip').textContent = `${d.vehicles[vehicle]} · ${route.name}`;
      return { route, vehicle, total, adv, pax: 0, pkg: null };
    }

    // What a booking cannot go without, in the order the form shows it.
    const REQUIRED = ['date', 'time', 'name', 'phone'];
    const NAMES: Record<string, string> = { date: W.missingDate, time: W.missingTime, name: W.missingName, phone: W.missingPhone };
    /** A number the server can read (normalizePhone in src/server/bookings.ts): 10 digits, or up to 15 with the country code. */
    const phoneOk = (raw: string) => {
      const n = raw.replace(/\D/g, '').replace(/^00/, '');
      return n.length >= 10 && n.length <= 15;
    };
    /** What is wrong with a field, in the words shown under it; '' when nothing is. */
    function problem(n: string) {
      if (!val(n)) return fill(W.missing, { missing: NAMES[n] });
      return n === 'phone' && !phoneOk(val(n)) ? W.badPhone : '';
    }
    /** What the customer fixes: date and time live in hidden inputs, so their picker buttons stand in. */
    function control(n: string) {
      const el = f.elements.namedItem(n) as HTMLElement;
      return el.closest('[data-picker]')?.querySelector<HTMLElement>('.pk-trigger') ?? el;
    }
    /** Shows a problem under its field, or takes it away when `text` is ''. */
    function mark(n: string, text: string) {
      const el = control(n);
      const box = el.closest<HTMLElement>('[data-picker], .field')!;
      let note = box.querySelector<HTMLElement>('.field-err');
      box.classList.toggle('is-bad', !!text);
      if (!text) {
        note?.remove();
        el.removeAttribute('aria-invalid');
        el.removeAttribute('aria-describedby');
        return;
      }
      if (!note) {
        // Inside the label but kept out of its name: the field reads it as its description instead.
        note = Object.assign(document.createElement('span'), { className: 'field-err', id: `${n}-err` });
        note.setAttribute('aria-hidden', 'true');
        box.append(note);
      }
      note.textContent = text;
      el.setAttribute('aria-invalid', 'true');
      el.setAttribute('aria-describedby', note.id);
    }

    /** The problems still showing, in one line for screen readers. */
    function summarize() {
      const bad = REQUIRED.filter((n) => control(n).hasAttribute('aria-invalid'));
      const missing = bad.filter((n) => !val(n));
      $('err').textContent = [missing.length && fill(W.missing, { missing: missing.map((n) => NAMES[n]).join(', ') }), bad.includes('phone') && val('phone') && W.badPhone].filter(Boolean).join(' ');
    }

    function check() {
      const bad = REQUIRED.filter((n) => problem(n));
      REQUIRED.forEach((n) => mark(n, problem(n)));
      summarize();
      if (!bad.length) return true;
      const first = control(bad[0]);
      first.scrollIntoView({ block: 'center' });
      first.focus({ preventScroll: true });
      return false;
    }
    // A problem goes as soon as it is fixed; new ones show only on the next press of a button.
    f.addEventListener('input', (e) => {
      const n = (e.target as HTMLInputElement).name;
      if (!REQUIRED.includes(n) || !control(n).hasAttribute('aria-invalid') || problem(n)) return;
      mark(n, '');
      summarize();
    });

    function message() {
      const c = calc();
      const lines = c.pkg
        ? [`Tour package: ${c.pkg.name}`, `Car: ${d.vehicles[c.vehicle]}`, `Price shown: from ${inr(c.pkg.fromPrice)} ${c.pkg.priceNote} · ${c.pax} travellers from ${inr(c.total)} (advance ${inr(c.adv)})`]
        : [`Route: ${c.route!.name}`, `Car: ${d.vehicles[c.vehicle]}`, `Fare shown: ${inr(c.total)} (advance ${inr(c.adv)})`];
      return [
        W.waIntro,
        `Booking ref: ${ref}`,
        ...lines,
        `Date: ${val('date')} at ${val('time')}`,
        val('flight') && `Flight/train: ${val('flight')}`,
        `Passengers: ${val('pax')}`,
        val('drop') && `Drop: ${val('drop')}`,
        `Name: ${val('name')}`,
        `Mobile: ${val('phone')}`,
      ].filter(Boolean).join('\n');
    }

    f.addEventListener('input', calc);
    f.addEventListener('change', calc);
    function sendWhatsApp() {
      if (!check()) return;
      const p = payload('whatsapp');
      // Opened first and in the same click, or the browser blocks the window.
      window.open(`https://wa.me/${d.whatsapp}?text=${encodeURIComponent(message())}`, '_blank', 'noopener');
      save(p);
    }
    $('wa').addEventListener('click', sendWhatsApp);
    $('bar-wa').addEventListener('click', sendWhatsApp);

    // A tour package is priced by the number of travellers, so choosing one unfolds the passengers box.
    const more = $('more') as HTMLDetailsElement;
    const unfoldForPackage = () => { if (kind() === 'package') more.open = true; };
    f.querySelectorAll('input[name=kind]').forEach((r) => r.addEventListener('change', unfoldForPackage));
    unfoldForPackage();

    // "+91" stands in the mobile box until the number brings its own country code or a leading 0.
    const phone = f.elements.namedItem('phone') as HTMLInputElement;
    const ownCode = () => phone.parentElement!.classList.toggle('is-intl', /^\s*[+0]/.test(phone.value));
    phone.addEventListener('input', ownCode);
    window.addEventListener('pageshow', ownCode);

    // The phone fare bar steps aside while the fare box's own buttons are on screen, and while the keyboard is up.
    const bar = $('bar');
    new IntersectionObserver(([e]) => bar.classList.toggle('is-away', e.isIntersecting), { rootMargin: '0px 0px -80px 0px' }).observe($('wa'));
    const typing = (t: EventTarget | null) => t instanceof HTMLElement && t.matches('input:not([type=radio]), select');
    f.addEventListener('focusin', (e) => bar.classList.toggle('is-typing', typing(e.target)));
    f.addEventListener('focusout', () => bar.classList.remove('is-typing'));
    // Paying the advance first. The booking is saved the moment the button is
    // pressed, then the office QR code shows with the amount. Tour packages are
    // priced "from", so their advance is asked for on WhatsApp once the office
    // confirms the final price.
    const dlg = $('pay-dlg') as HTMLDialogElement;
    const q1 = <T extends Element = HTMLElement>(sel: string) => dlg.querySelector<T>(sel)!;
    type Upi = { ok: boolean; payee: string; id: string; qr: { src: string; w: number; h: number } | null };
    let upi: Promise<Upi | null> | null = null;
    const loadUpi = () => (upi ??= fetch('/api/upi/').then((r) => (r.ok ? r.json() : null)).catch(() => null));
    const upiLink = (u: Upi, amount: number) =>
      `upi://pay?pa=${u.id}&pn=${encodeURIComponent(u.payee)}&cu=INR&am=${amount.toFixed(2)}&tn=${encodeURIComponent(`Booking ${ref}`)}`;

    function syncPayButton() {
      const pkg = kind() === 'package';
      ($('pay') as HTMLButtonElement).hidden = pkg;
      $('pay-note').textContent = pkg ? W.payNotePackage : W.payNote;
    }
    f.addEventListener('change', syncPayButton);
    syncPayButton();

    $('pay').addEventListener('click', async () => {
      if (!check()) return;
      const p = payload('payment');
      save(p);
      const c = calc();
      q1('[data-pay-ref]').textContent = ref;
      q1('[data-pay-ref2]').textContent = ref;
      q1('[data-pay-amt]').textContent = inr(c.adv);
      q1('[data-pay-amt2]').textContent = inr(c.adv);
      q1('[data-pay-rest]').textContent = fill(W.payRest, { total: inr(c.total), rest: inr(c.total - c.adv) });
      q1('[data-pay-loading]').hidden = false;
      q1('[data-pay-qr]').hidden = true;
      q1('[data-pay-none]').hidden = true;
      const oldApp = dlg.querySelector<HTMLElement>('[data-pay-app]');
      if (oldApp) oldApp.hidden = true;
      q1('[data-pay-steps]').hidden = false;
      q1('[data-pay-wa-label]').textContent = W.paySend;
      dlg.showModal();
      const u = await loadUpi();
      q1('[data-pay-loading]').hidden = true;
      if (!u?.qr) {
        // No QR code uploaded yet (or offline): the office sends it on WhatsApp.
        q1('[data-pay-none]').hidden = false;
        q1('[data-pay-steps]').hidden = true;
        q1('[data-pay-wa-label]').textContent = W.payConfirm;
        return;
      }
      const box = q1('[data-pay-qr]');
      const img = box.querySelector('img') ?? box.insertBefore(document.createElement('img'), box.firstChild);
      img.src = u.qr.src;
      img.width = u.qr.w;
      img.height = u.qr.h;
      img.alt = `UPI QR code of ${u.payee || 'Bagdogra Airport Taxi'}`;
      q1('[data-pay-payee]').textContent = u.payee ? fill(W.payPays, { payee: u.payee }) : '';
      q1('[data-pay-idrow]').hidden = !u.id;
      q1('[data-pay-id]').textContent = u.id;
      q1('[data-pay-qr]').hidden = false;
      if (u.id) {
        // On a phone the QR code cannot scan itself: this opens the UPI app with the amount filled in.
        let app = dlg.querySelector<HTMLAnchorElement>('[data-pay-app]');
        if (!app) {
          app = Object.assign(document.createElement('a'), { className: 'btn-book pay-app w-full' });
          app.dataset.payApp = '';
          box.after(app);
        }
        app.href = upiLink(u, c.adv);
        app.textContent = fill(W.payApp, { amount: inr(c.adv) });
        app.hidden = false;
      }
    });
    // Fetch the QR details as soon as someone shows interest, so the popup opens filled in.
    $('pay').addEventListener('pointerenter', () => void loadUpi(), { once: true });
    $('pay').addEventListener('focus', () => void loadUpi(), { once: true });
    q1('[data-pay-copy]').addEventListener('click', async (e) => {
      const btn = e.currentTarget as HTMLButtonElement;
      try {
        await navigator.clipboard.writeText(q1('[data-pay-id]').textContent ?? '');
        btn.textContent = W.payCopied;
      } catch {
        btn.textContent = 'Select and copy';
      }
      setTimeout(() => (btn.textContent = W.payCopy), 2000);
    });
    q1('[data-pay-wa]').addEventListener('click', () => {
      const paid = !q1('[data-pay-qr]').hidden;
      const c = calc();
      const text = paid ? `${message()}\n${fill(W.waPaid, { amount: inr(c.adv) })}` : message();
      // Opened first and in the same click, or the browser blocks the window.
      window.open(`https://wa.me/${d.whatsapp}?text=${encodeURIComponent(text)}`, '_blank', 'noopener');
      dlg.close();
    });
    q1('[data-pay-close]').addEventListener('click', () => dlg.close());
    dlg.addEventListener('click', (e) => {
      if (e.target === dlg) dlg.close();
    });
    calc();
  </script>

  <script type="application/json" id="car-check" set:html={JSON.stringify(carCheck)} />
  <script>
    import { watchAvailability, type AvailabilityWords } from '../../lib/car-availability';
    const c: { whatsapp: string; vehicles: Record<string, string>; seats: Record<string, number>; words: AvailabilityWords } = JSON.parse(document.getElementById('car-check')!.textContent!);
    const form = document.getElementById('book') as HTMLFormElement;
    watchAvailability(form, {
      ...c,
      tripName: () => {
        const pkg = form.querySelector<HTMLInputElement>('input[name=kind]:checked')?.value === 'package';
        return (form.elements.namedItem(pkg ? 'package' : 'route') as HTMLSelectElement).selectedOptions[0]?.textContent ?? '';
      },
    });
  </script>
</BaseLayout>

<style>
  .hp { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
  /* A fieldset never shrinks below its widest content by default, so a long route name pushed the select off a phone screen. */
  fieldset { min-width: 0; }
  .field[hidden] { display: none; }
  .field { display: flex; flex-direction: column; gap: 0.375rem; font-weight: 600; color: var(--color-ink); font-size: 0.95rem; }
  .field input, .field select {
    min-height: 3rem; border: 1px solid var(--color-line); border-radius: 0.75rem; padding: 0.625rem 0.875rem;
    font-weight: 400; font-size: 1rem; background: #fff; color: var(--color-ink);
  }
  .field input:focus, .field select:focus { border-color: var(--color-ink); outline: 2px solid var(--color-lime-100); }
  .chip span { display: inline-flex; min-height: 2.75rem; align-items: center; border-radius: 999px; border: 1px solid var(--color-line); padding: 0 1.1rem; font-weight: 600; cursor: pointer; }
  .chip input:checked + span { background: var(--color-ink); border-color: var(--color-ink); color: #fff; }
  .chip input:focus-visible + span { outline: 3px solid var(--color-lime); outline-offset: 2px; }
  /* The cars: two to a row on a phone, four on a wide screen, with a tick in the corner of the one chosen. */
  .vehicle {
    position: relative; display: flex; flex-direction: column; gap: 0.15rem; padding: 0.75rem 0.875rem; cursor: pointer;
    border: 1px solid var(--color-line); border-radius: 0.875rem; background: #fff;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .vehicle:hover { border-color: color-mix(in srgb, var(--color-ink) 30%, var(--color-line)); }
  .vehicle:has(input:checked) { border-color: var(--color-ink); box-shadow: 0 0 0 2px var(--color-lime-100); }
  .vehicle:has(input:focus-visible) { outline: 3px solid var(--color-lime); outline-offset: 2px; }
  .v-dot {
    position: absolute; top: 0.75rem; right: 0.75rem; display: grid; place-items: center; width: 1.25rem; height: 1.25rem;
    border: 1.5px solid var(--color-line); border-radius: 999px; color: transparent;
  }
  .vehicle:has(input:checked) .v-dot { border-color: var(--color-ink); background: var(--color-ink); color: #fff; }
  /* The mobile box with +91 in front, unless the number brings its own code. */
  .tel { position: relative; display: block; }
  .tel-cc { position: absolute; top: 50%; left: 0.875rem; transform: translateY(-50%); font-weight: 400; color: var(--color-muted); pointer-events: none; }
  .field .tel input { width: 100%; padding-left: 3.1rem; }
  .tel.is-intl .tel-cc { display: none; }
  .field .tel.is-intl input { padding-left: 0.875rem; }
  .more summary {
    display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; min-height: 3rem; padding: 0.625rem 0.875rem;
    border: 1px dashed color-mix(in srgb, var(--color-ink) 22%, var(--color-line)); border-radius: 0.75rem;
    font-weight: 600; color: var(--color-ink); cursor: pointer; list-style: none;
  }
  .more summary::-webkit-details-marker { display: none; }
  .more summary:hover { border-color: var(--color-ink); }
  /* The chevron is drawn by Icon.astro, which does not carry this page's scope. */
  .more :global(.more-chev) { color: var(--color-muted); transition: transform 0.2s ease; }
  .more[open] :global(.more-chev) { transform: rotate(180deg); }
  /* A field left out or mistyped, once a button has been pressed. */
  .field.is-bad input, :global(.pk.is-bad .pk-trigger) { border-color: #c81e1e; }
  :global(.field-err) { font-size: 0.85rem; font-weight: 500; color: #b42318; }
  /* The phone fare bar. Wider screens show the fare box beside or right under the form instead. */
  .book-bar {
    position: fixed; inset: auto 0 0; z-index: 40; display: flex; align-items: center; gap: 0.75rem;
    padding: 0.625rem 1rem calc(0.625rem + env(safe-area-inset-bottom));
    border-top: 1px solid var(--color-line); background: #fff; box-shadow: 0 -10px 30px -16px rgb(17 17 17 / 30%);
    transition: transform 0.2s ease;
  }
  .book-bar.is-away, .book-bar.is-typing { transform: translateY(calc(100% + 1rem)); }
  @media (min-width: 640px) { .book-bar { display: none; } }
</style>

<style is:global>
  /* The "Pay the advance by UPI" popup: centred on a laptop, a sheet from the bottom on a phone. */
  .pay-dlg { width: min(100% - 2rem, 30rem); max-height: calc(100dvh - 2rem); margin: auto; padding: 0; border: 0; border-radius: 1.5rem; background: #fff; color: var(--color-ink); }
  .pay-dlg[open] { display: flex; flex-direction: column; }
  .pay-dlg::backdrop { background: rgb(17 17 17 / 55%); backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px); }
  .pay-head { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 1rem 1.25rem; border-bottom: 1px solid var(--color-line); }
  .pay-x { display: grid; place-items: center; width: 2.75rem; height: 2.75rem; border: 1px solid var(--color-line); border-radius: 0.75rem; background: #fff; color: var(--color-ink); cursor: pointer; }
  .pay-main { display: flex; flex-direction: column; gap: 1rem; overflow-y: auto; padding: 1.25rem; }
  .pay-amount { display: flex; flex-direction: column; gap: 0.15rem; padding: 1rem 1.15rem; border-radius: 1rem; background: var(--color-ink); }
  .pay-qr { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem; padding: 0.85rem; border: 1px solid var(--color-line); border-radius: 1rem; }
  .pay-qr img { width: 170px; height: auto; max-height: 300px; object-fit: contain; flex-shrink: 0; }
  .pay-qr > div { flex: 1 1 11rem; }
  .pay-id { overflow-wrap: anywhere; padding: 0.15rem 0.45rem; border-radius: 0.4rem; background: var(--color-mist); font-size: 0.9rem; }
  .pay-copy { min-height: 2.25rem; padding: 0 0.75rem; border: 1px solid var(--color-ink); border-radius: 0.6rem; background: #fff; font-weight: 700; font-size: 0.8rem; cursor: pointer; }
  .pay-note { margin: 0; padding: 0.85rem 1rem; border-radius: 0.85rem; background: var(--color-mist); font-size: 0.92rem; color: var(--color-body); }
  .pay-steps { margin: 0; padding-left: 1.25rem; display: flex; flex-direction: column; gap: 0.4rem; font-size: 0.92rem; color: var(--color-body); }
  .pay-steps[hidden], .pay-app[hidden] { display: none; }
  /* A UPI link only opens an app on a phone. */
  @media (hover: hover) and (pointer: fine) { .pay-app { display: none; } }
  @media (max-width: 639px) {
    .pay-dlg { width: 100%; max-width: 100%; max-height: 92dvh; margin: auto 0 0; border-radius: 1.5rem 1.5rem 0 0; }
    .pay-main { padding-bottom: max(env(safe-area-inset-bottom), 1.25rem); }
  }
</style>
