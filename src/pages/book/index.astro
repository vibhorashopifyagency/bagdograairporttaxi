---
import GoogleRatingBadge from '../../components/GoogleRatingBadge.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import DatePicker from '../../components/DatePicker.astro';
import TimePicker from '../../components/TimePicker.astro';
import { ROUTES, ROUTE_GROUPS } from '../../data/routes';
import { PACKAGES } from '../../data/packages';
import { VEHICLES } from '../../data/vehicles';
import { BUSINESS, POLICY } from '../../data/site';

// Only what the script needs, so the inline payload stays a few kB.
const data = {
  routes: Object.fromEntries(ROUTES.map((r) => [r.slug, { name: `${r.from} to ${r.to}`, fares: r.fares }])),
  packages: Object.fromEntries(PACKAGES.map((p) => [p.slug, { name: `${p.name} (${p.nights}N/${p.days}D)`, fromPrice: p.fromPrice, priceNote: p.priceNote }])),
  vehicles: Object.fromEntries(VEHICLES.map((v) => [v.key, v.name])),
  policy: POLICY,
  whatsapp: BUSINESS.whatsapp,
};
---

<BaseLayout
  title="Book a Bagdogra Airport Taxi Online: Instant Fare, UPI Advance"
  description={`Book a fixed-fare taxi from Bagdogra Airport, NJP or Siliguri in under a minute. See the full fare, pay a ${POLICY.advancePercent}% advance by UPI and get instant WhatsApp confirmation.`}
  crumbs={[{ name: 'Book a taxi', path: '/book/' }]}
>
  <div class="wrap mt-6 grid grid-cols-1 gap-8 lg:grid-cols-[minmax(0,1fr)_380px]">
    <div>
      <h1 class="text-3xl font-extrabold sm:text-4xl">Book your taxi</h1>
      <p class="mt-2 text-muted">Takes under a minute. You see the full fare before you pay anything.</p>
      <GoogleRatingBadge variant="chip" class="mt-4" />

      <form id="book" class="mt-8 space-y-8" novalidate>
        <fieldset>
          <legend class="text-lg font-bold text-ink">1. Trip</legend>
          <div class="mt-3 flex gap-2" role="radiogroup">
            <label class="chip"><input type="radio" name="kind" value="taxi" checked class="sr-only" /><span>Taxi transfer</span></label>
            <label class="chip"><input type="radio" name="kind" value="package" class="sr-only" /><span>Tour package</span></label>
          </div>
          <label class="field mt-4" data-for="taxi">
            <span>Route</span>
            <select name="route" required>
              {ROUTE_GROUPS.map((g) => (
                <optgroup label={g}>
                  {ROUTES.filter((r) => r.group === g).map((r) => <option value={r.slug}>{r.from} to {r.to}</option>)}
                </optgroup>
              ))}
            </select>
          </label>
          <label class="field mt-4" data-for="package" hidden>
            <span>Tour package</span>
            <select name="package">
              {PACKAGES.map((p) => <option value={p.slug}>{p.name} ({p.nights}N/{p.days}D)</option>)}
            </select>
          </label>
        </fieldset>

        <fieldset>
          <legend class="text-lg font-bold text-ink">2. Car</legend>
          <div class="mt-3 grid gap-3 sm:grid-cols-2">
            {VEHICLES.map((v, i) => (
              <label class="vehicle card flex cursor-pointer items-start gap-3 p-4">
                <input type="radio" name="vehicle" value={v.key} checked={i === 0} class="mt-1 accent-[#111111]" />
                <span class="flex-1">
                  <strong class="block text-ink">{v.name} <span class="font-normal text-muted">· {v.seats} seats</span></strong>
                  <span class="block text-xs text-muted">{v.models}</span>
                  <span class="mt-1 block text-lg font-bold text-ink" data-price={v.key}></span>
                </span>
              </label>
            ))}
          </div>
        </fieldset>

        <fieldset class="grid gap-4 sm:grid-cols-2">
          <legend class="mb-3 text-lg font-bold text-ink sm:col-span-2">3. When and where</legend>
          <DatePicker name="date" label="Pickup date" />
          <TimePicker name="time" label="Pickup time (or landing time)" nightFrom={POLICY.nightChargeFrom} nightTo={POLICY.nightChargeTo} nightTag={`+₹${POLICY.nightCharge.toLocaleString('en-IN')} night charge`} />
          <label class="field"><span>Flight or train number <em class="font-normal text-muted">(optional)</em></span><input name="flight" placeholder="e.g. 6E 6521" autocomplete="off" /></label>
          <label class="field"><span>Passengers</span><input type="number" name="pax" min="1" max="12" value="2" inputmode="numeric" /></label>
          <label class="field sm:col-span-2"><span>Hotel or drop address</span><input name="drop" placeholder="Hotel name and area" /></label>
        </fieldset>

        <fieldset class="grid gap-4 sm:grid-cols-2">
          <legend class="mb-3 text-lg font-bold text-ink sm:col-span-2">4. Your details</legend>
          <label class="field"><span>Full name</span><input name="name" required autocomplete="name" /></label>
          <label class="field"><span>Mobile (WhatsApp)</span><input name="phone" type="tel" required autocomplete="tel" inputmode="tel" placeholder="+91" /></label>
        </fieldset>
        <div class="hp" aria-hidden="true">
          <label>Leave this empty<input name="website" tabindex="-1" autocomplete="off" /></label>
        </div>
        <p id="err" class="hidden rounded-lg bg-red-50 p-3 text-sm text-red-800" role="alert"></p>
      </form>
    </div>

    <aside class="lg:sticky lg:top-24 lg:self-start">
      <div class="ring-shell">
      <div class="card overflow-hidden">
        <div class="bg-ink p-5 text-white">
          <p class="text-sm text-white/70" id="fare-label">Your fare</p>
          <p class="text-4xl font-extrabold" id="total" aria-live="polite">–</p>
          <p class="text-sm text-white/70" id="trip-name"></p>
          <p class="mt-1 text-xs text-white/60" id="fare-note" hidden></p>
        </div>
        <dl class="space-y-2 p-5 text-sm">
          <div class="flex justify-between"><dt id="base-label">Base fare</dt><dd id="base" class="font-semibold text-ink">–</dd></div>
          <div class="flex justify-between"><dt id="night-label">Night charge</dt><dd id="night" class="font-semibold text-ink">₹0</dd></div>
          <div class="flex justify-between border-t border-line pt-2"><dt><strong class="text-ink">Advance now ({POLICY.advancePercent}%)</strong></dt><dd id="adv" class="font-bold text-ink">–</dd></div>
          <div class="flex justify-between"><dt id="bal-label">Pay driver after trip</dt><dd id="bal">–</dd></div>
        </dl>
        <div class="space-y-3 px-5 pb-5">
          <button type="button" id="wa" class="btn-wa w-full"><Icon name="whatsapp" /> Confirm on WhatsApp</button>
          <button type="button" id="pay" class="btn-book w-full"><Icon name="shield" /> Pay advance by UPI</button>
          <p class="text-xs text-muted" id="pay-note"></p>
          <p class="text-xs text-muted">We save your name, mobile number and trip details to arrange this booking. <a href="/privacy/">Privacy policy</a></p>
        </div>
        <ul class="space-y-2 border-t border-line bg-mist p-5 text-sm">
          <li class="flex gap-2"><Icon name="refund" class="h-5 w-5 shrink-0 text-lime-text" />Free cancellation up to {POLICY.freeCancelHours} hours before pickup. <a href="/cancellation-refund-policy/">Policy</a></li>
          <li class="flex gap-2"><Icon name="clock" class="h-5 w-5 shrink-0 text-lime-text" />{POLICY.freeWaitMinutes} minutes free waiting after landing</li>
          <li class="flex gap-2"><Icon name="check" class="h-5 w-5 shrink-0 text-lime-text" />Tolls, parking, driver allowance and GST included</li>
        </ul>
      </div>
      </div>
      <p class="mt-4 text-center text-sm">Prefer to talk? <a href={BUSINESS.phoneHref}>Call {BUSINESS.phone}</a>, open 24 hours.</p>
    </aside>
  </div>

  {/* Paying the advance first: the office UPI QR code, from /api/upi/ when the button is pressed. */}
  <dialog id="pay-dlg" class="pay-dlg" aria-labelledby="pay-title">
    <div class="pay-head">
      <h2 id="pay-title" class="m-0 text-xl font-extrabold">Pay the advance by UPI</h2>
      <button type="button" class="pay-x" data-pay-close aria-label="Close">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12" /></svg>
      </button>
    </div>
    <div class="pay-main">
      <div class="pay-amount">
        <span class="text-sm text-white/70">Advance for booking <strong class="font-mono text-white" data-pay-ref></strong></span>
        <strong class="text-4xl font-extrabold text-lime" data-pay-amt></strong>
        <span class="text-sm text-white/70" data-pay-rest></span>
      </div>

      <div data-pay-loading class="pay-note">Loading our UPI QR code…</div>
      <div data-pay-qr hidden class="pay-qr">
        {/* The QR picture and the UPI app link are made by the script once /api/upi/ answers. */}
        <div class="flex min-w-0 flex-col gap-1.5">
          <span class="font-bold text-ink">Scan with any UPI app</span>
          <span class="text-sm text-body">Google Pay, PhonePe, Paytm, BHIM or your bank's app.</span>
          <span class="text-sm text-body" data-pay-payee></span>
          <span class="flex flex-wrap items-center gap-2 text-sm" data-pay-idrow hidden>
            <span class="text-muted">UPI ID</span>
            <code class="pay-id" data-pay-id></code>
            <button type="button" class="pay-copy" data-pay-copy>Copy</button>
          </span>
        </div>
      </div>
      <p data-pay-none hidden class="pay-note">Our UPI QR code is sent with your confirmation on WhatsApp. Your booking is saved; press the button below to send it to us.</p>

      <ol class="pay-steps" data-pay-steps>
        <li>Pay <strong data-pay-amt2></strong> and write <strong data-pay-ref2></strong> in the note, if your app asks for one.</li>
        <li>Send us the payment screenshot on WhatsApp. We confirm your booking there.</li>
      </ol>
      <button type="button" class="btn-wa w-full" data-pay-wa><Icon name="whatsapp" /> <span data-pay-wa-label>I have paid: send it on WhatsApp</span></button>
      <p class="m-0 text-center text-xs text-muted">Free cancellation up to {POLICY.freeCancelHours} hours before pickup. <a href="/cancellation-refund-policy/">Refund policy</a></p>
    </div>
  </dialog>

  <script type="application/json" id="book-data" set:html={JSON.stringify(data)} />
  <script>
    type Data = {
      routes: Record<string, { name: string; fares: Record<string, number> }>;
      packages: Record<string, { name: string; fromPrice: number; priceNote: string }>;
      vehicles: Record<string, string>;
      policy: { advancePercent: number; nightCharge: number; nightChargeFrom: string; nightChargeTo: string };
      whatsapp: string;
    };
    const d: Data = JSON.parse(document.getElementById('book-data')!.textContent!);
    const f = document.getElementById('book') as HTMLFormElement;
    const $ = (id: string) => document.getElementById(id)!;
    const inr = (n: number) => '₹' + n.toLocaleString('en-IN');
    const val = (n: string) => ((f.elements.namedItem(n) as HTMLInputElement | null)?.value ?? '').trim();
    const kind = () => (f.querySelector('input[name=kind]:checked') as HTMLInputElement).value;

    // Every request gets a short reference, shown in the WhatsApp message and
    // saved with the booking so the office can match the two. The same details
    // sent twice keep the same reference, so the server saves them once.
    const ALPHABET = 'ABCDEFGHJKMNPQRSTUVWXYZ23456789';
    const newRef = () => 'BAT-' + Array.from(crypto.getRandomValues(new Uint8Array(6)), (x) => ALPHABET[x % ALPHABET.length]).join('');
    let ref = newRef();
    let lastSent = '';
    function payload(channel: 'whatsapp' | 'payment') {
      const c = calc();
      const p = {
        kind: kind(), route: val('route'), package: val('package'), vehicle: c.vehicle,
        date: val('date'), time: val('time'), flight: val('flight'), pax: Math.max(1, parseInt(val('pax'), 10) || 1),
        drop: val('drop'), name: val('name'), phone: val('phone'),
        fareShown: c.total, advanceShown: c.adv, consent: true, website: val('website'),
      };
      const sig = JSON.stringify(p);
      if (lastSent && sig !== lastSent) ref = newRef();
      lastSent = sig;
      return { ...p, ref, channel };
    }
    // Save the booking without making the customer wait. If the network or
    // the server fails, keep it in this browser; BaseLayout retries it on the
    // next page view, and the server ignores a reference it already has.
    const PENDING = 'bat-pending-bookings';
    function keep(p: object) {
      try {
        const q = JSON.parse(localStorage.getItem(PENDING) || '[]');
        q.push({ ...p, savedAt: Date.now() });
        localStorage.setItem(PENDING, JSON.stringify(q.slice(-10)));
      } catch { /* private mode: nothing more we can do; WhatsApp still has it */ }
    }
    function save(p: object) {
      fetch('/api/bookings/', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(p), keepalive: true })
        .then((r) => { if (r.status >= 500 || r.status === 429) keep(p); })
        .catch(() => keep(p));
    }

    // Prefill from links such as /book/?route=…&vehicle=… or ?package=…
    const q = new URLSearchParams(location.search);
    if (q.get('route') && d.routes[q.get('route')!]) (f.elements.namedItem('route') as HTMLSelectElement).value = q.get('route')!;
    if (q.get('package') && d.packages[q.get('package')!]) {
      (f.querySelector('input[value=package]') as HTMLInputElement).checked = true;
      (f.elements.namedItem('package') as HTMLSelectElement).value = q.get('package')!;
    }
    if (q.get('vehicle')) {
      const v = f.querySelector(`input[name=vehicle][value="${CSS.escape(q.get('vehicle')!)}"]`) as HTMLInputElement | null;
      if (v) v.checked = true;
    }
    const isNight = (t: string) => {
      if (!t) return false;
      const { nightChargeFrom: a, nightChargeTo: b } = d.policy;
      return t >= a || t < b;
    };

    function calc() {
      const pkg = kind() === 'package';
      document.querySelectorAll<HTMLElement>('[data-for]').forEach((el) => (el.hidden = el.dataset.for !== (pkg ? 'package' : 'taxi')));
      const route = d.routes[val('route')];
      const vehicle = (f.querySelector('input[name=vehicle]:checked') as HTMLInputElement).value;
      document.querySelectorAll<HTMLElement>('[data-price]').forEach((el) => {
        el.textContent = pkg ? '' : inr(route.fares[el.dataset.price!]);
      });
      $('fare-label').textContent = pkg ? 'Package price' : 'Your fare';
      $('base-label').textContent = pkg ? 'Per person' : 'Base fare';
      $('night-label').textContent = pkg ? 'Travellers' : 'Night charge';
      $('bal-label').textContent = pkg ? 'Balance before the trip' : 'Pay driver after trip';
      $('fare-note').hidden = !pkg;
      if (pkg) {
        // Packages are priced per person (two sharing), so the total is the
        // lowest season price times the party. The office confirms the final
        // figure on WhatsApp once season, hotels and group size are known.
        const p = d.packages[val('package')];
        const pax = Math.max(1, parseInt(val('pax'), 10) || 1);
        const total = p.fromPrice * pax;
        const adv = Math.round((total * d.policy.advancePercent) / 100);
        $('trip-name').textContent = `${p.name} · ${p.priceNote}`;
        $('fare-note').textContent = 'Lowest season price. Final price confirmed on WhatsApp once season, hotels and group size are known.';
        $('total').textContent = `from ${inr(p.fromPrice)}`;
        $('base').textContent = inr(p.fromPrice);
        $('night').textContent = `${pax} × ${inr(p.fromPrice)} = ${inr(total)}`;
        $('adv').textContent = `from ${inr(adv)}`;
        $('bal').textContent = `from ${inr(total - adv)}`;
        return { route: null, vehicle, total, adv, pax, pkg: p };
      }
      const base = route.fares[vehicle];
      const night = isNight(val('time')) ? d.policy.nightCharge : 0;
      const total = base + night;
      const adv = Math.round((total * d.policy.advancePercent) / 100);
      $('trip-name').textContent = `${route.name} · ${d.vehicles[vehicle]}`;
      $('total').textContent = inr(total);
      $('base').textContent = inr(base);
      $('night').textContent = inr(night);
      $('adv').textContent = inr(adv);
      $('bal').textContent = inr(total - adv);
      return { route, vehicle, total, adv, pax: 0, pkg: null };
    }

    function check() {
      const missing = ['date', 'time', 'name', 'phone'].filter((n) => !val(n));
      const err = $('err');
      if (missing.length) {
        err.textContent = 'Please add your ' + missing.map((m) => (m === 'phone' ? 'mobile number' : m === 'time' ? 'pickup time' : m === 'date' ? 'pickup date' : 'name')).join(', ') + '.';
        err.classList.remove('hidden');
        // Date and time live in hidden inputs; their picker buttons take the focus instead.
        const first = f.elements.namedItem(missing[0]) as HTMLElement;
        (first.closest('[data-picker]')?.querySelector<HTMLElement>('.pk-trigger') ?? first).focus();
        return false;
      }
      err.classList.add('hidden');
      return true;
    }

    function message() {
      const c = calc();
      const lines = c.pkg
        ? [`Tour package: ${c.pkg.name}`, `Car: ${d.vehicles[c.vehicle]}`, `Price shown: from ${inr(c.pkg.fromPrice)} ${c.pkg.priceNote} · ${c.pax} travellers from ${inr(c.total)} (advance ${inr(c.adv)})`]
        : [`Route: ${c.route!.name}`, `Car: ${d.vehicles[c.vehicle]}`, `Fare shown: ${inr(c.total)} (advance ${inr(c.adv)})`];
      return [
        'New booking request',
        `Booking ref: ${ref}`,
        ...lines,
        `Date: ${val('date')} at ${val('time')}`,
        val('flight') && `Flight/train: ${val('flight')}`,
        `Passengers: ${val('pax')}`,
        val('drop') && `Drop: ${val('drop')}`,
        `Name: ${val('name')}`,
        `Mobile: ${val('phone')}`,
      ].filter(Boolean).join('\n');
    }

    f.addEventListener('input', calc);
    f.addEventListener('change', calc);
    $('wa').addEventListener('click', () => {
      if (!check()) return;
      const p = payload('whatsapp');
      // Opened first and in the same click, or the browser blocks the window.
      window.open(`https://wa.me/${d.whatsapp}?text=${encodeURIComponent(message())}`, '_blank', 'noopener');
      save(p);
    });
    // Paying the advance first. The booking is saved the moment the button is
    // pressed, then the office QR code shows with the amount. Tour packages are
    // priced "from", so their advance is asked for on WhatsApp once the office
    // confirms the final price.
    const dlg = $('pay-dlg') as HTMLDialogElement;
    const q1 = <T extends Element = HTMLElement>(sel: string) => dlg.querySelector<T>(sel)!;
    type Upi = { ok: boolean; payee: string; id: string; qr: { src: string; w: number; h: number } | null };
    let upi: Promise<Upi | null> | null = null;
    const loadUpi = () => (upi ??= fetch('/api/upi/').then((r) => (r.ok ? r.json() : null)).catch(() => null));
    const upiLink = (u: Upi, amount: number) =>
      `upi://pay?pa=${u.id}&pn=${encodeURIComponent(u.payee)}&cu=INR&am=${amount.toFixed(2)}&tn=${encodeURIComponent(`Booking ${ref}`)}`;

    function syncPayButton() {
      const pkg = kind() === 'package';
      ($('pay') as HTMLButtonElement).hidden = pkg;
      $('pay-note').textContent = pkg
        ? 'For tour packages we confirm the final price on WhatsApp first, then send our UPI QR code for the advance.'
        : 'Pay by scanning our UPI QR code with any UPI app. No card details, no payment page.';
    }
    f.addEventListener('change', syncPayButton);
    syncPayButton();

    $('pay').addEventListener('click', async () => {
      if (!check()) return;
      const p = payload('payment');
      save(p);
      const c = calc();
      q1('[data-pay-ref]').textContent = ref;
      q1('[data-pay-ref2]').textContent = ref;
      q1('[data-pay-amt]').textContent = inr(c.adv);
      q1('[data-pay-amt2]').textContent = inr(c.adv);
      q1('[data-pay-rest]').textContent = `${d.policy.advancePercent}% of ${inr(c.total)}. The other ${inr(c.total - c.adv)} is paid to your driver after the trip.`;
      q1('[data-pay-loading]').hidden = false;
      q1('[data-pay-qr]').hidden = true;
      q1('[data-pay-none]').hidden = true;
      const oldApp = dlg.querySelector<HTMLElement>('[data-pay-app]');
      if (oldApp) oldApp.hidden = true;
      q1('[data-pay-steps]').hidden = false;
      q1('[data-pay-wa-label]').textContent = 'I have paid: send it on WhatsApp';
      dlg.showModal();
      const u = await loadUpi();
      q1('[data-pay-loading]').hidden = true;
      if (!u?.qr) {
        // No QR code uploaded yet (or offline): the office sends it on WhatsApp.
        q1('[data-pay-none]').hidden = false;
        q1('[data-pay-steps]').hidden = true;
        q1('[data-pay-wa-label]').textContent = 'Confirm on WhatsApp';
        return;
      }
      const box = q1('[data-pay-qr]');
      const img = box.querySelector('img') ?? box.insertBefore(document.createElement('img'), box.firstChild);
      img.src = u.qr.src;
      img.width = u.qr.w;
      img.height = u.qr.h;
      img.alt = `UPI QR code of ${u.payee || 'Bagdogra Airport Taxi'}`;
      q1('[data-pay-payee]').textContent = u.payee ? `Pays ${u.payee}` : '';
      q1('[data-pay-idrow]').hidden = !u.id;
      q1('[data-pay-id]').textContent = u.id;
      q1('[data-pay-qr]').hidden = false;
      if (u.id) {
        // On a phone the QR code cannot scan itself: this opens the UPI app with the amount filled in.
        let app = dlg.querySelector<HTMLAnchorElement>('[data-pay-app]');
        if (!app) {
          app = Object.assign(document.createElement('a'), { className: 'btn-book pay-app w-full' });
          app.dataset.payApp = '';
          box.after(app);
        }
        app.href = upiLink(u, c.adv);
        app.textContent = `Pay ${inr(c.adv)} with a UPI app`;
        app.hidden = false;
      }
    });
    // Fetch the QR details as soon as someone shows interest, so the popup opens filled in.
    $('pay').addEventListener('pointerenter', () => void loadUpi(), { once: true });
    $('pay').addEventListener('focus', () => void loadUpi(), { once: true });
    q1('[data-pay-copy]').addEventListener('click', async (e) => {
      const btn = e.currentTarget as HTMLButtonElement;
      try {
        await navigator.clipboard.writeText(q1('[data-pay-id]').textContent ?? '');
        btn.textContent = 'Copied';
      } catch {
        btn.textContent = 'Select and copy';
      }
      setTimeout(() => (btn.textContent = 'Copy'), 2000);
    });
    q1('[data-pay-wa]').addEventListener('click', () => {
      const paid = !q1('[data-pay-qr]').hidden;
      const c = calc();
      const text = paid ? `${message()}\nAdvance paid: ${inr(c.adv)} by UPI. I am sending the payment screenshot.` : message();
      // Opened first and in the same click, or the browser blocks the window.
      window.open(`https://wa.me/${d.whatsapp}?text=${encodeURIComponent(text)}`, '_blank', 'noopener');
      dlg.close();
    });
    q1('[data-pay-close]').addEventListener('click', () => dlg.close());
    dlg.addEventListener('click', (e) => {
      if (e.target === dlg) dlg.close();
    });
    calc();
  </script>
</BaseLayout>

<style>
  .hp { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
  /* A fieldset never shrinks below its widest content by default, so a long route name pushed the select off a phone screen. */
  fieldset { min-width: 0; }
  .field[hidden] { display: none; }
