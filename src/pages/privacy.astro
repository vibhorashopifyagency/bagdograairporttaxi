---
import BaseLayout from '../layouts/BaseLayout.astro';
import Words from '../components/Words.astro';
import { editAttr, wordsList, wordsText } from '../data/page-text';
// The words are "Privacy policy" in the dashboard's Edit pages (src/data/page-text.ts).
const list = (field: string) => wordsList('privacy', field);
---

<BaseLayout title={wordsText('privacy', 'seoTitle')} description={wordsText('privacy', 'seoDescription')} crumbs={[{ name: 'Privacy', path: '/privacy/' }]}>
  <div class="wrap mt-6">
    <div class="prose-site">
      <Words page="privacy" field="title" as="h1" class="text-3xl font-extrabold sm:text-4xl" />
      <Words page="privacy" field="intro" as="p" />
      <Words page="privacy" field="useTitle" as="h2" />
      <ul data-edit={editAttr('privacy', 'use')}>
        {list('use').map((t) => <li set:html={t} />)}
      </ul>
      <Words page="privacy" field="share" as="p" />
      <Words page="privacy" field="paymentsTitle" as="h2" />
      <Words page="privacy" field="paymentsText" as="p" />
      <Words page="privacy" field="siteTitle" as="h2" />
      {list('siteText').map((t) => <p data-edit={editAttr('privacy', 'siteText')} set:html={t} />)}
      <Words page="privacy" field="keepTitle" as="h2" />
      <Words page="privacy" field="keepText" as="p" />
      <Words page="privacy" field="rightsTitle" as="h2" />
      <Words page="privacy" field="rightsText" as="p" />
      <Words page="privacy" field="effective" as="p" class="text-sm text-muted" />
    </div>
  </div>
</BaseLayout>
