---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import FareTable from '../../components/FareTable.astro';
import FaqList from '../../components/FaqList.astro';
import BookCta from '../../components/BookCta.astro';
import TrustStrip from '../../components/TrustStrip.astro';
import GoogleRatingBadge from '../../components/GoogleRatingBadge.astro';
import RouteCard from '../../components/RouteCard.astro';
import PackageCard from '../../components/PackageCard.astro';
import Icon from '../../components/Icon.astro';
import { ROUTES, inr, lowestFare, routeBySlug, type Route } from '../../data/routes';
import { destinationBySlug } from '../../data/destinations';
import { PACKAGES } from '../../data/packages';
import { VEHICLES } from '../../data/vehicles';
import { BUSINESS, SITE, waLink } from '../../data/site';
import { routePhoto } from '../../lib/photos';
import { faqPage, routeService } from '../../lib/schema';
import { photoFile } from '../../data/photo-library';
import Words from '../../components/Words.astro';
import { routeVars, wordsText } from '../../data/page-text';

export function getStaticPaths() {
  return ROUTES.map((route) => ({ params: { slug: route.slug }, props: { route } }));
}

const { route } = Astro.props as { route: Route };
const path = `/taxi/${route.slug}/`;
const from = lowestFare(route);
const dest = route.destination ? destinationBySlug(route.destination) : undefined;
const returnRoute = route.returnSlug ? routeBySlug(route.returnSlug) : undefined;
const related = ROUTES.filter((r) => r.slug !== route.slug && r.group === route.group).slice(0, 4);
const packages = route.destination ? PACKAGES.filter((p) => p.destinations.includes(route.destination!)).slice(0, 3) : [];
// The fixed words are "Every taxi route page" in the dashboard (src/data/page-text.ts), with this route's numbers as fill-ins.
const vars = routeVars(route);
const waText = wordsText('route-page', 'waText', vars);
const w = (field: string) => wordsText('route-page', field, vars);

// Every route page answers the same core questions in its own numbers, plus
// the route-specific ones from the data file.
const faqs = [
  { q: w('fareQ'), a: w('fareA') },
  { q: w('timeQ'), a: w('timeA') },
  ...route.faqs,
  { q: w('cancelQ'), a: w('cancelA') },
];
const title = w('seoTitle');
const description = w('seoDescription');
---

<BaseLayout
  title={title}
  description={description}
  crumbs={[{ name: 'Taxi fares', path: '/taxi/' }, { name: `${route.fromShort} to ${route.toShort}`, path }]}
  schema={[routeService(route, path), faqPage(faqs, path)]}
  ogImage={photoFile(routePhoto(route), 1600)}
  modified={SITE.contentUpdated}
>
  <PageHero slot="hero" image={routePhoto(route)} edit={`route:${route.slug}`} words="route-page" vars={vars}>
    <div class="mt-5 flex flex-wrap gap-2">
      <span class="chip-light"><Icon name="map" class="h-4 w-4" /> {route.km} km</span>
      <span class="chip-light"><Icon name="clock" class="h-4 w-4" /> {route.duration}</span>
      <span class="chip-light"><Icon name="card" class="h-4 w-4" /> from {inr(from)}</span>
    </div>
  </PageHero>

  <article class="wrap mt-10 grid grid-cols-1 gap-10 lg:grid-cols-[minmax(0,1fr)_360px] lg:gap-14">
    <div class="min-w-0">
      <p class="answer" data-edit={`route:${route.slug}:summary`}>{route.summary}</p>

      <section id="fares" class="mt-12" aria-labelledby="fares-h" data-edit={`route:${route.slug}:fares`}>
        <Words page="route-page" field="faresTitle" vars={vars} as="h2" id="fares-h" class="mb-4 text-2xl font-extrabold sm:text-3xl" />
        <FareTable route={route} />
      </section>

      <div class="prose-site mt-6">
        <Words page="route-page" field="stopsTitle" vars={vars} as="h2" />
        <Words page="route-page" field="stopsText" vars={vars} as="p" />
        <ul data-edit={`route:${route.slug}:stops`}>{route.stops.map((s) => <li>{s}</li>)}</ul>

        <Words page="route-page" field="tipsTitle" vars={vars} as="h2" />
        <ul data-edit={`route:${route.slug}:tips`}>{route.tips.map((t) => <li>{t}</li>)}</ul>

        {dest && (
          <>
            <Words page="route-page" field="aboutTitle" vars={vars} as="h2" />
            <p>{dest.summary} <Words page="route-page" field="guideLink" vars={vars} as="a" href={`/destinations/${dest.slug}/`} />.</p>
          </>
        )}
        {returnRoute && (
          <Words page="route-page" field="returnText" vars={vars} as="p" />
        )}
      </div>

      <FaqList faqs={faqs} edit={`route:${route.slug}:faqs`} />
    </div>

    <aside class="lg:sticky lg:top-24 lg:self-start">
      <div class="card overflow-hidden">
        <div class="bg-ink p-6 text-white">
          <p class="text-sm text-white/70">{route.fromShort} → {route.toShort}</p>
          <p class="mt-1 flex items-baseline gap-2"><Words page="route-page" field="sideFrom" vars={vars} class="text-sm text-white/70" /><strong class="font-[family-name:var(--font-display)] text-4xl font-extrabold">{inr(from)}</strong></p>
          <Words page="route-page" field="sideNote" vars={vars} as="p" class="mt-1 text-sm text-white/70" />
          <GoogleRatingBadge variant="chip" dark class="mt-4" />
        </div>
        <ul class="divide-y divide-line px-5">
          {VEHICLES.map((v) => (
            <li class="flex items-center justify-between gap-3 py-3 text-sm">
              <span><strong class="text-ink">{v.name}</strong><span class="block text-xs text-muted">{v.seats} seats</span></span>
              <a href={`/book/?route=${route.slug}&vehicle=${v.key}`} class="font-[family-name:var(--font-display)] text-lg font-bold text-ink no-underline hover:text-lime-text">{inr(route.fares[v.key])}</a>
            </li>
          ))}
        </ul>
        <div class="space-y-3 p-5">
          <a class="btn-book w-full" href={`/book/?route=${route.slug}`}><Words page="route-page" field="bookButton" vars={vars} /> <Icon name="arrow" /></a>
          <a class="btn-wa w-full" href={waLink(waText)} rel="noopener"><Icon name="whatsapp" /> <Words page="route-page" field="whatsappButton" vars={vars} /></a>
          <a class="btn-ghost w-full" href={BUSINESS.phoneHref}><Icon name="phone" class="h-4 w-4 text-lime-text" /> {BUSINESS.phone}</a>
        </div>
        <ul class="space-y-2.5 border-t border-line bg-cream p-5 text-sm">
          <li class="flex gap-2.5"><Icon name="clock" class="h-5 w-5 shrink-0 text-lime-text" /><Words page="route-page" field="side1" vars={vars} /></li>
          <li class="flex gap-2.5"><Icon name="refund" class="h-5 w-5 shrink-0 text-lime-text" /><Words page="route-page" field="side2" vars={vars} /></li>
          <li class="flex gap-2.5"><Icon name="shield" class="h-5 w-5 shrink-0 text-lime-text" /><Words page="route-page" field="side3" vars={vars} /></li>
        </ul>
      </div>
    </aside>
  </article>

  <div class="wrap">
    <section class="mt-16"><TrustStrip /></section>

    {packages.length > 0 && (
      <section class="mt-16" aria-labelledby="pk-h">
        <Words page="route-page" field="packagesTitle" vars={vars} as="h2" id="pk-h" class="mb-6 text-2xl font-extrabold sm:text-3xl" />
        <div class="grid gap-5 md:grid-cols-3">{packages.map((p) => <PackageCard pkg={p} />)}</div>
      </section>
    )}

    {related.length > 0 && (
      <section class="mt-16" aria-labelledby="rel-h">
        <Words page="route-page" field="relatedTitle" vars={vars} as="h2" id="rel-h" class="mb-6 text-2xl font-extrabold sm:text-3xl" />
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">{related.map((r) => <RouteCard route={r} />)}</div>
      </section>
    )}

    <BookCta bookHref={`/book/?route=${route.slug}`} waText={waText} words="route-page:ctaTitle" vars={vars} image={routePhoto(route)} />
  </div>
</BaseLayout>
