---
import BaseLayout from '../layouts/BaseLayout.astro';
import Words from '../components/Words.astro';
import { wordsText } from '../data/page-text';
// The words are "Terms of service" in the dashboard's Edit pages (src/data/page-text.ts).
const sections = ['fares', 'booking', 'waiting', 'safety', 'cancel'];
---

<BaseLayout title={wordsText('terms', 'seoTitle')} description={wordsText('terms', 'seoDescription')} crumbs={[{ name: 'Terms', path: '/terms/' }]}>
  <div class="wrap mt-6">
    <div class="prose-site">
      <Words page="terms" field="title" as="h1" class="text-3xl font-extrabold sm:text-4xl" />
      {sections.map((s) => (
        <>
          <Words page="terms" field={`${s}Title`} as="h2" />
          <Words page="terms" field={`${s}Text`} as="p" />
        </>
      ))}
    </div>
  </div>
</BaseLayout>
