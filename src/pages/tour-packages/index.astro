---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import PackageCard from '../../components/PackageCard.astro';
import BookCta from '../../components/BookCta.astro';
import TrustStrip from '../../components/TrustStrip.astro';
import Words from '../../components/Words.astro';
import { wordsText } from '../../data/page-text';
import { PACKAGES } from '../../data/packages';
import { SITE } from '../../data/site';
const itemList = {
  '@type': 'ItemList',
  name: 'Tour packages from Bagdogra',
  itemListElement: PACKAGES.map((p, i) => ({ '@type': 'ListItem', position: i + 1, url: `${SITE.url}/tour-packages/${p.slug}/`, name: p.name })),
};
---

<BaseLayout
  title={wordsText('packages', 'seoTitle')}
  description={wordsText('packages', 'seoDescription')}
  crumbs={[{ name: 'Tour packages', path: '/tour-packages/' }]}
  schema={[itemList]}
  modified={SITE.contentUpdated}
>
  <PageHero slot="hero" image="tsomgo" words="packages" compact />
  <div class="wrap section">
    <Words page="packages" field="answer" as="p" class="answer max-w-3xl" />
    <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3 2xl:grid-cols-4" data-reveal-stagger>{PACKAGES.map((p) => <PackageCard pkg={p} />)}</div>
    <section class="mt-14"><TrustStrip /></section>
    <Words page="packages" field="customNote" as="p" class="mt-8 max-w-3xl" />
    <BookCta waText="Hi, I would like a quote for a tour package." words="packages:ctaTitle" image="north-sikkim" />
  </div>
</BaseLayout>
