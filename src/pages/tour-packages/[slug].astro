---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import FaqList from '../../components/FaqList.astro';
import BookCta from '../../components/BookCta.astro';
import TrustStrip from '../../components/TrustStrip.astro';
import PackageCard from '../../components/PackageCard.astro';
import Icon from '../../components/Icon.astro';
import GoogleRatingBadge from '../../components/GoogleRatingBadge.astro';
import { PACKAGES, type TourPackage } from '../../data/packages';
import { destinationBySlug } from '../../data/destinations';
import { inr } from '../../data/routes';
import { BUSINESS, waLink, SITE } from '../../data/site';
import { packagePhoto } from '../../lib/photos';
import { faqPage, tourTrip } from '../../lib/schema';
import { photoFile } from '../../data/photo-library';
import Words from '../../components/Words.astro';
import { packageVars, wordsText } from '../../data/page-text';

export function getStaticPaths() {
  return PACKAGES.map((pkg) => ({ params: { slug: pkg.slug }, props: { pkg } }));
}
const { pkg } = Astro.props as { pkg: TourPackage };
const path = `/tour-packages/${pkg.slug}/`;
// The fixed words are "Every tour package page" in the dashboard (src/data/page-text.ts), with this package's numbers as fill-ins.
const vars = packageVars(pkg);
const w = (field: string) => wordsText('package-page', field, vars);
const faqs = [
  { q: w('costQ'), a: w('costA') },
  ...pkg.faqs,
  { q: w('confirmQ'), a: w('confirmA') },
];
const others = PACKAGES.filter((p) => p.slug !== pkg.slug).slice(0, 3);
const dests = pkg.destinations.map(destinationBySlug).filter(Boolean);
const waText = `Hi, I am interested in the ${pkg.name} tour package (${pkg.nights}N/${pkg.days}D).`;
---

<BaseLayout
  title={w('seoTitle')}
  description={w('seoDescription')}
  crumbs={[{ name: 'Tour packages', path: '/tour-packages/' }, { name: pkg.name, path }]}
  schema={[tourTrip(pkg, path), faqPage(faqs, path)]}
  ogImage={photoFile(packagePhoto(pkg), 1600)}
  modified={SITE.contentUpdated}
>
  <PageHero slot="hero" image={packagePhoto(pkg)} edit={`package:${pkg.slug}`} words="package-page" vars={vars}>
    <div class="mt-5 flex flex-wrap gap-2">
      <span class="chip-light"><Icon name="map" class="h-4 w-4" /> {pkg.places.join(' · ')}</span>
      {pkg.bestFor.map((b) => <span class="chip-light">{b}</span>)}
    </div>
  </PageHero>

  <article class="wrap mt-10 grid grid-cols-1 gap-10 lg:grid-cols-[minmax(0,1fr)_360px] lg:gap-14">
    <div class="min-w-0">
      <p class="answer" data-edit={`package:${pkg.slug}:summary`}>{pkg.summary}</p>

      <section id="itinerary" class="mt-12" aria-labelledby="it-h">
        <Words page="package-page" field="itineraryTitle" vars={vars} as="h2" id="it-h" class="text-2xl font-extrabold sm:text-3xl" />
        <ol class="mt-6 space-y-5 border-l-2 border-line pl-7" data-edit={`package:${pkg.slug}:itinerary`}>
          {pkg.itinerary.map((d, i) => (
            <li class="relative">
              <span class="absolute -left-[2.55rem] flex h-8 w-8 items-center justify-center rounded-full bg-ink font-[family-name:var(--font-display)] text-sm font-bold text-white ring-4 ring-white">{i + 1}</span>
              <h3 class="pt-1 font-bold text-ink">Day {i + 1}: {d.title}</h3>
              <p class="mt-1 leading-relaxed">{d.detail}</p>
            </li>
          ))}
        </ol>
      </section>

      <section class="mt-12 grid gap-5 md:grid-cols-2" aria-label="Inclusions and exclusions">
        <div class="card p-6">
          <Words page="package-page" field="includedTitle" vars={vars} as="h2" class="text-xl font-bold" />
          <ul class="mt-4 space-y-2.5" data-edit={`package:${pkg.slug}:includes`}>{pkg.includes.map((x) => <li class="flex gap-2.5"><Icon name="check" class="mt-0.5 h-5 w-5 shrink-0 text-lime-text" />{x}</li>)}</ul>
        </div>
        <div class="card bg-cream p-6">
          <Words page="package-page" field="excludedTitle" vars={vars} as="h2" class="text-xl font-bold" />
          <ul class="mt-4 space-y-2.5" data-edit={`package:${pkg.slug}:excludes`}>{pkg.excludes.map((x) => <li class="flex gap-2.5"><span class="w-5 shrink-0 text-center text-muted" aria-hidden="true">–</span>{x}</li>)}</ul>
        </div>
      </section>

      {dests.length > 0 && (
        <p class="mt-8"><Words page="package-page" field="placesText" vars={vars} /> {dests.map((d, i) => <>{i > 0 && ', '}<a href={`/destinations/${d!.slug}/`}>{d!.name}</a></>)}.</p>
      )}

      <FaqList faqs={faqs} edit={`package:${pkg.slug}:faqs`} />
    </div>

    <aside class="lg:sticky lg:top-24 lg:self-start">
      <div class="ring-shell">
      <div class="card overflow-hidden">
        <div class="bg-ink p-6 text-white">
          <p class="text-sm text-white/70" data-edit={`package:${pkg.slug}:fromPrice`} data-edit-panel>Package price</p>
          <p class="mt-1 flex items-baseline gap-2"><Words page="package-page" field="sideFrom" vars={vars} class="text-sm text-white/70" /><strong class="font-[family-name:var(--font-display)] text-4xl font-extrabold">{inr(pkg.fromPrice)}</strong></p>
          <p class="mt-1 text-sm text-white/70">{pkg.priceNote}</p>
          <GoogleRatingBadge variant="chip" dark class="mt-4" />
        </div>
        <div class="space-y-3 p-5">
          <a class="btn-book w-full" href={`/book/?package=${pkg.slug}`}><Words page="package-page" field="bookButton" vars={vars} /> <Icon name="arrow" /></a>
          <a class="btn-wa w-full" href={waLink(waText)} rel="noopener"><Icon name="whatsapp" /> <Words page="package-page" field="whatsappButton" vars={vars} /></a>
          <a class="btn-ghost w-full" href={BUSINESS.phoneHref}><Icon name="phone" class="h-4 w-4 text-lime-text" /> {BUSINESS.phone}</a>
        </div>
        <ul class="space-y-2.5 border-t border-line bg-cream p-5 text-sm">
          <li class="flex gap-2.5"><Icon name="shield" class="h-5 w-5 shrink-0 text-lime-text" /><Words page="package-page" field="side1" vars={vars} /></li>
          <li class="flex gap-2.5"><Icon name="car" class="h-5 w-5 shrink-0 text-lime-text" /><Words page="package-page" field="side2" vars={vars} /></li>
          <li class="flex gap-2.5"><Icon name="refund" class="h-5 w-5 shrink-0 text-lime-text" /><Words page="package-page" field="side3" vars={vars} /></li>
        </ul>
      </div>
      </div>
    </aside>
  </article>

  <div class="wrap">
    <section class="mt-16"><TrustStrip /></section>
    <section class="mt-16" aria-labelledby="more-h">
      <Words page="package-page" field="othersTitle" vars={vars} as="h2" id="more-h" class="mb-6 text-2xl font-extrabold sm:text-3xl" />
      <div class="grid gap-5 md:grid-cols-3">{others.map((p) => <PackageCard pkg={p} />)}</div>
    </section>
    <BookCta bookHref={`/book/?package=${pkg.slug}`} waText={waText} words="package-page:ctaTitle" vars={vars} image={packagePhoto(pkg)} />
  </div>
</BaseLayout>
