---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import TrustStrip from '../components/TrustStrip.astro';
import BookCta from '../components/BookCta.astro';
import ReviewsSlider from '../components/ReviewsSlider.astro';
import Icon from '../components/Icon.astro';
import Photo from '../components/Photo.astro';
import GalleryGrid from '../components/GalleryGrid.astro';
import MsmeBadge from '../components/MsmeBadge.astro';
import Words from '../components/Words.astro';
import { editAttr, wordsList, wordsText } from '../data/page-text';
import { BUSINESS, MSME, ORG_ID, SITE } from '../data/site';
import { GALLERY } from '../data/gallery';
import { ROUTES } from '../data/routes';
import { PACKAGES } from '../data/packages';
const about = { '@type': 'AboutPage', name: `About ${SITE.name}`, url: `${SITE.url}/about/`, about: { '@id': ORG_ID } };
const since = new Date().getFullYear() - Number(BUSINESS.foundingYear);
const aboutGallery = [...GALLERY.filter((g) => g.category === 'Our cars'), ...GALLERY.filter((g) => g.category === 'On the road'), ...GALLERY.filter((g) => ['hero', 'toy-train', 'tsomgo'].includes(g.photo))];
---

<BaseLayout
  title={wordsText('about', 'seoTitle')}
  description={wordsText('about', 'seoDescription')}
  crumbs={[{ name: 'About', path: '/about/' }]}
  schema={[about]}
>
  <PageHero slot="hero" image="tea-worker" words="about" />

  <div class="wrap mt-10 grid grid-cols-1 gap-10 lg:grid-cols-[minmax(0,1fr)_380px] lg:gap-14">
    <div class="prose-site min-w-0">
      <Words page="about" field="answer" as="p" class="answer" />
      <Words page="about" field="owner" as="p" />
      <Words page="about" field="promisesTitle" as="h2" />
      <ul data-edit={editAttr('about', 'promises')}>
        {wordsList('about', 'promises').map((t) => <li set:html={t} />)}
      </ul>

      <Words page="about" field="detailsTitle" as="h2" />
      <ul>
        <li>Name: {BUSINESS.legalName}</li>
        <li>Address: {BUSINESS.address.street}, {BUSINESS.address.locality}, {BUSINESS.address.district}, {BUSINESS.address.region} {BUSINESS.address.postalCode}</li>
        <li>Phone and WhatsApp: <a href={BUSINESS.phoneHref}>{BUSINESS.phone}</a></li>
        {BUSINESS.gstin && <li>GSTIN: {BUSINESS.gstin}</li>}
        <li>MSME: registered with the Ministry of MSME, Government of India{MSME?.id && ` (Udyam No. ${MSME.id})`}</li>
        {BUSINESS.registrations.filter((r) => r !== MSME).map((r) => <li>{r.name}{r.id && `: ${r.id}`}</li>)}
        <li>Hours: {BUSINESS.hours}</li>
      </ul>
    </div>
    <aside class="space-y-4 lg:sticky lg:top-24 lg:self-start">
      <dl class="card grid grid-cols-3 gap-2 p-5 text-center">
        <div><dd class="font-[family-name:var(--font-display)] text-3xl font-extrabold text-ink">{since}+</dd><Words page="about" field="statYears" as="dt" class="text-xs text-muted" /></div>
        <div><dd class="font-[family-name:var(--font-display)] text-3xl font-extrabold text-ink">{ROUTES.length}</dd><Words page="about" field="statRoutes" as="dt" class="text-xs text-muted" /></div>
        <div><dd class="font-[family-name:var(--font-display)] text-3xl font-extrabold text-ink">{PACKAGES.length}</dd><Words page="about" field="statPackages" as="dt" class="text-xs text-muted" /></div>
      </dl>
      <div class="card p-5">
        <Words page="about" field="talkTitle" as="h2" class="text-lg font-bold" />
        <div class="mt-4 space-y-3">
          <a class="btn-wa w-full" href={`https://wa.me/${BUSINESS.whatsapp}`} rel="noopener"><Icon name="whatsapp" /> WhatsApp</a>
          <a class="btn-ghost w-full" href={BUSINESS.phoneHref}><Icon name="phone" class="h-4 w-4 text-lime-text" /> {BUSINESS.phone}</a>
          <a class="btn-ghost w-full" href={BUSINESS.mapsUrl} rel="noopener"><Icon name="map" class="h-4 w-4 text-lime-text" /> <Words page="about" field="mapsButton" /></a>
        </div>
      </div>
      <MsmeBadge variant="card" />
    </aside>
  </div>
  {/* TODO(pre-launch): the note below is drafted in the owner's voice from what the current site and reviews say; have Pinku Singh approve or rewrite it. */}
  <section class="mt-16 bg-cream py-14 sm:py-20" aria-labelledby="founder-note">
    <div class="wrap grid grid-cols-1 items-center gap-10 lg:grid-cols-2 lg:gap-16">
      <figure class="m-0">
        <div class="overflow-hidden rounded-2xl bg-mist">
          <Photo name="founder" class="aspect-[4/3] h-auto w-full object-cover" sizes="(min-width: 1024px) 46vw, 100vw" />
        </div>
        <Words page="about" field="founderCaption" as="figcaption" class="mt-3 text-sm text-muted" />
      </figure>
      <div class="max-w-2xl">
        <Words page="about" field="founderEyebrow" as="p" class="eyebrow" />
        <Words page="about" field="founderTitle" as="h2" id="founder-note" class="mt-2 text-3xl font-extrabold sm:text-[2.5rem] sm:leading-[1.1]" />
        <div class="mt-6 space-y-4 text-lg leading-relaxed text-body" data-edit={editAttr('about', 'founderNote')}>
          {wordsList('about', 'founderNote').map((t) => <p set:html={t} />)}
        </div>
        <div class="mt-8 flex items-center gap-4 border-t border-line pt-6">
          <div>
            <Words page="about" field="founderName" as="p" class="font-[family-name:var(--font-display)] text-xl font-extrabold text-ink" />
            <Words page="about" field="founderRole" as="p" class="text-sm text-muted" />
          </div>
          <p class="ml-auto hidden text-sm italic text-muted sm:block">“{BUSINESS.tagline}”</p>
        </div>
      </div>
    </div>
  </section>
  <section class="wrap mt-16" aria-labelledby="about-gallery">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div><Words page="about" field="galleryEyebrow" as="p" class="eyebrow" /><Words page="about" field="galleryTitle" as="h2" id="about-gallery" class="mt-2 text-3xl font-extrabold sm:text-[2.5rem] sm:leading-[1.1]" /></div>
      <a href="/gallery/" class="inline-flex items-center gap-1.5 font-semibold text-lime-text no-underline hover:text-ink"><Words page="about" field="galleryLink" /> <Icon name="arrow" class="h-4 w-4" /></a>
    </div>
    <div class="mt-8"><GalleryGrid items={aboutGallery} dense /></div>
  </section>
  <div class="wrap mt-16"><TrustStrip /></div>
  <div class="mt-16"><ReviewsSlider heading="about:reviewsTitle" /></div>
  <div class="wrap">
    <BookCta image="hero" />
  </div>
</BaseLayout>
