---
import BaseLayout from '../layouts/BaseLayout.astro';
import TrustStrip from '../components/TrustStrip.astro';
import RouteCard from '../components/RouteCard.astro';
import PackageCard from '../components/PackageCard.astro';
import FaqList from '../components/FaqList.astro';
import BookCta from '../components/BookCta.astro';
import Icon from '../components/Icon.astro';
import HeroScene from '../components/HeroScene.astro';
import QuickFare from '../components/QuickFare.astro';
import DestinationTile from '../components/DestinationTile.astro';
import GoogleRatingBadge from '../components/GoogleRatingBadge.astro';
import ReviewsSlider from '../components/ReviewsSlider.astro';
import { ROUTES, inr, lowestFare } from '../data/routes';
import { PACKAGES } from '../data/packages';
import { DESTINATIONS } from '../data/destinations';
import { GENERAL_FAQS } from '../data/faqs';
import { BUSINESS, POLICY, SITE, waLink } from '../data/site';
import { VEHICLES } from '../data/vehicles';
import { faqPage, googleReviews } from '../lib/schema';

const featured = ROUTES.filter((r) => r.fromShort === 'Bagdogra Airport').slice(0, 8);
const darj = ROUTES[0];
const gtk = ROUTES[1];
const steps = [
  { title: 'Pick your route and car', text: 'See the full fare before you pay anything.' },
  { title: `Pay ${POLICY.advancePercent}% advance securely`, text: 'UPI, card or net banking. Instant WhatsApp confirmation.' },
  { title: 'Get your driver’s details', text: 'Name, photo and car number the evening before.' },
  { title: 'Meet at arrivals', text: 'Your driver waits with a name board, even if the flight is late.' },
];
---

<BaseLayout title={SITE.title} description={SITE.description} schema={[faqPage(GENERAL_FAQS, '/'), ...googleReviews()]}>
  <section class="relative isolate overflow-hidden">
    <HeroScene />
    <div class="wrap relative grid gap-10 pt-10 pb-40 sm:pt-16 sm:pb-64 lg:grid-cols-[1.1fr_420px] lg:items-start lg:pb-72">
      <div>
        <p class="inline-flex items-center gap-2 rounded-full bg-white/70 px-3 py-1 text-sm font-semibold text-pine-dark backdrop-blur">
          <span class="h-2 w-2 rounded-full bg-wa"></span> Drivers at Bagdogra Airport 24 hours a day
        </p>
        <h1 class="mt-4 text-[2.6rem] leading-[1.02] font-extrabold text-ink sm:text-6xl">
          Your ride into the <span class="text-pine">Himalayas</span> starts at arrivals.
        </h1>
        <p class="mt-5 max-w-xl text-lg text-ink/80">
          Fixed-fare taxis from Bagdogra Airport and NJP to Darjeeling, Gangtok, Pelling and the Dooars. A verified local driver meets you with a name board, waits free for {POLICY.freeWaitMinutes} minutes if you land late, and you can cancel free up to {POLICY.freeCancelHours} hours before.
        </p>
        <div class="mt-7 flex flex-wrap gap-3">
          <a href="/taxi/" class="btn-ghost">See all {ROUTES.length} fares</a>
          <a href={waLink('Hi, I would like to book a taxi from Bagdogra Airport.')} rel="noopener" class="btn-wa"><Icon name="whatsapp" /> WhatsApp</a>
        </div>
        <ul class="mt-7 flex flex-wrap gap-x-5 gap-y-2 text-sm font-medium text-ink/80">
          <li class="flex items-center gap-1.5"><Icon name="check" class="h-4 w-4 text-pine" /> Tolls, parking and GST included</li>
          <li class="flex items-center gap-1.5"><Icon name="check" class="h-4 w-4 text-pine" /> UPI and card</li>
          <li class="flex items-center gap-1.5"><Icon name="check" class="h-4 w-4 text-pine" /> Same car into Gangtok</li>
        </ul>
        <GoogleRatingBadge variant="chip" class="mt-6" />
      </div>
      <QuickFare />
    </div>
  </section>

  <section class="wrap relative -mt-20 sm:-mt-28">
    <TrustStrip />
  </section>

  <section class="wrap mt-16" aria-labelledby="quick-answer">
    <p class="eyebrow">Fares at a glance</p>
    <h2 id="quick-answer" class="mt-2 text-3xl font-bold sm:text-4xl">How much is a taxi from Bagdogra Airport?</h2>
    <p class="answer mt-4 max-w-3xl">
      A private taxi from Bagdogra Airport costs {inr(darj.fares.sedan)} to Darjeeling ({darj.km} km, {darj.duration}) and {inr(gtk.fares.sedan)} to Gangtok ({gtk.km} km, {gtk.duration}) in a sedan, one way. An Innova Crysta costs {inr(darj.fares.innova)} and {inr(gtk.fares.innova)}. Every fare includes tolls, parking, driver allowance and GST.
    </p>
    <div class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {featured.map((r) => <RouteCard route={r} />)}
    </div>
  </section>

  <section class="relative mt-20 overflow-hidden bg-pine-dark py-16 text-white" aria-labelledby="how">
    <svg class="absolute inset-x-0 top-0 h-16 w-full text-white" viewBox="0 0 1440 60" preserveAspectRatio="none" aria-hidden="true"><path fill="currentColor" d="M0 0h1440v20l-180 25-200-20-220 30-240-28-200 22-200-24L0 30Z" /></svg>
    <div class="wrap relative pt-6">
      <p class="eyebrow !text-saffron">Secure booking in four steps</p>
      <h2 id="how" class="mt-2 text-3xl font-bold text-white sm:text-4xl">Booked in a minute. Confirmed on WhatsApp.</h2>
      <ol class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {steps.map((s, i) => (
          <li class="relative rounded-2xl border border-white/15 bg-white/5 p-5">
            <span class="flex h-11 w-11 items-center justify-center rounded-full bg-saffron font-[family-name:var(--font-display)] text-lg font-extrabold text-ink">{i + 1}</span>
            <h3 class="mt-4 text-lg font-semibold text-white">{s.title}</h3>
            <p class="mt-1 text-sm text-pine-100">{s.text}</p>
          </li>
        ))}
      </ol>
      <a href="/book/" class="btn-book mt-10">Start booking <Icon name="arrow" /></a>
    </div>
  </section>

  <section class="wrap mt-16" aria-labelledby="pk">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="eyebrow">Tour packages from Bagdogra</p>
        <h2 id="pk" class="mt-2 text-3xl font-bold sm:text-4xl">Darjeeling, Sikkim and Dooars tours</h2>
      </div>
      <a href="/tour-packages/" class="font-semibold">All packages</a>
    </div>
    <div class="mt-8 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {PACKAGES.slice(0, 6).map((p) => <PackageCard pkg={p} />)}
    </div>
  </section>

  <ReviewsSlider />

  <section class="wrap mt-16" aria-labelledby="fleet">
    <p class="eyebrow">Our cars</p>
    <h2 id="fleet" class="mt-2 text-3xl font-bold sm:text-4xl">Choose the right car for the hills</h2>
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {VEHICLES.map((v) => (
        <div class="card p-5">
          <Icon name="car" class="h-7 w-7 text-pine" />
          <h3 class="mt-2 text-lg font-semibold">{v.name}</h3>
          <p class="text-sm text-muted">{v.models}</p>
          <p class="mt-3 text-sm"><strong class="text-ink">{v.seats} seats</strong> · {v.bags}</p>
          <p class="mt-2 text-sm">{v.bestFor}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="wrap mt-16" aria-labelledby="dest">
    <p class="eyebrow">Where we drive</p>
    <h2 id="dest" class="mt-2 text-3xl font-bold sm:text-4xl">Destinations across North Bengal and Sikkim</h2>
    <div class="mt-8 grid grid-cols-2 gap-3 sm:gap-4 md:grid-cols-4">
      {DESTINATIONS.map((d) => <DestinationTile d={d} />)}
    </div>
  </section>

  <section class="wrap">
    <FaqList faqs={GENERAL_FAQS} />
    <BookCta />
  </section>
</BaseLayout>
