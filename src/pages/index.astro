---
/**
 * The homepage, in the order a traveller decides and an answer engine reads:
 *   1. Hero: the promise, the fare checker, the proof chip.
 *   2. Trust strip: the four promises beside every Book button.
 *   3. Fares at a glance: the direct answer to "how much", then the routes.
 *   4. Fare board: every airport route, drifting.
 *   5. Cars: the fare depends on the car, so cars follow fares.
 *   6. Reviews: proof, once the price is known.
 *   7. How booking works.
 *   8. Booking ahead versus the airport counter.
 *   9. Tour packages.
 *  10. Destinations.
 *  11. Travel guides (the pages answer engines quote most).
 *  12. Why us: the people behind the fare.
 *  13. The journey as a story: six moments from arrivals to the drive home, no prices.
 *  14. Gallery, FAQ, book.
 * The direct answer sits in the first third of the page because that is where
 * answer engines take most of their quotes from.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import TrustStrip from '../components/TrustStrip.astro';
import RouteCard from '../components/RouteCard.astro';
import PackageCard from '../components/PackageCard.astro';
import FaqList from '../components/FaqList.astro';
import BookCta from '../components/BookCta.astro';
import Icon from '../components/Icon.astro';
import Photo from '../components/Photo.astro';
import QuickFare from '../components/QuickFare.astro';
import DestinationTile from '../components/DestinationTile.astro';
import GoogleRatingBadge from '../components/GoogleRatingBadge.astro';
import GoogleLogo from '../components/GoogleLogo.astro';
import Stars from '../components/Stars.astro';
import ReviewsSlider from '../components/ReviewsSlider.astro';
import SectionHead from '../components/SectionHead.astro';
import FareBoard from '../components/FareBoard.astro';
import PhotoMarquee from '../components/PhotoMarquee.astro';
import GuideCard from '../components/GuideCard.astro';
import JourneyStory from '../components/JourneyStory.astro';
import Words from '../components/Words.astro';
import { ROUTES, inr, lowestFare } from '../data/routes';
import { PACKAGES } from '../data/packages';
import { DESTINATIONS } from '../data/destinations';
import { GENERAL_FAQS } from '../data/faqs';
import { GALLERY } from '../data/gallery';
import { GUIDES } from '../data/guides';
import { GOOGLE } from '../data/reviews';
import { BUSINESS, SITE, waLink } from '../data/site';
import { VEHICLES } from '../data/vehicles';
import { faqPage } from '../lib/schema';
import { editAttr, words, wordsList, wordsText } from '../data/page-text';

const featured = ROUTES.filter((r) => r.fromShort === 'Bagdogra Airport').slice(0, 8);
const darj = ROUTES.find((r) => r.fromShort === 'Bagdogra Airport' && r.toShort === 'Darjeeling') ?? ROUTES[0];
const anchors = featured.slice(0, 3);
// A short, real five-star review for the hero; none while the cards are samples.
const heroReview = GOOGLE.isSample ? undefined : (GOOGLE.reviews.find((r) => r.rating === 5 && r.text.length < 200) ?? GOOGLE.reviews[0]);
// The words of every section are the "Home page" in the dashboard's Edit pages (src/data/page-text.ts).
const steps = ['step1', 'step2', 'step3', 'step4'];
const compare = ['row1', 'row2', 'row3', 'row4', 'row5'];
const carPhoto: Record<string, string> = { sedan: 'car-sedan', suv: 'car-suv', innova: 'car-innova', traveller: 'car-traveller' };
const since = new Date().getFullYear() - Number(BUSINESS.foundingYear);
const stats = [
  { label: 'statYears', value: since, suffix: '+' },
  { label: 'statRoutes', value: ROUTES.length, suffix: '' },
  { label: 'statPackages', value: PACKAGES.length, suffix: '' },
  ...(GOOGLE.count > 0 ? [{ label: 'statReviews', value: GOOGLE.count, suffix: '' }] : []),
];
const [leadGuide, ...moreGuides] = GUIDES;
---

<BaseLayout
  title={SITE.title}
  description={SITE.description}
  modified={SITE.contentUpdated}
  speakable={['#quick-answer', '#quick-answer-text', '#journey ol']}
  schema={[faqPage(GENERAL_FAQS, '/')]}
>
  <!-- Hero: one photograph edge to edge, one promise, one form; the content keeps to the page column. -->
  <section class="relative isolate overflow-hidden bg-ink text-white">
    <Photo name="hero" class="absolute inset-0 h-full w-full object-cover object-[center_40%]" sizes="100vw" loading="eager" fetchpriority="high" alt="" />
    <div class="absolute inset-0 bg-gradient-to-r from-ink/90 via-ink/60 to-ink/20" aria-hidden="true"></div>
    <div class="absolute inset-x-0 bottom-0 h-48 bg-gradient-to-t from-ink/80 to-transparent" aria-hidden="true"></div>
    <div class="wrap relative grid min-w-0 grid-cols-1 gap-8 pt-6 pb-24 sm:pt-8 lg:grid-cols-[minmax(0,1fr)_440px] lg:items-center lg:gap-10 lg:pt-8 lg:pb-24 xl:grid-cols-[minmax(0,1fr)_500px] xl:gap-12">
      <div class="min-w-0">
        <p class="inline-flex flex-wrap items-center gap-x-3 gap-y-1 rounded-full bg-white/10 px-3.5 py-1.5 text-sm font-semibold text-white ring-1 ring-white/20 backdrop-blur">
          <span class="inline-flex items-center gap-2"><span class="live-dot" aria-hidden="true"></span><Words page="home" field="heroBadge" /></span>
        </p>
        <!-- The h1 carries the search phrase; the romance moves to the line below it. -->
        <Words page="home" field="heroTitle" as="h1" accent="text-lime" class="display-xl mt-4 max-w-[14ch] font-extrabold tracking-tight text-white" />
        <Words page="home" field="heroLead" as="p" class="mt-4 max-w-xl text-lg leading-relaxed text-white/85" />
        <ul class="mt-4 flex flex-wrap gap-x-5 gap-y-1.5 text-sm font-medium text-white/90" aria-label="What is included" data-edit={editAttr('home', 'heroIncluded')}>
          {wordsList('home', 'heroIncluded').map((t) => <li class="flex items-center gap-1.5"><Icon name="check" class="h-4 w-4 text-lime" /> <Fragment set:html={t} /></li>)}
        </ul>
        <div class="mt-5 flex flex-wrap items-center gap-3">
          <a href="/book/" class="btn-lime lg:hidden"><Words page="home" field="heroBook" /> <Icon name="arrow" /></a>
          <a href={waLink('Hi, I would like to book a taxi from Bagdogra Airport.')} rel="noopener" class="btn-light"><Icon name="whatsapp" /> <Words page="home" field="heroWhatsapp" /></a>
          <GoogleRatingBadge variant="chip" dark />
        </div>
        <ul class="mt-4 flex flex-wrap items-center gap-2" aria-label="Popular fares">
          <Words page="home" field="heroPopular" as="li" class="mr-1 text-sm font-medium text-white/70" />
          {anchors.map((r) => <li><a href={`/taxi/${r.slug}/`} class="chip-light no-underline hover:bg-white/25">{r.toShort} <strong class="text-lime">{inr(lowestFare(r))}</strong></a></li>)}
          <li><a href="/taxi/" class="chip-light no-underline hover:bg-white/25"><Words page="home" field="heroAllFares" /></a></li>
        </ul>
        {heroReview && (
          <a href={heroReview.url || GOOGLE.url} target="_blank" rel="nofollow noopener" class="mt-4 hidden max-w-xl items-center gap-3 rounded-xl bg-white/10 p-2.5 pr-4 no-underline ring-1 ring-white/15 backdrop-blur transition-colors hover:bg-white/15 sm:flex">
            {heroReview.photo ? (
              <img src={heroReview.photo} alt="" width="40" height="40" loading="lazy" decoding="async" referrerpolicy="no-referrer" class="h-10 w-10 shrink-0 rounded-full bg-white/20 object-cover" />
            ) : (
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-lime text-sm font-bold text-ink" aria-hidden="true">{heroReview.author.slice(0, 1)}</span>
            )}
            <span class="min-w-0">
              <span class="flex flex-wrap items-center gap-x-2 gap-y-0.5 text-xs text-white/75"><GoogleLogo class="h-3.5 w-3.5" /><Stars rating={heroReview.rating} class="h-3 w-3" /><span class="font-semibold text-white">{heroReview.author}</span>{heroReview.relative && <span>· {heroReview.relative}</span>}</span>
              <span class="mt-0.5 line-clamp-1 text-sm leading-snug text-white/90">“{heroReview.text}”</span>
            </span>
          </a>
        )}
      </div>
      <QuickFare />
    </div>
  </section>

  <section class="wrap relative -mt-14 sm:-mt-16">
    <TrustStrip />
  </section>

  <!-- Fares at a glance: the question most visitors arrive with, answered in the first screen after the hero. -->
  <section class="wrap section" aria-labelledby="quick-answer">
    <div data-reveal>
      <SectionHead words="home:fares" id="quick-answer" linkHref="/taxi/" />
      <Words page="home" field="faresAnswer" as="p" class="answer mt-6 max-w-3xl" id="quick-answer-text" />
    </div>
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4" data-reveal-stagger>
      {featured.map((r) => <RouteCard route={r} />)}
    </div>
    <Words page="home" field="faresNote" as="p" class="mt-5 text-sm text-muted" />
  </section>

  <FareBoard />

  <!-- Cars: the fare depends on the car, so the cars come straight after the fares. -->
  <section class="wrap section" aria-labelledby="fleet">
    <div data-reveal><SectionHead words="home:fleet" id="fleet" /></div>
    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4" data-reveal-stagger>
      {VEHICLES.map((v) => (
        <a href={`/book/?vehicle=${v.key}`} class="card lift group overflow-hidden no-underline">
          <div class="aspect-[16/10] overflow-hidden bg-mist"><Photo name={carPhoto[v.key]} class="zoom h-full w-full object-cover" sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw" /></div>
          <div class="p-5">
            <h3 class="text-lg font-bold group-hover:text-lime-text">{v.name}</h3>
            <p class="text-sm text-muted">{v.models}</p>
            <p class="mt-3 flex flex-wrap gap-x-3 gap-y-1 text-sm"><strong class="text-ink">{v.seats} seats</strong><span class="text-muted">{v.bags}</span></p>
            <p class="mt-2 text-sm leading-snug text-body">{v.bestFor}</p>
            <p class="mt-3 text-sm text-body"><Words page="home" field="fleetFare" /> <strong class="text-ink">{inr(darj.fares[v.key])}</strong></p>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Reviews: proof, now that the price is known. -->
  <ReviewsSlider />

  <!-- How booking works -->
  <section class="relative isolate overflow-hidden bg-ink section text-white" aria-labelledby="how">
    <div class="wrap">
    <Photo name="pelling" class="absolute inset-0 h-full w-full object-cover opacity-35" sizes="(min-width: 1536px) 1500px, 100vw" alt="" />
    <div class="absolute inset-0 bg-gradient-to-b from-ink via-ink/70 to-ink" aria-hidden="true"></div>
    <div class="relative">
      <div data-reveal><SectionHead words="home:how" id="how" light /></div>
      <ol class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4" data-reveal-stagger>
        {steps.map((s, i) => (
          <li class="relative rounded-2xl border border-white/10 bg-white/5 p-6 backdrop-blur-sm transition-colors hover:border-lime/50 hover:bg-white/10">
            <span class="flex h-11 w-11 items-center justify-center rounded-full bg-lime font-[family-name:var(--font-display)] text-lg font-extrabold text-ink">{i + 1}</span>
            <Words page="home" field={`${s}Title`} as="h3" class="mt-5 text-lg font-semibold text-white" />
            <Words page="home" field={`${s}Text`} as="p" class="mt-1.5 text-sm leading-relaxed text-white/70" />
          </li>
        ))}
      </ol>
      <div class="mt-10 flex flex-wrap items-center gap-4">
        <a href="/book/" class="btn-lime"><Words page="home" field="howButton" /> <Icon name="arrow" /></a>
        <Words page="home" field="howNote" class="text-sm text-white/70" />
      </div>
    </div>
    </div>
  </section>

  <!-- Book ahead vs the airport counter -->
  <section class="bg-sand section" aria-labelledby="cmp">
    <div class="wrap">
      <div data-reveal>
        <SectionHead words="home:cmp" id="cmp" />
      </div>
      <div class="mt-8 overflow-hidden rounded-2xl border border-line bg-white" data-reveal>
        <div class="grid grid-cols-2 bg-ink text-white sm:grid-cols-[1fr_1.6fr_1.2fr]">
          <div class="hidden p-4 sm:block"><span class="sr-only">What</span></div>
          <div class="p-3 text-sm font-bold sm:p-4 sm:text-base"><span class="inline-flex items-center gap-2"><span class="h-2.5 w-2.5 rounded-full bg-lime"></span><Words page="home" field="cmpUs" /></span></div>
          <Words page="home" field="cmpThem" as="div" class="p-3 text-sm font-bold text-white/70 sm:p-4 sm:text-base" />
        </div>
        {compare.map((row) => (
          <div class="grid grid-cols-2 border-t border-line text-sm sm:grid-cols-[1fr_1.6fr_1.2fr]">
            <Words page="home" field={`${row}Label`} as="div" class="col-span-2 px-3 pt-3 text-[0.7rem] font-bold tracking-[0.12em] text-muted uppercase sm:col-span-1 sm:p-4 sm:text-sm sm:font-semibold sm:tracking-normal sm:normal-case sm:text-ink" />
            <div class="flex gap-2 bg-lime-50/60 p-3 text-ink sm:p-4"><Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-lime-text" /><Words page="home" field={`${row}Us`} /></div>
            <Words page="home" field={`${row}Them`} as="div" class="p-3 text-muted sm:p-4" />
          </div>
        ))}
      </div>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/book/" class="btn-book"><Words page="home" field="cmpButton" /> <Icon name="arrow" /></a>
        <a href="/guides/bagdogra-airport-transport-guide/" class="btn-ghost"><Words page="home" field="cmpGuide" /></a>
      </div>
    </div>
  </section>

  <!-- Packages -->
  <section class="wrap section" aria-labelledby="pk">
    <div data-reveal><SectionHead words="home:pk" id="pk" linkHref="/tour-packages/" /></div>
    <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3 2xl:grid-cols-4" data-reveal-stagger>
      {PACKAGES.slice(0, 8).map((p, i) => <PackageCard pkg={p} badge={i === 0 ? wordsText('home', 'pkBadge') : undefined} />)}
    </div>
  </section>

  <!-- Destinations -->
  <section class="bg-sand section" aria-labelledby="dest">
    <div class="wrap-wide">
      <div data-reveal><SectionHead words="home:dest" id="dest" linkHref="/destinations/" /></div>
      <div class="mt-10 grid grid-cols-2 gap-4 sm:gap-6 md:grid-cols-3 lg:grid-cols-4 3xl:grid-cols-6" data-reveal-stagger>
        {DESTINATIONS.map((d) => <DestinationTile d={d} />)}
        <a href="/book/" class="lift group relative flex aspect-[4/5] flex-col justify-end overflow-hidden rounded-[var(--radius-card)] bg-ink p-4 text-white no-underline sm:p-6">
          <span class="absolute -top-12 -right-12 h-48 w-48 rounded-full bg-lime/20 blur-2xl transition-transform duration-500 group-hover:scale-125" aria-hidden="true"></span>
          <Words page="home" field="elseEyebrow" class="relative block text-[0.7rem] font-bold tracking-[0.12em] text-lime uppercase" />
          <Words page="home" field="elseTitle" class="relative mt-1 block font-[family-name:var(--font-display)] text-xl leading-tight font-bold sm:text-2xl lg:text-[1.75rem]" />
          <Words page="home" field="elseText" class="relative mt-1.5 block text-sm leading-snug text-white/80 sm:text-[0.95rem]" />
          <span class="relative mt-3 inline-flex items-center gap-1.5 text-sm font-semibold text-lime sm:mt-4"><Words page="home" field="elseButton" /> <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">&rarr;</span></span>
        </a>
      </div>
    </div>
  </section>

  <!-- Travel guides: the pages that answer the questions travellers (and the assistants they ask) bring to us. -->
  <section class="wrap section" aria-labelledby="guides">
    <div data-reveal><SectionHead words="home:guides" id="guides" linkHref="/guides/" /></div>
    <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-[1.25fr_1fr_1fr]" data-reveal-stagger>
      <GuideCard guide={leadGuide} featured />
      {moreGuides.map((g) => <GuideCard guide={g} />)}
    </div>
  </section>

  <!-- Why us: the people behind the fare -->
  <section class="bg-sand section" aria-labelledby="why">
    <div class="wrap grid grid-cols-1 items-center gap-10 lg:grid-cols-2 lg:gap-16 2xl:gap-24">
      <div class="relative" data-reveal>
        <div class="overflow-hidden rounded-[28px] shadow-[var(--shadow-float)]">
          <Photo name="airport" class="aspect-[4/3] w-full object-cover" sizes="(min-width: 1024px) 50vw, 100vw" />
        </div>
        <div class="absolute -right-3 -bottom-5 w-44 overflow-hidden rounded-2xl border-4 border-white shadow-[var(--shadow-float)] sm:-right-6 sm:w-56 lg:w-64">
          <Photo name="car-innova" class="aspect-[4/3] w-full object-cover" sizes="256px" />
        </div>
        <div class="absolute -top-4 -left-3 hidden items-center gap-2 rounded-full bg-white px-3.5 py-2 text-sm font-semibold text-ink shadow-[var(--shadow-float)] sm:-left-5 sm:flex">
          <span class="live-dot" aria-hidden="true"></span> <Words page="home" field="whyBadge" />
        </div>
      </div>
      <div data-reveal style="--d: 120ms">
        <Words page="home" field="whyEyebrow" as="p" class="eyebrow" />
        <Words page="home" field="whyTitle" as="h2" id="why" class="display-lg mt-2 font-extrabold" />
        <Words page="home" field="whyText" as="p" class="mt-4 text-lg leading-relaxed" />
        <blockquote class="mt-6 border-l-4 border-lime pl-5">
          <p class="font-[family-name:var(--font-display)] text-xl font-semibold text-ink">“{BUSINESS.tagline}.”</p>
          <footer class="mt-1.5 text-sm text-muted"><cite class="not-italic">{BUSINESS.legalName}, on its <a href={GOOGLE.url} target="_blank" rel="noopener">Google Business Profile</a></cite></footer>
        </blockquote>
        <dl class="mt-8 grid grid-cols-2 gap-4 sm:grid-cols-4 lg:grid-cols-2 xl:grid-cols-4">
          {stats.map((s) => (
            <div class="card p-4">
              <Words page="home" field={s.label} as="dt" class="text-xs font-semibold tracking-wide text-muted uppercase" />
              <dd class="mt-1 font-[family-name:var(--font-display)] text-3xl font-extrabold text-ink tabular-nums" data-count={s.value} data-suffix={s.suffix}>{s.value}{s.suffix}</dd>
            </div>
          ))}
        </dl>
        <ul class="mt-8 space-y-3" data-edit={editAttr('home', 'whyList')}>
          {wordsList('home', 'whyList').map((t) => <li class="flex gap-3"><span class="mt-1 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-lime text-ink"><Icon name="check" class="h-3 w-3" /></span><span set:html={t} /></li>)}
        </ul>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/about/" class="btn-ghost"><Words page="home" field="whyAbout" /></a>
          <a href={BUSINESS.phoneHref} class="btn-ghost"><Icon name="phone" class="h-4 w-4 text-lime-text" /> {BUSINESS.phone}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- The journey as a story: how the trip feels, from touchdown to the drive home -->
  <JourneyStory />

  <!-- Gallery -->
  <section class="section overflow-hidden" aria-labelledby="gal">
    <div class="wrap" data-reveal>
      <SectionHead words="home:gal" id="gal" linkHref="/gallery/" />
    </div>
    <div class="mt-10" data-reveal style="--d: 100ms">
      <PhotoMarquee items={GALLERY} />
    </div>
  </section>

  <section class="wrap">
    <FaqList faqs={GENERAL_FAQS} heading={words('home', 'faqTitle')} headingEdit={editAttr('home', 'faqTitle')} edit="faq:main:list" />
    <BookCta />
  </section>
</BaseLayout>
