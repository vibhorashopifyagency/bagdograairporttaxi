---
import BaseLayout from '../layouts/BaseLayout.astro';
import TrustStrip from '../components/TrustStrip.astro';
import RouteCard from '../components/RouteCard.astro';
import PackageCard from '../components/PackageCard.astro';
import FaqList from '../components/FaqList.astro';
import BookCta from '../components/BookCta.astro';
import Icon from '../components/Icon.astro';
import Photo from '../components/Photo.astro';
import QuickFare from '../components/QuickFare.astro';
import DestinationTile from '../components/DestinationTile.astro';
import GoogleRatingBadge from '../components/GoogleRatingBadge.astro';
import GoogleLogo from '../components/GoogleLogo.astro';
import Stars from '../components/Stars.astro';
import ReviewsSlider from '../components/ReviewsSlider.astro';
import SectionHead from '../components/SectionHead.astro';
import FareBoard from '../components/FareBoard.astro';
import PhotoMarquee from '../components/PhotoMarquee.astro';
import { ROUTES, inr, lowestFare } from '../data/routes';
import { PACKAGES } from '../data/packages';
import { DESTINATIONS } from '../data/destinations';
import { GENERAL_FAQS } from '../data/faqs';
import { GALLERY } from '../data/gallery';
import { GOOGLE } from '../data/reviews';
import { BUSINESS, POLICY, SITE, waLink } from '../data/site';
import { VEHICLES } from '../data/vehicles';
import { faqPage, googleReviews } from '../lib/schema';

const featured = ROUTES.filter((r) => r.fromShort === 'Bagdogra Airport').slice(0, 8);
const darj = ROUTES[0];
const gtk = ROUTES[1];
const anchors = featured.slice(0, 3);
// A short, real five-star review for the hero; none while the cards are samples.
const heroReview = GOOGLE.isSample ? undefined : (GOOGLE.reviews.find((r) => r.rating === 5 && r.text.length < 200) ?? GOOGLE.reviews[0]);
const steps = [
  { title: 'Pick your route and car', text: 'See the full fare before you pay anything.' },
  { title: `Pay ${POLICY.advancePercent}% advance securely`, text: 'UPI, card or net banking. Instant WhatsApp confirmation.' },
  { title: 'Get your driver’s details', text: 'Name, photo and car number the evening before.' },
  { title: 'Meet at arrivals', text: 'Your driver waits with a name board, even if the flight is late.' },
];
const compare = [
  ['Fare', 'Fixed and shown before you fly, tolls and GST included', 'Fixed, but you only learn it at the counter'],
  ['Waiting', 'Driver at arrivals with your name board, flight tracked', 'Queue at the counter after every landing'],
  ['Car and driver', 'You choose the car; driver’s name and number sent the evening before', 'Whatever is next in line'],
  ['Payment', `${POLICY.advancePercent}% now by UPI or card, the rest after the trip`, 'Full fare up front, usually cash'],
  ['If plans change', `Free cancellation up to ${POLICY.freeCancelHours} hours before, refund in ${POLICY.refundDays} working days`, 'No booking to cancel, no car held for you'],
];
const carPhoto: Record<string, string> = { sedan: 'car-sedan', suv: 'car-suv', innova: 'car-innova', traveller: 'car-traveller' };
const since = new Date().getFullYear() - Number(BUSINESS.foundingYear);
const stats = [
  { label: 'Years on the road', value: since, suffix: '+' },
  { label: 'Fixed routes', value: ROUTES.length, suffix: '' },
  { label: 'Tour packages', value: PACKAGES.length, suffix: '' },
  ...(GOOGLE.count > 0 ? [{ label: 'Google reviews', value: GOOGLE.count, suffix: '' }] : []),
];
---

<BaseLayout title={SITE.title} description={SITE.description} schema={[faqPage(GENERAL_FAQS, '/'), ...googleReviews()]}>
  <!-- Hero: one photograph edge to edge, one promise, one form; the content keeps to the page column. -->
  <section class="relative isolate overflow-hidden bg-ink text-white">
    <Photo name="hero" class="absolute inset-0 h-full w-full object-cover object-[center_40%]" sizes="100vw" loading="eager" fetchpriority="high" alt="" />
    <div class="absolute inset-0 bg-gradient-to-r from-ink/90 via-ink/60 to-ink/20" aria-hidden="true"></div>
    <div class="absolute inset-x-0 bottom-0 h-48 bg-gradient-to-t from-ink/80 to-transparent" aria-hidden="true"></div>
    <div class="wrap relative grid min-w-0 grid-cols-1 gap-10 pt-8 pb-28 sm:pt-10 sm:pb-32 lg:grid-cols-[minmax(0,1fr)_420px] lg:items-center lg:gap-12 lg:pt-12 lg:pb-36 xl:grid-cols-[minmax(0,1fr)_460px] xl:gap-16">
      <div class="min-w-0 max-w-3xl">
        <p class="inline-flex flex-wrap items-center gap-x-3 gap-y-1 rounded-full bg-white/10 px-3.5 py-1.5 text-sm font-semibold text-white ring-1 ring-white/20 backdrop-blur">
          <span class="inline-flex items-center gap-2"><span class="live-dot" aria-hidden="true"></span>Drivers at Bagdogra Airport 24 hours a day</span>
        </p>
        <h1 class="display-xl mt-6 max-w-[12ch] font-extrabold tracking-tight text-white">
          Your ride into the{' '}
          <span class="text-lime">Himalayas</span>{' '}
          starts at arrivals.
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-white/85 sm:text-xl">
          Fixed-fare taxis from Bagdogra Airport and NJP to Darjeeling, Gangtok, Pelling and the Dooars. A verified local driver meets you with a name board, waits free for {POLICY.freeWaitMinutes} minutes if you land late, and you can cancel free up to {POLICY.freeCancelHours} hours before.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/book/" class="btn-lime">Book a taxi <Icon name="arrow" /></a>
          <a href={waLink('Hi, I would like to book a taxi from Bagdogra Airport.')} rel="noopener" class="btn-light"><Icon name="whatsapp" /> WhatsApp us</a>
        </div>
        <ul class="mt-6 flex flex-wrap gap-2" aria-label="Popular fares">
          {anchors.map((r) => <li><a href={`/taxi/${r.slug}/`} class="chip-light no-underline hover:bg-white/25">{r.toShort} <strong class="text-lime">{inr(lowestFare(r))}</strong></a></li>)}
          <li><a href="/taxi/" class="chip-light no-underline hover:bg-white/25">All {ROUTES.length} fares →</a></li>
        </ul>
        <div class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm font-medium text-white/85">
          <GoogleRatingBadge variant="chip" dark />
          <span class="flex items-center gap-1.5"><Icon name="check" class="h-4 w-4 text-lime" /> Tolls, parking and GST included</span>
          <span class="flex items-center gap-1.5"><Icon name="check" class="h-4 w-4 text-lime" /> Same car into Gangtok</span>
        </div>
        {heroReview && (
          <a href={heroReview.url || GOOGLE.url} target="_blank" rel="nofollow noopener" class="mt-6 hidden max-w-xl items-center gap-3 rounded-2xl bg-white/10 p-3 pr-4 no-underline ring-1 ring-white/15 backdrop-blur transition-colors hover:bg-white/15 sm:flex">
            {heroReview.photo ? (
              <img src={heroReview.photo} alt="" width="44" height="44" loading="lazy" decoding="async" referrerpolicy="no-referrer" class="h-11 w-11 shrink-0 rounded-full bg-white/20 object-cover" />
            ) : (
              <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-lime text-sm font-bold text-ink" aria-hidden="true">{heroReview.author.slice(0, 1)}</span>
            )}
            <span class="min-w-0">
              <span class="flex flex-wrap items-center gap-x-2 gap-y-0.5 text-xs text-white/75"><GoogleLogo class="h-3.5 w-3.5" /><Stars rating={heroReview.rating} class="h-3 w-3" /><span class="font-semibold text-white">{heroReview.author}</span>{heroReview.relative && <span>· {heroReview.relative}</span>}</span>
              <span class="mt-0.5 line-clamp-2 text-sm leading-snug text-white/90">“{heroReview.text}”</span>
            </span>
          </a>
        )}
      </div>
      <QuickFare />
    </div>
  </section>

  <section class="wrap relative -mt-16 sm:-mt-20">
    <TrustStrip />
  </section>

  <!-- Reviews, straight after the promise: proof before the prices. -->
  <ReviewsSlider tone="white" />

  <!-- Fares at a glance -->
  <section class="wrap section" aria-labelledby="quick-answer">
    <div data-reveal>
      <SectionHead eyebrow="Fares at a glance" id="quick-answer" title="How much is a taxi from Bagdogra Airport?" linkHref="/taxi/" linkLabel={`All ${ROUTES.length} fares`} />
      <p class="answer mt-6 max-w-3xl">
        A private taxi from Bagdogra Airport costs {inr(darj.fares.sedan)} to Darjeeling ({darj.km} km, {darj.duration}) and {inr(gtk.fares.sedan)} to Gangtok ({gtk.km} km, {gtk.duration}) in a sedan, one way. An Innova Crysta costs {inr(darj.fares.innova)} and {inr(gtk.fares.innova)}. Every fare includes tolls, parking, driver allowance and GST.
      </p>
    </div>
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4" data-reveal-stagger>
      {featured.map((r) => <RouteCard route={r} />)}
    </div>
    <p class="mt-5 text-sm text-muted">Night pickups ({POLICY.nightChargeFrom} to {POLICY.nightChargeTo}) add {inr(POLICY.nightCharge)}. That is the only extra, ever.</p>
  </section>

  <FareBoard />

  <!-- Book ahead vs the airport counter -->
  <section class="bg-sand section" aria-labelledby="cmp">
    <div class="wrap">
      <div data-reveal>
        <SectionHead eyebrow="Why book before you land" id="cmp" title="Booking ahead versus the airport prepaid counter" lead="The counter is fine if you are flexible. If you want a known fare, a named driver and no queue after a long flight, book ahead." />
      </div>
      <div class="mt-8 overflow-hidden rounded-2xl border border-line bg-white" data-reveal>
        <div class="grid grid-cols-2 bg-ink text-white sm:grid-cols-[1fr_1.6fr_1.2fr]">
          <div class="hidden p-4 sm:block"><span class="sr-only">What</span></div>
          <div class="p-3 text-sm font-bold sm:p-4 sm:text-base"><span class="inline-flex items-center gap-2"><span class="h-2.5 w-2.5 rounded-full bg-lime"></span>Booked with us</span></div>
          <div class="p-3 text-sm font-bold text-white/70 sm:p-4 sm:text-base">Prepaid counter</div>
        </div>
        {compare.map(([k, us, them]) => (
          <div class="grid grid-cols-2 border-t border-line text-sm sm:grid-cols-[1fr_1.6fr_1.2fr]">
            <div class="col-span-2 px-3 pt-3 text-[0.7rem] font-bold tracking-[0.12em] text-muted uppercase sm:col-span-1 sm:p-4 sm:text-sm sm:font-semibold sm:tracking-normal sm:normal-case sm:text-ink">{k}</div>
            <div class="flex gap-2 bg-lime-50/60 p-3 text-ink sm:p-4"><Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-lime-text" />{us}</div>
            <div class="p-3 text-muted sm:p-4">{them}</div>
          </div>
        ))}
      </div>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/book/" class="btn-book">Lock in my fare <Icon name="arrow" /></a>
        <a href="/guides/bagdogra-airport-transport-guide/" class="btn-ghost">Compare every option</a>
      </div>
    </div>
  </section>

  <!-- Why us: photo and the plain facts -->
  <section class="wrap section" aria-labelledby="why">
    <div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-2 lg:gap-16 2xl:gap-24">
      <div class="relative" data-reveal>
        <div class="overflow-hidden rounded-[28px] shadow-[var(--shadow-float)]">
          <Photo name="airport" class="aspect-[4/3] w-full object-cover" sizes="(min-width: 1024px) 50vw, 100vw" />
        </div>
        <div class="absolute -right-3 -bottom-5 w-44 overflow-hidden rounded-2xl border-4 border-white shadow-[var(--shadow-float)] sm:-right-6 sm:w-56 lg:w-64">
          <Photo name="car-innova" class="aspect-[4/3] w-full object-cover" sizes="256px" />
        </div>
        <div class="absolute -top-4 -left-3 hidden items-center gap-2 rounded-full bg-white px-3.5 py-2 text-sm font-semibold text-ink shadow-[var(--shadow-float)] sm:-left-5 sm:flex">
          <span class="live-dot" aria-hidden="true"></span> Office at {BUSINESS.address.locality}, open now
        </div>
      </div>
      <div data-reveal style="--d: 120ms">
        <p class="eyebrow">A local office, not a call centre</p>
        <h2 id="why" class="display-lg mt-2 font-extrabold">Drivers who know every bend between the airport and the hills</h2>
        <p class="mt-4 text-lg leading-relaxed">
          We are {BUSINESS.legalName}, based at {BUSINESS.address.locality}, minutes from the terminal, and have been driving travellers up to Darjeeling, Gangtok and beyond since {BUSINESS.foundingYear}. One phone number, answered around the clock, and a fare that is the same on every page of this site.
        </p>
        <dl class="mt-8 grid grid-cols-2 gap-4 sm:grid-cols-4 lg:grid-cols-2 xl:grid-cols-4">
          {stats.map((s) => (
            <div class="rounded-2xl bg-sand p-4">
              <dt class="text-xs font-semibold tracking-wide text-muted uppercase">{s.label}</dt>
              <dd class="mt-1 font-[family-name:var(--font-display)] text-3xl font-extrabold text-ink tabular-nums" data-count={s.value} data-suffix={s.suffix}>{s.value}{s.suffix}</dd>
            </div>
          ))}
        </dl>
        <ul class="mt-8 space-y-3">
          {[
            'Police-verified drivers trained for mountain roads',
            'Flight tracking: your driver adjusts to delays without being asked',
            'Written cancellation and refund policy, no small print',
            'Permits for Tsomgo, Nathula and North Sikkim arranged for you',
          ].map((t) => <li class="flex gap-3"><span class="mt-1 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-lime text-ink"><Icon name="check" class="h-3 w-3" /></span><span>{t}</span></li>)}
        </ul>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/about/" class="btn-ghost">About us</a>
          <a href={BUSINESS.phoneHref} class="btn-ghost"><Icon name="phone" class="h-4 w-4 text-lime-text" /> {BUSINESS.phone}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- How booking works -->
  <section class="relative isolate overflow-hidden bg-ink section text-white" aria-labelledby="how">
    <div class="wrap">
    <Photo name="pelling" class="absolute inset-0 h-full w-full object-cover opacity-35" sizes="(min-width: 1536px) 1500px, 100vw" alt="" />
    <div class="absolute inset-0 bg-gradient-to-b from-ink via-ink/70 to-ink" aria-hidden="true"></div>
    <div class="relative">
      <div data-reveal><SectionHead eyebrow="Secure booking in four steps" id="how" title="Booked in a minute. Confirmed on WhatsApp." light /></div>
      <ol class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4" data-reveal-stagger>
        {steps.map((s, i) => (
          <li class="relative rounded-2xl border border-white/10 bg-white/5 p-6 backdrop-blur-sm transition-colors hover:border-lime/50 hover:bg-white/10">
            <span class="flex h-11 w-11 items-center justify-center rounded-full bg-lime font-[family-name:var(--font-display)] text-lg font-extrabold text-ink">{i + 1}</span>
            <h3 class="mt-5 text-lg font-semibold text-white">{s.title}</h3>
            <p class="mt-1.5 text-sm leading-relaxed text-white/70">{s.text}</p>
          </li>
        ))}
      </ol>
      <div class="mt-10 flex flex-wrap items-center gap-4">
        <a href="/book/" class="btn-lime">Start booking <Icon name="arrow" /></a>
        <span class="text-sm text-white/70">Only {POLICY.advancePercent}% now. Free cancellation up to {POLICY.freeCancelHours} hours before.</span>
      </div>
    </div>
    </div>
  </section>

  <!-- Packages -->
  <section class="wrap section" aria-labelledby="pk">
    <div data-reveal><SectionHead eyebrow="Tour packages from Bagdogra" id="pk" title="Darjeeling, Sikkim and Dooars tours" lead="One private car and driver for the whole trip, hotels with breakfast and dinner, permits arranged. Day-wise plans you can read before you pay." linkHref="/tour-packages/" linkLabel={`All ${PACKAGES.length} packages`} /></div>
    <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3 2xl:grid-cols-4" data-reveal-stagger>
      {PACKAGES.slice(0, 8).map((p, i) => <PackageCard pkg={p} badge={i === 0 ? 'Our pick for a first visit' : undefined} />)}
    </div>
  </section>

  <!-- Cars -->
  <section class="wrap section" aria-labelledby="fleet">
    <div data-reveal><SectionHead eyebrow="Our cars" id="fleet" title="Choose the right car for the hills" lead="Every car is commercially registered, insured and cleaned before each pickup. Child seats on request." /></div>
    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4" data-reveal-stagger>
      {VEHICLES.map((v) => (
        <a href={`/book/?vehicle=${v.key}`} class="card lift group overflow-hidden no-underline">
          <div class="aspect-[16/10] overflow-hidden bg-mist"><Photo name={carPhoto[v.key]} class="zoom h-full w-full object-cover" sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw" /></div>
          <div class="p-5">
            <h3 class="text-lg font-bold group-hover:text-lime-text">{v.name}</h3>
            <p class="text-sm text-muted">{v.models}</p>
            <p class="mt-3 flex flex-wrap gap-x-3 gap-y-1 text-sm"><strong class="text-ink">{v.seats} seats</strong><span class="text-muted">{v.bags}</span></p>
            <p class="mt-2 text-sm leading-snug text-body">{v.bestFor}</p>
            <p class="mt-3 text-sm text-body">Darjeeling from <strong class="text-ink">{inr(darj.fares[v.key])}</strong></p>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Destinations -->
  <section class="bg-sand section" aria-labelledby="dest">
    <div class="wrap-wide">
      <div data-reveal><SectionHead eyebrow="Where we drive" id="dest" title="Destinations across North Bengal, Sikkim and Bhutan" linkHref="/destinations/" linkLabel="All guides" /></div>
      <div class="mt-10 grid grid-cols-2 gap-4 sm:gap-6 md:grid-cols-3 lg:grid-cols-4 3xl:grid-cols-6" data-reveal-stagger>
        {DESTINATIONS.map((d) => <DestinationTile d={d} />)}
        <a href="/book/" class="lift group relative flex aspect-[4/5] flex-col justify-end overflow-hidden rounded-[var(--radius-card)] bg-ink p-4 text-white no-underline sm:p-6">
          <span class="absolute -top-12 -right-12 h-48 w-48 rounded-full bg-lime/20 blur-2xl transition-transform duration-500 group-hover:scale-125" aria-hidden="true"></span>
          <span class="relative block text-[0.7rem] font-bold tracking-[0.12em] text-lime uppercase">Somewhere else?</span>
          <span class="relative mt-1 block font-[family-name:var(--font-display)] text-xl leading-tight font-bold sm:text-2xl lg:text-[1.75rem]">Name your place</span>
          <span class="relative mt-1.5 block text-sm leading-snug text-white/80 sm:text-[0.95rem]">We quote any route across the hills.</span>
          <span class="relative mt-3 inline-flex items-center gap-1.5 text-sm font-semibold text-lime sm:mt-4">Get a quote <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">&rarr;</span></span>
        </a>
      </div>
    </div>
  </section>

  <!-- Gallery -->
  <section class="section overflow-hidden" aria-labelledby="gal">
    <div class="wrap" data-reveal>
      <SectionHead eyebrow="Gallery" id="gal" title="The roads we drive, in pictures" lead="Tsomgo Lake, the toy train, Nathula, the Dooars: what a taxi from Bagdogra can take you to." linkHref="/gallery/" linkLabel={`All ${GALLERY.length} photos`} />
    </div>
    <div class="mt-10" data-reveal style="--d: 100ms">
      <PhotoMarquee items={GALLERY} />
    </div>
  </section>

  <section class="wrap">
    <FaqList faqs={GENERAL_FAQS} />
    <BookCta />
  </section>
</BaseLayout>
