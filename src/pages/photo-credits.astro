---
/**
 * Attribution for every photograph on the site, as the Creative Commons
 * licences require. Generated from src/data/photos.json.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Photo from '../components/Photo.astro';
import { PHOTOS } from '../lib/photos';
import Words from '../components/Words.astro';
import { wordsText } from '../data/page-text';
// The business's own photographs (own: true) need no attribution and are left out.
const entries = Object.entries(PHOTOS).filter(([, p]) => !p.own).sort(([a], [b]) => a.localeCompare(b));
---

<BaseLayout
  title={wordsText('photo-credits', 'seoTitle')}
  description={wordsText('photo-credits', 'seoDescription')}
  crumbs={[{ name: 'Photo credits', path: '/photo-credits/' }]}
  noindex
>
  <div class="wrap section">
    <Words page="photo-credits" field="title" as="h1" class="text-3xl font-extrabold sm:text-4xl" />
    <Words page="photo-credits" field="intro" as="p" class="mt-4 max-w-3xl text-lg" />
    <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {entries.map(([key, p]) => (
        <li class="card flex gap-4 p-3">
          <span class="h-20 w-28 shrink-0 overflow-hidden rounded-xl bg-mist"><Photo name={key} class="h-full w-full object-cover" sizes="112px" /></span>
          <span class="min-w-0 text-sm">
            <span class="block truncate font-semibold text-ink">{p.alt}</span>
            <span class="mt-1 block">By {p.artist}</span>
            <span class="mt-0.5 block">
              {p.licenseUrl ? <a href={p.licenseUrl} rel="license noopener" target="_blank">{p.license}</a> : p.license}
              {p.source && <> · <a href={p.source} rel="noopener" target="_blank">Source</a></>}
            </span>
          </span>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>
