---
/**
 * Attribution for every photograph on the site, as the Creative Commons
 * licences require. Generated from src/data/photos.json.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Photo from '../components/Photo.astro';
import { PHOTOS } from '../lib/photos';
const entries = Object.entries(PHOTOS).sort(([a], [b]) => a.localeCompare(b));
---

<BaseLayout
  title="Photo Credits: Photographers and Licences for Images on This Site"
  description="The photographers and Creative Commons licences for every photograph used on bagdograairporttaxi.com, with links to the originals on Wikimedia Commons."
  crumbs={[{ name: 'Photo credits', path: '/photo-credits/' }]}
  noindex
>
  <div class="wrap section">
    <h1 class="text-3xl font-extrabold sm:text-4xl">Photo credits</h1>
    <p class="mt-4 max-w-3xl text-lg">The landscape and car photographs on this site are by the photographers below, used under the licence shown. Each links to the original on Wikimedia Commons. Photos marked CC BY-SA may be reused under the same licence; please credit the photographer, not us.</p>
    <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {entries.map(([key, p]) => (
        <li class="card flex gap-4 p-3">
          <span class="h-20 w-28 shrink-0 overflow-hidden rounded-xl bg-mist"><Photo name={key} class="h-full w-full object-cover" sizes="112px" /></span>
          <span class="min-w-0 text-sm">
            <span class="block truncate font-semibold text-ink">{p.alt}</span>
            <span class="mt-1 block">By {p.artist}</span>
            <span class="mt-0.5 block">
              {p.licenseUrl ? <a href={p.licenseUrl} rel="license noopener" target="_blank">{p.license}</a> : p.license}
              {p.source && <> · <a href={p.source} rel="noopener" target="_blank">Source</a></>}
            </span>
          </span>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>
