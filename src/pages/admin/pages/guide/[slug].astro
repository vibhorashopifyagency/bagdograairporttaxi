---
/**
 * Everything in one travel guide: its title and short name, the short answer
 * and facts at the top, the main text (headings, paragraphs, notes, lists and
 * tables, in GuideBlocks), its questions, the booking box and WhatsApp
 * message, and its Google listing. Admin only; saves are drafts until
 * Publish, and Publish dates the guide "Updated" by itself. The fixed lines
 * around every guide are the "Every travel guide" page words.
 */
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import PublishBar from '../../../../components/admin/PublishBar.astro';
import WebField from '../../../../components/admin/WebField.astro';
import RowList from '../../../../components/admin/RowList.astro';
import GuideBlocks from '../../../../components/admin/GuideBlocks.astro';
import VersionHistory from '../../../../components/admin/VersionHistory.astro';
import { isAdmin } from '../../../../server/admin';
import { discardDraft, getEntry, listEntries, markForReset, saveDraft } from '../../../../server/content';
import { wasNotes } from '../../../../server/content-diff';
import { guideFromForm } from '../../../../server/content-forms';
import { ipHash } from '../../../../server/security';
import { GLOBAL_VARS, WORD_PAGES, guideVars } from '../../../../data/page-text';
import type { Guide } from '../../../../data/guides';
import '../../../../styles/admin-web.css';

export const prerender = false;

const user = Astro.locals.user!;
if (!isAdmin(user)) return Astro.redirect('/admin/', 303);
const ctx = { actorId: user.id, ipHash: ipHash(Astro.request) };
type Data = Record<string, any>;

const slug = Astro.params.slug!;
let entry = await getEntry('guide', slug);
if (!entry?.current) return Astro.redirect('/admin/pages/', 303);

let error = '';
let errorField = '';
let posted: Data | null = null;
if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  const intent = String(f.get('intent') ?? 'save');
  const here = (done: string) => Astro.redirect(`/admin/pages/guide/${slug}/?done=${done}`, 303);
  if (intent === 'discard') {
    await discardDraft(ctx, 'guide', slug);
    return here('discarded');
  }
  if (intent === 'reset') {
    const r = await markForReset(ctx, 'guide', slug);
    if (r.ok) return here('reset');
    error = r.error;
  }
  if (intent === 'save') {
    posted = guideFromForm(f, entry.current as Data);
    const r = await saveDraft(ctx, 'guide', slug, posted);
    if (r.ok) return here(r.message ? 'same' : 'saved');
    error = r.error;
    errorField = r.field ?? '';
  }
}
entry = (await getEntry('guide', slug))!;
const g: Data = posted ?? (entry.current as Data);
const was = wasNotes('guide', entry.live, entry.current);
const top = errorField.split('.')[0];
const err = (path: string) => (top === path ? error : undefined);
const errorIndex = top === 'body' ? Number(errorField.split('.')[1]) : undefined;
const done = Astro.url.searchParams.get('done');

const packages = (await listEntries('package')).filter((e) => e.current).map((e) => ({ slug: e.key, name: String((e.current as Data).name) }));
const BOOK_TARGETS = [
  { href: '/book/', name: 'The booking form' },
  { href: '/tour-packages/', name: 'All tour packages' },
  { href: '/taxi/', name: 'The fare chart' },
  { href: '/contact/', name: 'The contact page' },
  ...packages.map((p) => ({ href: `/tour-packages/${p.slug}/`, name: `Package: ${p.name}` })),
];
if (!BOOK_TARGETS.some((t) => t.href === g.bookHref)) BOOK_TARGETS.unshift({ href: g.bookHref, name: g.bookHref });

const own = guideVars(g as Guide);
const ownNames = Object.keys(WORD_PAGES['guide-page'].vars);
const ownFillIns = ownNames.filter((n) => n !== 'minutes');
const siteFillIns = Object.keys(GLOBAL_VARS);
const vars = { ...GLOBAL_VARS, ...own };
const usedHere = new Set((JSON.stringify(g).match(/\{([a-zA-Z0-9]+)\}/g) ?? []).map((t) => t.slice(1, -1)));
---

<AdminLayout title={String(g.title)}>
  <div class="flex flex-col gap-5">
    <PublishBar />
    <div class="flex flex-col gap-2">
      <nav aria-label="Breadcrumb" class="flex flex-wrap items-center gap-2 text-sm text-muted" data-chrome>
        <a href="/admin/pages/" class="font-semibold text-body">Edit pages</a><span aria-hidden="true">›</span><span>Travel guides</span>
      </nav>
      <div class="flex flex-wrap items-center gap-3">
        <h1 class="m-0 font-display text-[28px] font-bold lg:text-[34px]">{g.title}</h1>
        <span class:list={['web-state', entry.pending ? 'bg-[#fff4d6] text-[#8a5300]' : 'bg-lime-50 text-[#3f6200]']}>{entry.pending ? 'Draft, not live yet' : 'Live'}</span>
        <span class="flex-1"></span>
        <span class="flex gap-2" data-chrome>
          <a href={`/admin/pages/edit/?path=/guides/${slug}/`} class="btn-ghost min-h-10 px-4 py-1.5 text-sm">Edit on the page</a>
          <a href={`/guides/${slug}/`} target="_blank" rel="noopener" class="btn-ghost min-h-10 px-4 py-1.5 text-sm">Live page</a>
        </span>
      </div>
    </div>

    {done === 'saved' && <p class="a-msg a-msg-ok m-0" role="status">Saved as a draft. It goes on the website when you publish, and the guide's "Updated" date moves on by itself.</p>}
    {done === 'same' && <p class="a-msg a-msg-ok m-0" role="status">That is what the website already shows, so there was nothing to save.</p>}
    {done === 'discarded' && <p class="a-msg a-msg-ok m-0" role="status">Draft thrown away. This is what the website shows.</p>}
    {done === 'reset' && <p class="a-msg a-msg-ok m-0" role="status">It goes back to the starting copy when you publish.</p>}
    {done === 'restored' && <p class="a-msg a-msg-ok m-0" role="status">The earlier version is back as a draft. Publish to put it live.</p>}
    {error && <p class="a-msg a-msg-error m-0" role="alert">{error}</p>}

    <div class="flex flex-wrap items-start gap-5">
      <form method="post" data-web-form class="flex min-w-0 flex-[1_1_620px] flex-col gap-5">
        <input type="hidden" name="intent" value="save" />
        <section class="a-card flex flex-col gap-4 p-5 lg:p-6">
          <h2 class="m-0 font-display text-xl font-bold">Top of the guide</h2>
          <div id="title"><WebField label="Title" name="title" value={g.title} was={was.title} error={err('title')} count={[30, 70]} maxlength={90} help="The heading at the top of the guide and on guide cards." /></div>
          <div id="short"><WebField label="Short name" name="short" value={g.short} was={was.short} error={err('short')} maxlength={60} help="In the breadcrumb at the top and the footer's list of guides." /></div>
          <div id="summary"><WebField label="The short answer" name="summary" rows={5} value={g.summary} was={was.summary && 'Changed from what is live'} error={err('summary')} count={[160, 500]} maxlength={700} help="The answer at the top of the guide, which Google and AI answers quote. Fill-ins such as {darjeelingSedan} keep a fare in it right." /></div>
          <div id="facts" class="flex flex-col gap-2">
            <span class="wf-label">Facts in tiles under the answer</span>
            <RowList id="facts" noun="fact" addLabel="Add a fact" max={4} numbered cards was={was.facts} error={err('facts')} fields={[{ name: 'factLabel', label: 'Label', placeholder: 'Open' }, { name: 'factValue', label: 'Fact', placeholder: 'Wednesday to Sunday' }]} values={(g.facts ?? []).map((x: Data) => [x.label, x.value])} />
            <span class="wf-help">Up to four, each a short label and a fact.</span>
          </div>
        </section>

        <section class="a-card flex flex-col gap-3 p-5 lg:p-6" id="body">
          <div class="flex flex-col gap-1">
            <h2 class="m-0 font-display text-xl font-bold">The guide</h2>
            <p class="m-0 text-sm text-muted">Its parts in order. Each heading is a line in the guide's contents. Links, bold and fill-ins work in every box, tables included.</p>
          </div>
          <GuideBlocks blocks={g.body ?? []} was={Boolean(was.body)} error={err('body')} errorIndex={errorIndex} />
        </section>

        <section class="a-card flex flex-col gap-3 p-5 lg:p-6" id="faqs">
          <h2 class="m-0 font-display text-xl font-bold">Questions travellers ask</h2>
          <RowList id="faqs" noun="question" addLabel="Add a question" max={10} cards was={was.faqs} error={err('faqs')} fields={[{ name: 'faqQ', label: 'Question' }, { name: 'faqA', label: 'Answer', rows: 3 }]} values={(g.faqs ?? []).map((x: Data) => [x.q, x.a])} />
        </section>

        <section class="a-card flex flex-col gap-4 p-5 lg:p-6">
          <h2 class="m-0 font-display text-xl font-bold">Booking and WhatsApp</h2>
          <div id="askNote"><WebField label="Line in the dark “Ask our local team” card" name="askNote" rows={3} value={g.askNote} was={was.askNote && 'Changed from what is live'} error={err('askNote')} maxlength={300} /></div>
          <WebField label="Message already typed in WhatsApp" name="waText" value={g.waText} was={was.waText} error={err('waText')} maxlength={300} help="When a visitor taps WhatsApp on this guide. Plain words, no links." />
          <div id="ctaHeading"><WebField label="Booking box heading" name="ctaHeading" value={g.ctaHeading} was={was.ctaHeading} error={err('ctaHeading')} maxlength={100} help="The dark box at the bottom of the guide." /></div>
          <label class="wf">
            <span class="wf-label">The booking box's Book button opens</span>
            <select name="bookHref" class="wf-input">
              {BOOK_TARGETS.map((t) => <option value={t.href} selected={t.href === g.bookHref}>{t.name}</option>)}
            </select>
            {was.bookHref && <span class="wf-was">{was.bookHref}</span>}
          </label>
          <div class="flex flex-col gap-2" id="packages">
            <span class="wf-label">Tour packages shown after the guide</span>
            {was.packages && <span class="wf-was">Changed from what is live</span>}
            {err('packages') && <span class="wf-err">{err('packages')}</span>}
            <div class="flex flex-wrap gap-2">
              {packages.map((p) => (
                <label class="a-pill"><input type="checkbox" name="packages" value={p.slug} checked={(g.packages ?? []).includes(p.slug)} class="sr-only" /><span>{p.name}</span></label>
              ))}
            </div>
            <span class="wf-help">Up to three.</span>
          </div>
        </section>

        <section class="a-card flex flex-col gap-4 p-5 lg:p-6">
          <h2 class="m-0 font-display text-xl font-bold">Google listing</h2>
          <WebField label="Title in Google" name="seoTitle" value={g.seoTitle} was={was.seoTitle} error={err('seoTitle')} count={[30, 65]} maxlength={100} help="The blue link in Google and the browser tab. Usually tighter than the heading." />
          <WebField label="Search description" name="description" rows={3} value={g.description} was={was.description && 'Changed from what is live'} error={err('description')} count={[70, 160]} maxlength={170} help="Shown under the title in Google, and on guide cards." />
        </section>

        <div class="web-save">
          <span class="web-save-note"><span data-when-clean>Nothing changes on the website until you publish.</span><span data-when-dirty>You have changes that are not saved yet.</span></span>
          <button type="submit" class="btn-book min-h-12">Save as draft</button>
        </div>
      </form>
      <aside class="flex min-w-0 flex-[1_1_320px] flex-col gap-4 xl:sticky xl:top-4 xl:max-w-[400px]" data-chrome>
        {(entry.pending || entry.state === 'edited') && (
          <section class="a-card flex flex-col gap-2.5 p-5">
            {entry.pending === 'save' && <form method="post"><input type="hidden" name="intent" value="discard" /><button class="btn-ghost min-h-11 w-full">Discard my changes</button></form>}
            {entry.state === 'edited' && <form method="post"><input type="hidden" name="intent" value="reset" /><button class="btn-ghost min-h-11 w-full">Back to the starting copy</button></form>}
          </section>
        )}
        <section class="a-card flex flex-col gap-3 p-5" aria-labelledby="tw-marks">
          <h2 id="tw-marks" class="m-0 font-display text-lg font-bold">Links, bold and fill-ins</h2>
          <ul class="m-0 flex list-none flex-col gap-2 p-0 text-sm text-body">
            <li><code class="tw-code">[our fares](/taxi/)</code> a link</li>
            <li><code class="tw-code">**Nathula Pass**</code> bold</li>
            <li><code class="tw-code">{'{updated}'}</code> a fill-in: the live value, so it changes by itself</li>
          </ul>
          <p class="m-0 text-sm text-muted">A link must open a page on this website, or start with https://. Publish checks every one.</p>
        </section>
        <section class="a-card flex flex-col gap-2 p-5" aria-labelledby="tw-vars">
          <h2 id="tw-vars" class="m-0 font-display text-lg font-bold">Fill-ins for guides</h2>
          <p class="m-0 text-sm text-muted">Type one in {'{curly brackets}'} anywhere on this form.</p>
          <dl class="m-0 flex flex-col">
            {ownFillIns.map((n) => (
              <div class:list={['tw-var', usedHere.has(n) && 'is-used']}>
                <dt><code class="tw-code">{`{${n}}`}</code></dt>
                <dd class="m-0 min-w-0"><span class="block truncate font-semibold text-ink">{vars[n]?.text || '(empty here)'}</span><span class="block text-xs text-muted">{vars[n]?.label}</span></dd>
              </div>
            ))}
          </dl>
          <details class="tw-vars">
            <summary class="text-sm font-semibold">The {siteFillIns.length} for the whole site: fares, policies, business details</summary>
            <dl class="m-0 mt-2 flex flex-col">
              {siteFillIns.map((n) => (
                <div class:list={['tw-var', usedHere.has(n) && 'is-used']}>
                  <dt><code class="tw-code">{`{${n}}`}</code></dt>
                  <dd class="m-0 min-w-0"><span class="block truncate font-semibold text-ink">{vars[n]?.text || '(empty here)'}</span><span class="block text-xs text-muted">{vars[n]?.label}</span></dd>
                </div>
              ))}
            </dl>
          </details>
        </section>
        <VersionHistory type="guide" itemKey={slug} />
      </aside>
    </div>
  </div>
</AdminLayout>

<script>
  import { wireCounters, wireDirty, wireLists } from '../../../../lib/admin-web';
  wireLists();
  wireCounters();
  wireDirty();
</script>
