---
/**
 * Edit pages: every page of the website whose words come from the
 * dashboard, each with "Edit on the page" (the page editor,
 * /admin/pages/edit/) and its form. Admin only.
 */
import AdminLayout from '../../../layouts/AdminLayout.astro';
import PublishBar from '../../../components/admin/PublishBar.astro';
import { isAdmin } from '../../../server/admin';
import { getEntry, listEntries, type Entry } from '../../../server/content';
import '../../../styles/admin-web.css';

export const prerender = false;

const user = Astro.locals.user!;
if (!isAdmin(user)) return Astro.redirect('/admin/', 303);
type Data = Record<string, any>;

const [destinations, guides, packages, routes, faq] = await Promise.all([listEntries('destination'), listEntries('guide'), listEntries('package'), listEntries('route'), getEntry('faq', 'main')]);
const chip = (e: Entry | null | undefined): [string, string] | null => {
  if (!e) return null;
  if (e.pending === 'delete') return ['Comes off when you publish', 'bg-[#fde8e7] text-[#b42318]'];
  if (!e.live) return e.current ? ['New, not live yet', 'bg-[#e7f0ff] text-[#1d4ed8]'] : ['Off the website', 'bg-[#fde8e7] text-[#b42318]'];
  if (e.pending) return ['Draft', 'bg-[#fff4d6] text-[#8a5300]'];
  return null;
};
type Row = { name: string; path: string | null; form: string; e?: Entry | null; note?: string };
const nameOf = (e: Entry, f: (d: Data) => string) => f((e.current ?? e.live) as Data);
const groups: { title: string; text: string; rows: Row[]; add?: { href: string; label: string } }[] = [
  {
    title: 'Home and questions',
    text: 'The general questions show on the home page and the questions page. The home page’s search title is under Business details.',
    rows: [
      { name: 'General questions', path: '/faq/', form: '/admin/pages/faq/main/', e: faq },
      { name: 'Home page', path: '/', form: '/admin/business/?tab=search', note: 'Search title and description' },
      { name: 'Gallery page', path: '/gallery/', form: '/admin/photos/?tab=gallery', note: 'Photos, titles and links' },
    ],
  },
  {
    title: 'Destination guides',
    text: 'Opening answer, best time, days needed, highlights, how to reach, permits, questions and the photo.',
    rows: destinations.map((e) => ({ name: nameOf(e, (d) => d.name), path: e.current && e.live ? `/destinations/${e.key}/` : null, form: `/admin/pages/destination/${e.key}/`, e })),
    add: { href: '/admin/pages/destination/new/', label: 'Add a destination' },
  },
  {
    title: 'Travel guides',
    text: 'Title, search description and the short answer at the top.',
    rows: guides.map((e) => ({ name: nameOf(e, (d) => d.title), path: `/guides/${e.key}/`, form: `/admin/pages/guide/${e.key}/`, e })),
  },
  {
    title: 'Tour packages',
    text: 'Summary, day-by-day plan, what is included, questions, price and photo.',
    rows: packages.map((e) => ({ name: nameOf(e, (d) => d.name), path: e.current && e.live ? `/tour-packages/${e.key}/` : null, form: `/admin/fares/package/${e.key}/`, e })),
    add: { href: '/admin/fares/package/new/', label: 'Add a package' },
  },
  {
    title: 'Taxi routes',
    text: 'Opening answer, fares, stops, tips, questions and photo. All the fares at once are on Fares and packages.',
    rows: routes.map((e) => ({ name: nameOf(e, (d) => `${d.fromShort} to ${d.toShort}`), path: e.current && e.live ? `/taxi/${e.key}/` : null, form: `/admin/fares/route/${e.key}/`, e })),
    add: { href: '/admin/fares/route/new/', label: 'Add a route' },
  },
];
const done = Astro.url.searchParams.get('done');
const pen = '<path d="M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/>';
---

<AdminLayout title="Edit pages">
  <div class="flex flex-col gap-5">
    <PublishBar />
    <div class="flex max-w-3xl flex-col gap-1">
      <h1 class="m-0 font-display text-[28px] font-bold lg:text-[34px]">Edit pages</h1>
      <p class="m-0 text-body">Open a page and click what you want to change: the words change right there, and lists such as questions or the day-by-day plan open their form beside the page. Layout, colours and the order of sections stay as designed. Everything waits as a draft until you publish.</p>
    </div>
    {done === 'removed' && <p class="a-msg a-msg-ok m-0" role="status">It comes off the website when you publish.</p>}

    {groups.map((g) => (
      <section class="a-card flex flex-col p-5 lg:p-6" aria-labelledby={`pg-${g.title}`}>
        <div class="flex flex-wrap items-end justify-between gap-3 pb-3">
          <div class="flex min-w-0 flex-col">
            <h2 id={`pg-${g.title}`} class="m-0 font-display text-xl font-bold">{g.title} <span class="font-sans text-sm font-medium text-muted">{g.rows.length}</span></h2>
            <p class="m-0 text-sm text-muted">{g.text}</p>
          </div>
          {g.add && <a href={g.add.href} class="btn-ghost min-h-10 px-4 py-1.5 text-sm">+ {g.add.label}</a>}
        </div>
        <ul class="m-0 grid list-none grid-cols-1 gap-x-6 p-0 md:grid-cols-2">
          {g.rows.map((r) => {
            const c = chip(r.e);
            return (
              <li class="flex min-w-0 flex-wrap items-center gap-x-3 gap-y-1.5 border-t border-[#f0f1f3] py-2.5">
                <span class="flex min-w-0 flex-[1_1_200px] flex-col leading-snug">
                  <span class="truncate font-semibold">{r.name}</span>
                  <span class="truncate text-[13px] text-muted">{r.note ?? r.path ?? 'Not on the website yet'}</span>
                </span>
                {c && <span class:list={['a-badge', c[1]]}>{c[0]}</span>}
                {r.path && (
                  <a href={`/admin/pages/edit/?path=${encodeURIComponent(r.path)}`} class="btn-book min-h-10 gap-1.5 px-3.5 py-1 text-sm">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#a1e005" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={pen} />
                    On the page
                  </a>
                )}
                <a href={r.form} class="btn-ghost min-h-10 px-3.5 py-1 text-sm">Form</a>
              </li>
            );
          })}
        </ul>
      </section>
    ))}
  </div>
</AdminLayout>
