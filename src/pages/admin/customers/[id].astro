---
/**
 * One customer: how to reach them, every booking they have made (10, 25 or
 * 50 to a page), what they have paid, the office's notes about them (shared by
 * the team), and its stars and tags for picking who to send a new tour to
 * (src/server/customer-tags.ts). Opening this page is logged.
 */
import AdminLayout from '../../../layouts/AdminLayout.astro';
import Pager from '../../../components/admin/Pager.astro';
import { audit, isAdmin } from '../../../server/admin';
import { STATUS_LABEL, TONE, inr, todayIST, waText } from '../../../server/dashboard';
import { getDb, schema } from '../../../server/db';
import { advanceOf } from '../../../server/fares';
import { pageNumber, rowsFor } from '../../../server/paging';
import { paymentsByBooking, summarise } from '../../../server/payments';
import { RETENTION_MONTHS, eraseCustomer } from '../../../server/retention';
import { TAG_CLASS, listTags, saveRating, starText, tagsFor } from '../../../server/customer-tags';
import { ipHash } from '../../../server/security';
import { firstName, phoneLabel } from '../../../lib/itinerary-text';
import { desc, eq, sql } from 'drizzle-orm';

export const prerender = false;

const user = Astro.locals.user!;
const id = Astro.params.id ?? '';
const db = getDb();
const c = schema.customers;
const [customer] = /^[0-9a-f-]{36}$/.test(id) ? await db.select().from(c).where(eq(c.id, id)) : [];
if (!customer || customer.personalDataRemovedAt) return Astro.redirect('/admin/customers/', 303);

let error = '';
let eraseError = '';
let rateError = '';
let notes = customer.notes ?? '';
const admin = isAdmin(user);
if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  if (f.get('intent') === 'erase') {
    // Removing their details at their request: admin only, checked again inside eraseCustomer.
    const reason = f.get('reason') === 'duplicate' ? 'duplicate' : 'asked';
    if (f.get('confirm') !== 'yes') eraseError = 'Tick the box to confirm. This cannot be undone.';
    else {
      const r = await eraseCustomer(customer.id, reason, { actorId: user.id, ipHash: ipHash(Astro.request), role: user.role });
      if (r.ok) return Astro.redirect(`/admin/customers/?erased=${r.bookings}`, 303);
      eraseError = r.error;
      if (!admin) Astro.response.status = 403;
    }
  }
  if (f.get('intent') === 'rating') {
    rateError =
      (await saveRating(
        customer.id,
        { rating: String(f.get('rating') ?? ''), tagIds: f.getAll('tag').map(String), newTag: String(f.get('newTag') ?? ''), noOffers: f.get('noOffers') === '1' },
        { actorId: user.id, ipHash: ipHash(Astro.request) },
      )) ?? '';
    if (!rateError) return Astro.redirect(`/admin/customers/${customer.id}/?saved=rating#rating`, 303);
  }
  if (f.get('intent') === 'notes') {
    notes = String(f.get('notes') ?? '').trim();
    if (notes.length > 2000) error = 'Notes are limited to 2,000 characters.';
    else {
      await db.update(c).set({ notes: notes || null }).where(eq(c.id, customer.id));
      await audit({ actorId: user.id, action: 'customer_notes', entity: 'customer', entityId: customer.id, ipHash: ipHash(Astro.request) });
      return Astro.redirect(`/admin/customers/${customer.id}/?saved=1`, 303);
    }
  }
}

const b = schema.bookings;
const p = schema.payments;
const page = pageNumber(Astro.url);
const size = rowsFor(Astro.url, Astro.cookies);
// The totals cover every booking and are added up in the database; only one page of bookings is loaded.
const paidPer = db
  .select({ bookingId: p.bookingId, paid: sql<number>`sum(${p.amount})`.as('paid') })
  .from(p)
  .innerJoin(b, eq(p.bookingId, b.id))
  .where(eq(b.customerId, customer.id))
  .groupBy(p.bookingId)
  .as('paid_per');
const [[totals], bookings] = await Promise.all([
  db
    .select({
      bookings: sql<number>`count(*)::int`,
      trips: sql<number>`(count(*) filter (where ${b.status} = 'completed'))::int`,
      paid: sql<string>`coalesce(sum(${paidPer.paid}), 0)`,
      due: sql<string>`coalesce(sum(greatest(0, ${b.fareTotal} - coalesce(${paidPer.paid}, 0))) filter (where ${b.status} not in ('cancelled', 'no_show')), 0)`,
    })
    .from(b)
    .leftJoin(paidPer, eq(paidPer.bookingId, b.id))
    .where(eq(b.customerId, customer.id)),
  db
    .select()
    .from(b)
    .where(eq(b.customerId, customer.id))
    .orderBy(desc(b.pickupDate), desc(b.id))
    .limit(size)
    .offset((page - 1) * size),
]);
const [pays, allTags, tagsOf] = await Promise.all([paymentsByBooking(bookings.map((x) => x.id)), listTags(), tagsFor([customer.id])]);
const mine = new Set((tagsOf.get(customer.id) ?? []).map((t) => t.id));
await audit({ actorId: user.id, action: 'view_customer', entity: 'customer', entityId: customer.id, detail: { bookings: totals?.bookings ?? 0 }, ipHash: ipHash(Astro.request) });

const sums = bookings.map((x) => ({ x, pay: summarise(x.fareTotal, advanceOf(x.fareTotal), pays.get(x.id) ?? [], x.kind) }));
// Trips still to come, so removing their details on request is not done by accident before a pickup.
const [upcoming] = admin
  ? await db
      .select({ n: sql<number>`count(*)::int`, first: sql<string | null>`min(${b.pickupDate})` })
      .from(b)
      .where(sql`${b.customerId} = ${customer.id} and ${b.pickupDate} >= ${todayIST()} and ${b.status} not in ('cancelled', 'no_show', 'completed')`)
  : [];
const count = totals?.bookings ?? 0;
const pages = Math.max(1, Math.ceil(count / size));
const pageHref = (n: number) => `/admin/customers/${customer.id}/${n > 1 ? `?page=${n}` : ''}`;
const name = customer.name ?? 'No name';
const first = firstName(customer.name ?? '');
const day = new Intl.DateTimeFormat('en-IN', { timeZone: 'UTC', weekday: 'short', day: 'numeric', month: 'short', year: 'numeric' });
const since = new Intl.DateTimeFormat('en-IN', { timeZone: 'Asia/Kolkata', month: 'long', year: 'numeric' }).format(customer.createdAt);
const stats = [
  { k: 'Bookings', v: String(count) },
  { k: 'Trips completed', v: String(totals?.trips ?? 0) },
  { k: 'Paid so far', v: inr(Number(totals?.paid ?? 0)) },
  { k: 'Still to pay', v: inr(Number(totals?.due ?? 0)) },
];
---

<AdminLayout title={name}>
  <div class="flex flex-col gap-5 lg:gap-6">
    <a href="/admin/customers/" class="inline-flex min-h-11 items-center gap-1.5 self-start text-sm font-semibold text-body no-underline hover:text-ink">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
      All customers
    </a>

    <div class="flex flex-wrap items-center gap-4">
      <span class="grid h-16 w-16 shrink-0 place-items-center rounded-full bg-lime font-display text-2xl font-bold text-ink">{name[0]!.toUpperCase()}</span>
      <div class="flex min-w-0 flex-1 flex-col">
        <h1 class="m-0 font-display text-[28px] leading-tight font-bold lg:text-[34px]">{name}</h1>
        <span class="text-body">{customer.phone ? phoneLabel(customer.phone) : ''} · customer since {since}</span>
        {(customer.rating || mine.size > 0 || customer.noOffers) && (
          <a href="#rating" class="mt-1 flex flex-wrap items-center gap-1.5 self-start no-underline">
            {customer.rating && <span class="a-stars" aria-label={`${customer.rating} of 5 stars`}>{starText(customer.rating)}</span>}
            {(tagsOf.get(customer.id) ?? []).map((t) => <span class:list={['a-badge', TAG_CLASS[t.tone]]}>{t.name}</span>)}
            {customer.noOffers && <span class="a-badge bg-[#fde8e7] text-[#b42318]">No offers</span>}
          </a>
        )}
      </div>
      {customer.phone && (
        <div class="flex gap-2">
          <a href={`tel:+${customer.phone}`} class="btn-ghost">Call</a>
          <a href={waText(customer.phone, `Namaste ${first}, `)} target="_blank" rel="noopener" class="btn-wa">WhatsApp</a>
        </div>
      )}
    </div>

    <dl class="m-0 grid grid-cols-2 gap-3 lg:grid-cols-4">
      {stats.map((s, i) => (
        <div class:list={['flex flex-col-reverse gap-0.5 rounded-[20px] p-4 lg:p-5', i === 0 ? 'bg-ink text-white' : 'a-card']}>
          <dt class:list={['text-sm', i === 0 ? 'text-[#c9ced8]' : 'text-muted']}>{s.k}</dt>
          <dd class:list={['m-0 font-display text-[26px] leading-tight font-bold', i === 0 && 'text-lime']}>{s.v}</dd>
        </div>
      ))}
    </dl>

    <div class="grid gap-5 lg:grid-cols-[minmax(0,1fr)_minmax(320px,380px)] lg:gap-6">
      <section class="a-card min-w-0 self-start overflow-hidden" aria-labelledby="bk-h">
        <h2 id="bk-h" class="m-0 px-5 pt-5 pb-2 font-display text-xl font-bold">Bookings</h2>
        <ul class="m-0 list-none p-0">
          {sums.map(({ x, pay }) => (
            <li class="border-t border-[#f0f1f3]">
              <a href={`/admin/bookings/${x.ref}/`} class="flex flex-wrap items-center gap-x-4 gap-y-1 px-5 py-3.5 text-ink no-underline hover:bg-mist">
                <span class="flex min-w-0 flex-[1_1_260px] flex-col">
                  <span class="font-semibold">{x.tripName}</span>
                  <span class="text-sm text-muted"><span class="font-mono">{x.ref}</span> · {day.format(new Date(`${x.pickupDate}T00:00:00Z`))}, {x.pickupTime}</span>
                </span>
                <span class:list={['a-badge', TONE[STATUS_LABEL[x.status][1]]]}>{STATUS_LABEL[x.status][0]}</span>
                <span class="flex min-w-[120px] flex-col items-end">
                  <span class="font-bold">{inr(x.fareTotal)}</span>
                  <span class="text-[13px] text-muted">{pay.state === 'full' ? 'Fully paid' : pay.paid > 0 ? `${inr(pay.paid)} paid` : 'Nothing paid'}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
        {sums.length === 0 && <p class="m-0 border-t border-[#f0f1f3] px-5 py-4 text-body">Nothing on this page.</p>}
        <Pager
          class="border-t border-[#f0f1f3] px-5 py-4"
          prev={page > 1 ? pageHref(Math.min(page - 1, pages)) : null}
          next={page < pages ? pageHref(page + 1) : null}
          prevLabel="Later"
          nextLabel="Earlier"
          summary={`Page ${page} of ${pages}`}
          rows={{ current: size, href: (n) => `/admin/customers/${customer.id}/?rows=${n}` }}
        />
      </section>

      <div class="flex min-w-0 flex-col gap-5 self-start lg:gap-6">
      <section id="rating" class="a-card flex scroll-mt-24 flex-col gap-4 p-5" aria-labelledby="rate-h">
        <div class="flex items-baseline justify-between gap-3">
          <h2 id="rate-h" class="m-0 font-display text-xl font-bold">Rating and tags</h2>
          <a href="/admin/customers/?tags=1" class="text-sm font-semibold text-ink">Manage tags</a>
        </div>
        {Astro.url.searchParams.get('saved') === 'rating' && <p class="a-msg a-msg-ok m-0" role="status">Saved.</p>}
        {rateError && <p class="a-msg a-msg-error m-0" role="alert">{rateError}</p>}
        <form method="post" class="flex flex-col gap-4">
          <input type="hidden" name="intent" value="rating" />
          <fieldset class="m-0 flex flex-col gap-1.5 border-0 p-0">
            <legend class="mb-1 text-[15px] font-semibold">How good a customer {first ? `was ${first}` : 'were they'}?</legend>
            <div class="flex flex-wrap items-center gap-3">
              <span class="a-rate">
                {[5, 4, 3, 2, 1].map((n) => (
                  <>
                    <input type="radio" name="rating" id={`rate-${n}`} value={String(n)} checked={customer.rating === n} />
                    <label for={`rate-${n}`} title={`${n} of 5`}><span class="sr-only">{n} of 5 stars</span><span aria-hidden="true">★</span></label>
                  </>
                ))}
              </span>
              <label class="flex min-h-11 items-center gap-2 text-sm text-body"><input type="radio" name="rating" value="" checked={!customer.rating} class="h-4 w-4 accent-[#111111]" /> Not rated</label>
            </div>
            <span class="text-[13px] text-muted">5 a delight to drive, 1 not again. Only the office sees it.</span>
          </fieldset>
          <fieldset class="m-0 flex flex-col gap-2 border-0 p-0">
            <legend class="mb-1 text-[15px] font-semibold">Tags</legend>
            <div class="flex flex-wrap gap-2">
              {allTags.map((t) => (
                <label class="a-tag"><input type="checkbox" name="tag" value={t.id} checked={mine.has(t.id)} class="sr-only" /><span class={TAG_CLASS[t.tone]}>{t.name}</span></label>
              ))}
            </div>
            <label class="a-field"><span class="text-sm font-normal text-muted">Or a new tag</span><input name="newTag" maxlength="30" placeholder="Trekkers" autocomplete="off" /></label>
          </fieldset>
          <label class="flex items-start gap-2.5 rounded-xl bg-mist p-3 text-sm">
            <input type="checkbox" name="noOffers" value="1" checked={customer.noOffers} class="mt-0.5 h-5 w-5 shrink-0 accent-[#b42318]" />
            <span><strong class="text-ink">No offers.</strong> They asked us not to send new tours or offers. They are left out of Send an offer and the number list.</span>
          </label>
          <button type="submit" class="btn-book self-start">Save rating and tags</button>
        </form>
      </section>

      <section class="a-card flex flex-col gap-3 p-5" aria-labelledby="notes-h">
        <h2 id="notes-h" class="m-0 font-display text-xl font-bold">Notes</h2>
        {Astro.url.searchParams.get('saved') === '1' && <p class="a-msg a-msg-ok m-0" role="status">Saved.</p>}
        {error && <p class="a-msg a-msg-error m-0" role="alert">{error}</p>}
        <form method="post" class="flex flex-col gap-3">
          <input type="hidden" name="intent" value="notes" />
          <label class="a-field"><span class="sr-only">Notes about {name}</span><textarea name="notes" rows="6" maxlength="2000" placeholder="Prefers an Innova. Travels with elderly parents. Pays by UPI.">{notes}</textarea></label>
          <button type="submit" class="btn-book self-start">Save notes</button>
        </form>
        <p class="m-0 text-sm text-muted">Shared with the whole team. Keep to what helps the next trip; the customer can ask to see what we hold.</p>
      </section>

      <section class="a-card flex flex-col gap-3 p-5" aria-labelledby="privacy-h">
        <h2 id="privacy-h" class="m-0 font-display text-xl font-bold">Their data</h2>
        <p class="m-0 text-sm text-body">Name and number are removed by themselves {RETENTION_MONTHS} months after the last trip. A customer may ask sooner to see what we hold, or to have it removed.</p>
        {eraseError && <p class="a-msg a-msg-error m-0" role="alert">{eraseError}</p>}
        {admin ? (
          <div class="flex flex-wrap gap-2">
            <a href={`/admin/customers/${customer.id}/export.txt`} class="btn-ghost min-h-11 px-4 py-2 text-sm" download>Download what we hold</a>
            <button type="button" class="btn-ghost min-h-11 border-[#f3b8b2] px-4 py-2 text-sm text-[#b42318] hover:border-[#b42318]" data-open="erase-dlg">Remove their details…</button>
          </div>
        ) : (
          <p class="m-0 text-sm text-muted">If they ask to see or remove their details, tell the admin: only the admin can do it.</p>
        )}
      </section>
      </div>
    </div>
  </div>

  {admin && (
    <dialog id="erase-dlg" class="a-dialog a-dialog-sm" aria-labelledby="erase-title" data-autoopen={eraseError ? '' : undefined}>
      <form method="post" class="a-dialog-body">
        <input type="hidden" name="intent" value="erase" />
        <div class="a-dialog-head">
          <h2 id="erase-title" class="m-0 font-display text-xl font-bold">Remove {name}’s details?</h2>
          <button type="button" data-close class="a-icon-btn" aria-label="Close"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12" /></svg></button>
        </div>
        <div class="a-dialog-main flex flex-col gap-4">
          <p class="m-0 text-body">Their name, mobile number, drop addresses, flight numbers and notes go from {count === 1 ? 'their one booking' : `all ${count} of their bookings`}, and any itinerary you sent them stops working. Trip, fare and payment amounts stay, so the accounts still add up. <strong class="text-ink">This cannot be undone.</strong></p>
          {upcoming && upcoming.n > 0 && (
            <p class="a-msg a-msg-error m-0">They have {upcoming.n} {upcoming.n === 1 ? 'trip' : 'trips'} still to come{upcoming.first ? `, the first on ${day.format(new Date(`${upcoming.first}T00:00:00Z`))}` : ''}. After this, the office and the driver cannot see who to pick up or how to call them.</p>
          )}
          <p class="m-0 text-sm text-body">Download what we hold first if they asked to see it.</p>
          <fieldset class="m-0 flex flex-col gap-2 border-0 p-0">
            <legend class="mb-1 text-sm font-semibold">Why</legend>
            <label class="flex min-h-11 items-center gap-2.5"><input type="radio" name="reason" value="asked" checked class="h-5 w-5 accent-[#111111]" /> The customer asked us to remove them</label>
            <label class="flex min-h-11 items-center gap-2.5"><input type="radio" name="reason" value="duplicate" class="h-5 w-5 accent-[#111111]" /> A test or duplicate entry</label>
          </fieldset>
          <label class="flex items-start gap-2.5 rounded-xl bg-mist p-3"><input type="checkbox" name="confirm" value="yes" required class="mt-0.5 h-5 w-5 accent-[#b42318]" /> <span>I understand this cannot be undone.</span></label>
        </div>
        <div class="a-dialog-foot">
          <button type="button" data-close class="btn-ghost">Keep them</button>
          <button type="submit" class="btn-book bg-[#b42318] hover:bg-[#8f1d14]">Remove their details</button>
        </div>
      </form>
    </dialog>
  )}
</AdminLayout>

<script>
  import { openDialogs } from '../../../lib/admin-client';
  openDialogs();
</script>
