---
/**
 * Everyone who has booked, most recent first, one row per mobile number,
 * a page at a time (10, 25 or 50 rows), with search and a date range on
 * when they last booked. Opening this page is logged, because it lists
 * names and numbers.
 */
import AdminLayout from '../../../layouts/AdminLayout.astro';
import ListFilters from '../../../components/admin/ListFilters.astro';
import Pager from '../../../components/admin/Pager.astro';
import { audit } from '../../../server/admin';
import { addDays, inr, istMidnight, todayIST } from '../../../server/dashboard';
import { getDb, schema } from '../../../server/db';
import { cursorField, dateFilter, listHref, pageFrom, pageQuery, pageResult, rowsFor, withParams, type SortKey } from '../../../server/paging';
import { ipHash } from '../../../server/security';
import { phoneLabel } from '../../../lib/itinerary-text';
import { and, eq, ilike, inArray, isNull, or, sql, type SQL } from 'drizzle-orm';

export const prerender = false;

const user = Astro.locals.user!;
const q = (Astro.url.searchParams.get('q') ?? '').trim().slice(0, 60);
const c = schema.customers;
const b = schema.bookings;
const digits = q.replace(/\D/g, '');
let search: SQL | undefined;
if (q) {
  const like = `%${q.replace(/[%_\\]/g, '\\$&')}%`;
  search = or(ilike(c.name, like), digits.length >= 4 ? ilike(c.phone, `%${digits}%`) : undefined);
}

// Same expression as the customers_recent_idx index, so a page (and a date range) is read straight from it.
const lastBooked = sql`coalesce(${c.lastBookingAt}, ${c.createdAt})`;
const { from, to } = dateFilter(Astro.url);
const inRange = and(from ? sql`${lastBooked} >= ${istMidnight(from)}` : undefined, to ? sql`${lastBooked} < ${istMidnight(addDays(to, 1))}` : undefined);
const size = rowsFor(Astro.url, Astro.cookies);
const key: SortKey = { cols: [lastBooked, sql`${c.id}`], types: ['timestamptz', 'uuid'], order: 'desc' };
const page = pageFrom(Astro.url, key);
const pq = pageQuery(key, page, size);
const db = getDb();
const fetched = await db
  .select({ id: c.id, name: c.name, phone: c.phone, last: c.lastBookingAt, notes: c.notes, cursor: cursorField(key) })
  .from(c)
  .where(and(isNull(c.personalDataRemovedAt), search, inRange, pq.where))
  .orderBy(...pq.orderBy)
  .limit(pq.limit);
const list = pageResult(fetched, page, listHref('/admin/customers/', { q, from, to }), size);

// Totals for this page's customers only, so the work stays the same however many there are.
const ids = list.rows.map((r) => r.id);
const p = schema.payments;
const [totals, paidRows] = ids.length
  ? await Promise.all([
      db
        .select({
          id: b.customerId,
          bookings: sql<number>`count(*)::int`,
          trips: sql<number>`(count(*) filter (where ${b.status} = 'completed'))::int`,
          nextTrip: sql<string | null>`min(${b.pickupDate}) filter (where ${b.pickupDate} >= ${todayIST()} and ${b.status} not in ('cancelled', 'no_show'))`,
        })
        .from(b)
        .where(inArray(b.customerId, ids))
        .groupBy(b.customerId),
      db
        .select({ id: b.customerId, paid: sql<string>`coalesce(sum(${p.amount}), 0)` })
        .from(p)
        .innerJoin(b, eq(p.bookingId, b.id))
        .where(inArray(b.customerId, ids))
        .groupBy(b.customerId),
    ])
  : [[], []];
const totalOf = new Map(totals.map((t) => [t.id, t]));
const paidOf = new Map(paidRows.map((t) => [t.id, Number(t.paid)]));
const rows = list.rows.map((r) => ({ ...r, bookings: totalOf.get(r.id)?.bookings ?? 0, trips: totalOf.get(r.id)?.trips ?? 0, nextTrip: totalOf.get(r.id)?.nextTrip ?? null, paid: paidOf.get(r.id) ?? 0 }));
await audit({ actorId: user.id, action: 'view_customers', entity: 'customers', detail: { count: rows.length, q: q || undefined, from: from ?? undefined, to: to ?? undefined }, ipHash: ipHash(Astro.request) });

const day = new Intl.DateTimeFormat('en-IN', { timeZone: 'UTC', day: 'numeric', month: 'short', year: 'numeric' });
const when = new Intl.DateTimeFormat('en-IN', { timeZone: 'Asia/Kolkata', day: 'numeric', month: 'short', year: 'numeric' });
---

<AdminLayout title="Customers">
  <div class="flex flex-col gap-5">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <h1 class="m-0 font-display text-[28px] font-bold lg:text-3xl">Customers</h1>
        <p class="m-0 mt-1 text-sm text-muted">One entry per mobile number, so a returning customer is recognised however they type it.</p>
      </div>
      <form method="get" class="flex w-full gap-2 sm:w-auto" role="search">
        {from && <input type="hidden" name="from" value={from} />}
        {to && <input type="hidden" name="to" value={to} />}
        <label class="a-field flex-1"><span class="sr-only">Search customers</span><input name="q" type="search" value={q} placeholder="Name or mobile number" class="w-full sm:w-72" /></label>
        <button class="btn-book" type="submit">Search</button>
      </form>
    </div>

    <ListFilters
      dateLabel="Last booked"
      presets={['last7', 'last30', 'thisMonth', 'lastMonth']}
      from={from}
      to={to}
      keep={{ q }}
      clearHref={listHref('/admin/customers/', { q })(null)}
      rows={size}
      rowsHref={(n) => withParams(Astro.url, { rows: String(n) })}
    />

    {rows.length === 0 ? (
      <div class="a-card p-8 text-body">{page.cursor ? 'Nothing more on this page.' : q || from || to ? 'No customers match that.' : 'No customers yet. Everyone who books appears here.'}</div>
    ) : (
      <div class="a-card overflow-x-auto">
        <table class="a-table">
          <thead><tr><th>Customer</th><th>Bookings</th><th>Next trip</th><th>Paid so far</th><th>Last booked</th></tr></thead>
          <tbody>
            {rows.map((r) => (
              <tr>
                <td data-label="Customer">
                  <a href={`/admin/customers/${r.id}/`} class="font-semibold text-ink no-underline hover:underline">{r.name ?? 'No name'}</a>
                  {r.phone && <span class="block text-sm text-muted">{phoneLabel(r.phone)}</span>}
                  {r.notes && <span class="mt-0.5 block max-w-[34ch] truncate text-sm text-body">{r.notes}</span>}
                </td>
                <td data-label="Bookings">
                  <strong>{r.bookings}</strong>
                  {r.bookings > 1 && <span class="a-badge ml-2 bg-lime-50 text-[#3f6200]">Returning</span>}
                  {r.trips > 0 && <span class="block text-sm text-muted">{r.trips} completed</span>}
                </td>
                <td class="whitespace-nowrap" data-label="Next trip">{r.nextTrip ? day.format(new Date(`${r.nextTrip}T00:00:00Z`)) : <span class="text-muted">None booked</span>}</td>
                <td class="whitespace-nowrap font-semibold" data-label="Paid so far">{inr(r.paid)}</td>
                <td class="whitespace-nowrap text-sm text-body" data-label="Last booked">{r.last ? when.format(r.last) : '—'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}

    <Pager prev={list.newer} next={list.older} start={list.start} prevLabel="More recent" nextLabel="Earlier" />
  </div>
</AdminLayout>
