---
/**
 * Everyone who has booked, most recent first, one row per mobile number,
 * a page at a time (10, 25 or 50 rows), with search, a date range on when
 * they last booked, and the office's stars and tags (src/server/customer-tags.ts).
 * `?send=1` turns the list into the "Send an offer" list: a message box and
 * a WhatsApp button on each customer who has not asked us to stop; the admin
 * can also copy or download every number in the filter. `?tags=1` opens the
 * tag manager. Opening this page is logged, because it lists names and numbers.
 */
import AdminLayout from '../../../layouts/AdminLayout.astro';
import ListFilters from '../../../components/admin/ListFilters.astro';
import FilterSelect from '../../../components/admin/FilterSelect.astro';
import EmptyState from '../../../components/admin/EmptyState.astro';
import Pager from '../../../components/admin/Pager.astro';
import { SITE } from '../../../data/site';
import { audit, isAdmin } from '../../../server/admin';
import {
  RATING_FILTERS,
  TAG_CLASS,
  TONE_NAME,
  addTag,
  changeTag,
  customerWhere,
  deleteTag,
  lastBookedSql,
  listTags,
  readCustomerFilters,
  starText,
  tagsFor,
  type Tag,
} from '../../../server/customer-tags';
import { inr, todayIST } from '../../../server/dashboard';
import { getDb, schema } from '../../../server/db';
import { TAG_TONES } from '../../../server/db/schema';
import { cursorField, listHref, pageFrom, pageQuery, pageResult, rowsFor, withParams, type SortKey } from '../../../server/paging';
import { ipHash } from '../../../server/security';
import { firstName, phoneLabel } from '../../../lib/itinerary-text';
import { and, eq, inArray, sql } from 'drizzle-orm';

export const prerender = false;

const user = Astro.locals.user!;
const admin = isAdmin(user);
const ctx = { actorId: user.id, ipHash: ipHash(Astro.request) };

// The tag manager's forms post here and come back to the same list.
let tagError = '';
if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  const intent = String(f.get('intent') ?? '');
  const id = String(f.get('id') ?? '');
  const name = String(f.get('name') ?? '');
  const tone = String(f.get('tone') ?? '');
  let done = '';
  if (intent === 'tag-add') {
    const r = await addTag(name, tone, ctx);
    if ('error' in r) tagError = r.error;
    else done = 'added';
  } else if (intent === 'tag-change') {
    tagError = (await changeTag(id, name, tone, ctx)) ?? '';
    if (!tagError) done = 'saved';
  } else if (intent === 'tag-delete') {
    await deleteTag(id, ctx);
    done = 'deleted';
  }
  if (done) return Astro.redirect(withParams(Astro.url, { tags: '1', tagdone: done }), 303);
}

const filters = readCustomerFilters(Astro.url);
const { q, from, to, rating, tag } = filters;
const sending = Astro.url.searchParams.get('send') === '1';
const keep = { q, from, to, rating, tag, send: sending ? '1' : null };
const c = schema.customers;
const b = schema.bookings;
const where = customerWhere(filters);
const size = rowsFor(Astro.url, Astro.cookies);
const key: SortKey = { cols: [lastBookedSql, sql`${c.id}`], types: ['timestamptz', 'uuid'], order: 'desc' };
const page = pageFrom(Astro.url, key);
const pq = pageQuery(key, page, size);
const db = getDb();
const [fetched, tags, [reach]] = await Promise.all([
  db
    .select({ id: c.id, name: c.name, phone: c.phone, last: c.lastBookingAt, notes: c.notes, rating: c.rating, noOffers: c.noOffers, cursor: cursorField(key) })
    .from(c)
    .where(and(where, pq.where))
    .orderBy(...pq.orderBy)
    .limit(pq.limit),
  listTags(),
  // How many in the whole filter (every page) can get an offer, for the send box.
  sending
    ? db
        .select({ all: sql<number>`count(*)::int`, skipped: sql<number>`(count(*) filter (where ${c.noOffers} or ${c.phone} is null))::int` })
        .from(c)
        .where(where)
    : [null],
]);
const list = pageResult(fetched, page, listHref('/admin/customers/', keep), size);

// Totals for this page's customers only, so the work stays the same however many there are.
const ids = list.rows.map((r) => r.id);
const p = schema.payments;
const [totals, paidRows, tagsOf] = ids.length
  ? await Promise.all([
      db
        .select({
          id: b.customerId,
          bookings: sql<number>`count(*)::int`,
          trips: sql<number>`(count(*) filter (where ${b.status} = 'completed'))::int`,
          nextTrip: sql<string | null>`min(${b.pickupDate}) filter (where ${b.pickupDate} >= ${todayIST()} and ${b.status} not in ('cancelled', 'no_show'))`,
        })
        .from(b)
        .where(inArray(b.customerId, ids))
        .groupBy(b.customerId),
      db
        .select({ id: b.customerId, paid: sql<string>`coalesce(sum(${p.amount}), 0)` })
        .from(p)
        .innerJoin(b, eq(p.bookingId, b.id))
        .where(inArray(b.customerId, ids))
        .groupBy(b.customerId),
      tagsFor(ids),
    ])
  : [[], [], new Map<string, Tag[]>()];
const totalOf = new Map(totals.map((t) => [t.id, t]));
const paidOf = new Map(paidRows.map((t) => [t.id, Number(t.paid)]));
const rows = list.rows.map((r) => ({ ...r, tags: tagsOf.get(r.id) ?? [], bookings: totalOf.get(r.id)?.bookings ?? 0, trips: totalOf.get(r.id)?.trips ?? 0, nextTrip: totalOf.get(r.id)?.nextTrip ?? null, paid: paidOf.get(r.id) ?? 0 }));
await audit({ actorId: user.id, action: 'view_customers', entity: 'customers', detail: { count: rows.length, q: q || undefined, from: from ?? undefined, to: to ?? undefined, rating: rating ?? undefined, tag: tag ?? undefined, send: sending || undefined }, ipHash: ctx.ipHash });

/** After the admin removed someone's details at their request (customers/[id]). */
const erasedParam = Astro.url.searchParams.get('erased');
const erased = erasedParam !== null && /^\d+$/.test(erasedParam) ? Number(erasedParam) : null;
const tagDone = ({ added: 'Tag added.', saved: 'Tag saved.', deleted: 'Tag removed from everyone who had it.' } as Record<string, string>)[Astro.url.searchParams.get('tagdone') ?? ''];
const day = new Intl.DateTimeFormat('en-IN', { timeZone: 'UTC', day: 'numeric', month: 'short', year: 'numeric' });
const when = new Intl.DateTimeFormat('en-IN', { timeZone: 'Asia/Kolkata', day: 'numeric', month: 'short', year: 'numeric' });
/** The list without one filter. */
const without = (k: string) => listHref('/admin/customers/', { ...keep, [k]: null })(null);
const filtered = Boolean(q || from || to || rating || tag);
const canReach = reach ? reach.all - reach.skipped : 0;
const exportHref = (only?: 'numbers') => listHref('/admin/customers/export.csv', { q, from, to, rating, tag, only })(null);
const OFFER = `Namaste {name}! Thank you for travelling with ${SITE.name}. We have a new tour we think you will enjoy: …\n\nReply here and we will plan it for you. If you would rather not get offers from us, reply STOP.`;
const ICON_STAR = '<path d="m12 3 2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1-4.4-4.3 6.1-.9z"/>';
const ICON_TAG = '<path d="M20.6 13.4 13.4 20.6a2 2 0 0 1-2.8 0L3 13V3h10l7.6 7.6a2 2 0 0 1 0 2.8z"/><path d="M7.5 7.5h.01"/>';
const waIcon = '<path d="M21 11.5a8.4 8.4 0 0 1-12.4 7.4L3 21l2.1-5.5A8.5 8.5 0 1 1 21 11.5z"/>';
const closeIcon = '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>';
---

<AdminLayout title="Customers">
  <div class="flex flex-col gap-5">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <h1 class="m-0 font-display text-[28px] font-bold lg:text-3xl">Customers</h1>
        <p class="m-0 mt-1 text-sm text-muted">One entry per mobile number, so a returning customer is recognised however they type it.</p>
      </div>
      <div class="flex w-full flex-wrap gap-2 sm:w-auto">
        <form method="get" class="flex flex-[1_1_100%] gap-2 sm:flex-none" role="search">
          {Object.entries(keep).map(([k, v]) => k !== 'q' && v && <input type="hidden" name={k} value={v} />)}
          <label class="a-field flex-1"><span class="sr-only">Search customers</span><input name="q" type="search" value={q} placeholder="Name or mobile number" class="w-full sm:w-64" /></label>
          <button class="btn-book" type="submit">Search</button>
        </form>
        <button type="button" class="btn-ghost min-h-12 px-4" data-open="tags-dlg">Tags</button>
        {sending ? (
          <a href={without('send')} class="btn-ghost min-h-12 px-4">Done sending</a>
        ) : (
          <a href={listHref('/admin/customers/', { ...keep, send: '1' })(null)} class="btn-wa min-h-12 px-4">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={waIcon} />
            Send an offer
          </a>
        )}
      </div>
    </div>

    {erased !== null && (
      <p class="a-msg a-msg-ok m-0" role="status">Their details are removed{erased ? ` from ${erased} ${erased === 1 ? 'booking' : 'bookings'}` : ''}. The trips and payments stay in the accounts without a name or number.</p>
    )}

    {sending && reach && (
      <section class="flex flex-col gap-4 rounded-[20px] bg-ink p-5 text-white lg:p-6" aria-labelledby="send-h" data-offer>
        <div class="flex flex-col gap-1">
          <h2 id="send-h" class="m-0 font-display text-xl font-bold text-white">Send a new tour or offer</h2>
          <p class="m-0 text-sm text-[#e3e6ec]">Narrow the list with the filters below (stars, tag, last booked), then press Send on each customer. WhatsApp opens with your message and their first name in it.</p>
        </div>
        <label class="a-field text-white">
          <span class="text-white">Message <span class="font-normal text-[#c9ced8]">· {'{name}'} becomes each customer’s first name; kept on this device as you type</span></span>
          <textarea rows="5" maxlength="1500" data-offer-text class="text-ink">{OFFER}</textarea>
        </label>
        <div class="flex flex-wrap items-center gap-x-3 gap-y-2 text-sm">
          <span class="a-badge bg-lime text-ink">{canReach.toLocaleString('en-IN')} {canReach === 1 ? 'customer' : 'customers'} in this list can get it</span>
          {reach.skipped > 0 && <span class="text-[#c9ced8]">{reach.skipped} asked for no offers and {reach.skipped === 1 ? 'is' : 'are'} left out</span>}
          {admin && canReach > 0 && (
            <span class="flex flex-wrap gap-2 sm:ml-auto">
              <button type="button" class="btn-light min-h-11 px-4 py-2 text-sm" data-copy-numbers={exportHref('numbers')}>Copy all {canReach} numbers</button>
              <a href={exportHref()} class="btn-light min-h-11 px-4 py-2 text-sm" download>Download as CSV</a>
            </span>
          )}
        </div>
        <p class="m-0 text-[13px] text-[#c9ced8]">
          {admin
            ? 'For many at once: add the numbers to the office phone’s contacts, then send through a WhatsApp Broadcast list. Only people who have saved the office number receive a broadcast.'
            : 'The admin can also copy every number in the list, for a WhatsApp Broadcast list on the office phone.'}
        </p>
      </section>
    )}

    <ListFilters
      dateLabel="Last booked"
      presets={['last7', 'last30', 'thisMonth', 'lastMonth']}
      from={from}
      to={to}
      keep={{ q, rating, tag, send: keep.send }}
      clearHref={listHref('/admin/customers/', { ...keep, from: null, to: null })(null)}
      rows={size}
      rowsHref={(n) => withParams(Astro.url, { rows: String(n) })}
    >
      <FilterSelect slot="end" name="rating" label="Stars" anyLabel="Any rating" value={rating} options={Object.entries(RATING_FILTERS)} clearHref={without('rating')} icon={ICON_STAR} />
      <FilterSelect slot="end" name="tag" label="Tag" anyLabel="Any tag" value={tag} options={tags.map((t) => [t.id, `${t.name} · ${t.uses}`])} clearHref={without('tag')} icon={ICON_TAG} />
    </ListFilters>

    {rows.length === 0 ? (
      page.cursor ? (
        <EmptyState compact photo="tea-worker" title="Nothing more on this page." action={{ href: listHref('/admin/customers/', keep)(null), label: 'Back to the most recent' }} />
      ) : filtered ? (
        <EmptyState compact photo="tea-worker" title="No customers match that." text="Try fewer filters, part of the name, or the last four digits of the mobile number." action={{ href: sending ? '/admin/customers/?send=1' : '/admin/customers/', label: 'Show everyone' }} />
      ) : (
        <EmptyState photo="tea-worker" title="No customers yet." text="Everyone who books appears here, one entry per mobile number, so a returning guest is recognised the next time." />
      )
    ) : (
      <div class="a-card overflow-x-auto">
        <table class="a-table">
          <thead><tr><th>Customer</th><th>Bookings</th><th>Next trip</th><th>Paid so far</th><th>Last booked</th>{sending && <th><span class="sr-only">Send</span></th>}</tr></thead>
          <tbody>
            {rows.map((r) => (
              <tr>
                <td data-label="Customer">
                  <a href={`/admin/customers/${r.id}/`} class="font-semibold text-ink no-underline hover:underline">{r.name ?? 'No name'}</a>
                  {r.phone && <span class="block text-sm text-muted">{phoneLabel(r.phone)}</span>}
                  {(r.rating || r.tags.length > 0 || r.noOffers) && (
                    <span class="mt-1 flex flex-wrap items-center gap-1.5">
                      {r.rating && <span class="a-stars text-sm" aria-label={`${r.rating} of 5 stars`} title={`${r.rating} of 5 stars`}>{starText(r.rating)}</span>}
                      {r.tags.map((t) => <span class:list={['a-badge', TAG_CLASS[t.tone]]}>{t.name}</span>)}
                      {r.noOffers && <span class="a-badge bg-[#fde8e7] text-[#b42318]">No offers</span>}
                    </span>
                  )}
                  {r.notes && <span class="mt-0.5 block max-w-[34ch] truncate text-sm text-body">{r.notes}</span>}
                </td>
                <td data-label="Bookings">
                  <strong>{r.bookings}</strong>
                  {r.bookings > 1 && <span class="a-badge ml-2 bg-lime-50 text-[#3f6200]">Returning</span>}
                  {r.trips > 0 && <span class="block text-sm text-muted">{r.trips} completed</span>}
                </td>
                <td class="whitespace-nowrap" data-label="Next trip">{r.nextTrip ? day.format(new Date(`${r.nextTrip}T00:00:00Z`)) : <span class="text-muted">None booked</span>}</td>
                <td class="whitespace-nowrap font-semibold" data-label="Paid so far">{inr(r.paid)}</td>
                <td class="whitespace-nowrap text-sm text-body" data-label="Last booked">{r.last ? when.format(r.last) : '—'}</td>
                {sending && (
                  <td class="whitespace-nowrap" data-label="Offer">
                    {r.noOffers || !r.phone ? (
                      <span class="text-sm text-muted">Asked for none</span>
                    ) : (
                      <a href={`https://wa.me/${r.phone}`} target="_blank" rel="noopener" class="btn-wa min-h-11 px-4 py-2 text-sm" data-offer-to={r.phone} data-first={firstName(r.name ?? '')}>
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={waIcon} />
                        <span data-offer-label>Send</span>
                      </a>
                    )}
                  </td>
                )}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}

    <Pager prev={list.newer} next={list.older} start={list.start} prevLabel="More recent" nextLabel="Earlier" />
  </div>

  {/* The tag manager */}
  <dialog id="tags-dlg" class="a-dialog" aria-labelledby="tags-h" data-autoopen={Astro.url.searchParams.get('tags') || tagError ? '' : undefined}>
    <div class="a-dialog-body">
      <header class="a-dialog-head">
        <h2 id="tags-h" class="m-0 font-display text-xl font-bold">Customer tags</h2>
        <button type="button" data-close class="a-icon-btn" aria-label="Close" set:html={closeIcon} />
      </header>
      <div class="a-dialog-main flex flex-col gap-4">
        {tagDone && <p class="a-msg a-msg-ok m-0" role="status">{tagDone}</p>}
        {tagError && <p class="a-msg a-msg-error m-0" role="alert">{tagError}</p>}
        <p class="m-0 text-sm text-body">Group customers your own way, then filter the list by a tag to send them a new tour. Tag a customer on their page.</p>
        {tags.length > 0 && (
          <ul class="m-0 flex list-none flex-col gap-2.5 p-0">
            {tags.map((t) => (
              <li>
                <form method="post" class="flex flex-wrap items-end gap-2 rounded-2xl bg-mist p-3">
                  <input type="hidden" name="id" value={t.id} />
                  <label class="a-field min-w-0 flex-[1_1_10rem]"><span class="sr-only">Name</span><input name="name" value={t.name} maxlength="30" required /></label>
                  <label class="a-field w-[7.5rem]"><span class="sr-only">Colour</span>
                    <select name="tone">{TAG_TONES.map((x) => <option value={x} selected={t.tone === x}>{TONE_NAME[x]}</option>)}</select>
                  </label>
                  <button type="submit" name="intent" value="tag-change" class="btn-ghost min-h-12 px-4">Save</button>
                  <button type="submit" name="intent" value="tag-delete" class="btn-ghost min-h-12 px-4 text-[#b42318] hover:border-[#b42318]" data-arm={t.uses ? `Remove from ${t.uses}?` : 'Sure?'}>Delete</button>
                  <span class="flex w-full items-center gap-2 text-[13px] text-muted">
                    <span class:list={['a-badge', TAG_CLASS[t.tone]]}>{t.name}</span>
                    {t.uses === 0 ? 'Nobody yet' : `${t.uses} ${t.uses === 1 ? 'customer' : 'customers'}`}
                  </span>
                </form>
              </li>
            ))}
          </ul>
        )}
        <form method="post" class="flex flex-wrap items-end gap-2 border-t border-[#eceef1] pt-4">
          <label class="a-field min-w-0 flex-[1_1_12rem]">New tag<input name="name" maxlength="30" required placeholder="Trekkers" /></label>
          <label class="a-field w-[7.5rem]">Colour
            <select name="tone"><option value="">Any</option>{TAG_TONES.map((x) => <option value={x}>{TONE_NAME[x]}</option>)}</select>
          </label>
          <button type="submit" name="intent" value="tag-add" class="btn-book min-h-12 px-5">Add</button>
        </form>
      </div>
    </div>
  </dialog>
</AdminLayout>

<script>
  import { openDialogs } from '../../../lib/admin-client';
  openDialogs();

  // Delete asks once more on the same button, instead of another popup over this one.
  document.querySelectorAll<HTMLButtonElement>('[data-arm]').forEach((btn) => {
    const label = btn.textContent;
    btn.addEventListener('click', (e) => {
      if (btn.dataset.armed) return;
      e.preventDefault();
      btn.dataset.armed = '1';
      btn.textContent = btn.dataset.arm!;
      btn.classList.add('bg-[#fde8e7]');
      setTimeout(() => {
        delete btn.dataset.armed;
        btn.textContent = label;
        btn.classList.remove('bg-[#fde8e7]');
      }, 4000);
    });
  });

  // Send an offer: the message is kept on this device, and each Send opens WhatsApp with it.
  const box = document.querySelector<HTMLTextAreaElement>('[data-offer-text]');
  if (box) {
    const KEY = 'bat-offer-message';
    const SENT = 'bat-offer-sent';
    try {
      const saved = localStorage.getItem(KEY);
      if (saved) box.value = saved;
    } catch { /* private mode: start from the example each time */ }
    box.addEventListener('input', () => {
      try {
        localStorage.setItem(KEY, box.value);
      } catch { /* nothing to keep it in */ }
    });
    // Who was sent this message on this device, so the office can work down a long list.
    const sentFor = (): Record<string, number> => {
      try {
        const s = JSON.parse(sessionStorage.getItem(SENT) || '{}');
        return s.text === box.value ? s.to : {};
      } catch {
        return {};
      }
    };
    const mark = (a: HTMLAnchorElement) => {
      a.classList.replace('btn-wa', 'btn-ghost');
      a.querySelector('[data-offer-label]')!.textContent = 'Sent ✓';
    };
    const sent = sentFor();
    document.querySelectorAll<HTMLAnchorElement>('[data-offer-to]').forEach((a) => {
      if (sent[a.dataset.offerTo!]) mark(a);
      a.addEventListener('click', () => {
        const text = box.value.replace(/\{name\}/g, a.dataset.first || 'there');
        a.href = `https://wa.me/${a.dataset.offerTo}?text=${encodeURIComponent(text)}`;
        try {
          sessionStorage.setItem(SENT, JSON.stringify({ text: box.value, to: { ...sentFor(), [a.dataset.offerTo!]: Date.now() } }));
        } catch { /* the tick just won't survive a reload */ }
        mark(a);
      });
    });
  }

  document.querySelector<HTMLButtonElement>('[data-copy-numbers]')?.addEventListener('click', async (e) => {
    const btn = e.currentTarget as HTMLButtonElement;
    const label = btn.textContent;
    btn.disabled = true;
    try {
      const r = await fetch(btn.dataset.copyNumbers!);
      if (!r.ok) throw new Error(await r.text());
      await navigator.clipboard.writeText(await r.text());
      btn.textContent = 'Copied, one number a line';
    } catch {
      btn.textContent = 'Could not copy. Use Download';
    }
    setTimeout(() => {
      btn.textContent = label;
      btn.disabled = false;
    }, 2500);
  });
</script>
