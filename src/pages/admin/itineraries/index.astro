---
/**
 * Every itinerary, upcoming trips first, a page at a time (10, 25 or 50),
 * with a date range on the trip date: drafts not sent yet, and ones sent
 * (with how many updates). Open takes you to the booking with the popup
 * open; Delete removes the itinerary after a confirmation.
 */
import AdminLayout from '../../../layouts/AdminLayout.astro';
import ListFilters from '../../../components/admin/ListFilters.astro';
import EmptyState from '../../../components/admin/EmptyState.astro';
import Pager from '../../../components/admin/Pager.astro';
import { audit } from '../../../server/admin';
import { TONE, todayIST } from '../../../server/dashboard';
import { getDb, schema } from '../../../server/db';
import { cursorField, dateFilter, listHref, pageFrom, pageQuery, pageResult, rowsFor, withParams, type SortKey } from '../../../server/paging';
import { adminFileSrc, itineraryKeys, liveUploads, uploadIdOf, withoutMissing } from '../../../server/files';
import { ipHash } from '../../../server/security';
import { deleteItinerary, tripPath } from '../../../server/trip';
import { dateRange } from '../../../lib/itinerary-text';
import { and, eq, gte, lt, lte, sql } from 'drizzle-orm';

export const prerender = false;

const user = Astro.locals.user!;
let deleted = '';
if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  const bookingId = String(f.get('bookingId') ?? '');
  if (f.get('intent') === 'delete' && /^[0-9a-f-]{36}$/.test(bookingId)) {
    await deleteItinerary(bookingId, { actorId: user.id, ipHash: ipHash(Astro.request) });
    return Astro.redirect(`/admin/itineraries/?${Astro.url.searchParams.get('show') === 'past' ? 'show=past&' : ''}deleted=1`, 303);
  }
}
if (Astro.url.searchParams.get('deleted')) deleted = 'Itinerary deleted. It is noted on the booking’s timeline.';
const showPast = Astro.url.searchParams.get('show') === 'past';
const today = todayIST();
const t = schema.itineraries;
const b = schema.bookings;
const { from, to } = dateFilter(Astro.url);
const size = rowsFor(Astro.url, Astro.cookies);
const show = showPast ? 'past' : null;
const key: SortKey = { cols: [sql`${b.pickupDate}`, sql`${b.id}`], types: ['date', 'uuid'], order: showPast ? 'desc' : 'asc' };
const page = pageFrom(Astro.url, key);
const pq = pageQuery(key, page, size);
const fetched = await getDb()
  .select({ id: b.id, ref: b.ref, status: b.status, pickup: b.pickupDate, draft: t.draft, sentAt: t.sentAt, sentCount: t.sentCount, updatedAt: t.updatedAt, by: schema.user.name, cursor: cursorField(key) })
  .from(t)
  .innerJoin(b, eq(t.bookingId, b.id))
  .leftJoin(schema.user, eq(t.sentBy, schema.user.id))
  .where(and(showPast ? lt(b.pickupDate, today) : gte(b.pickupDate, today), from ? gte(b.pickupDate, from) : undefined, to ? lte(b.pickupDate, to) : undefined, pq.where))
  .orderBy(...pq.orderBy)
  .limit(pq.limit);
const list = pageResult(fetched, page, listHref('/admin/itineraries/', { show, from, to }), size);
// Uploaded photos deleted from storage are left out, so no card shows a broken picture.
const live = await liveUploads(list.rows.flatMap((r) => itineraryKeys(r.draft)));
const rows = list.rows.map((r) => ({ ...r, draft: withoutMissing(r.draft, live) }));
const thumb = (key: string) => {
  const id = uploadIdOf(key);
  return id ? adminFileSrc(id) : `/img/${key}-400.webp`;
};
await audit({ actorId: user.id, action: 'view_itineraries', entity: 'itineraries', detail: { count: rows.length, from: from ?? undefined, to: to ?? undefined }, ipHash: ipHash(Astro.request) });

const atFmt = new Intl.DateTimeFormat('en-IN', { timeZone: 'Asia/Kolkata', day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' });
const origin = Astro.url.origin;
---

<AdminLayout title="Itineraries">
  <div class="flex flex-col gap-5">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <h1 class="m-0 font-display text-[28px] font-bold lg:text-3xl">Itineraries</h1>
        <p class="m-0 mt-1 text-sm text-muted">Day-by-day plans sent to customers on WhatsApp, each with its own private trip page.</p>
      </div>
      <a href="/admin/bookings/?pick=itinerary" class="btn-book">Send a new one</a>
    </div>

    {deleted && <p class="a-msg a-msg-ok m-0" role="status">{deleted}</p>}

    <ListFilters
      dateLabel="Trip date"
      presets={showPast ? ['yesterday', 'last7', 'last30', 'lastMonth'] : ['today', 'tomorrow', 'next7', 'thisMonth', 'nextMonth']}
      from={from}
      to={to}
      keep={{ show }}
      clearHref={listHref('/admin/itineraries/', { show })(null)}
      rows={size}
      rowsHref={(n) => withParams(Astro.url, { rows: String(n) })}
    >
      <nav slot="start" aria-label="Which trips" class="flex gap-1 rounded-[14px] border border-line bg-white p-1">
        <a href={listHref('/admin/itineraries/', { from, to })(null)} aria-current={showPast ? undefined : 'page'} class:list={['inline-flex min-h-10 items-center rounded-[10px] px-4 text-sm no-underline transition-colors', showPast ? 'font-medium text-body hover:bg-mist hover:text-ink' : 'bg-ink font-semibold text-white']}>Upcoming</a>
        <a href={listHref('/admin/itineraries/', { show: 'past', from, to })(null)} aria-current={showPast ? 'page' : undefined} class:list={['inline-flex min-h-10 items-center rounded-[10px] px-4 text-sm no-underline transition-colors', showPast ? 'bg-ink font-semibold text-white' : 'font-medium text-body hover:bg-mist hover:text-ink']}>Past trips</a>
      </nav>
    </ListFilters>

    {rows.length === 0 ? (
      <EmptyState
        photo="gurudongmar"
        compact={Boolean(from || to)}
        title={from || to ? `No ${showPast ? 'past' : 'upcoming'} itineraries in those dates.` : showPast ? 'No past itineraries yet.' : 'No itineraries for upcoming trips yet.'}
        text={from || to ? `${showPast ? 'Past trips' : 'Upcoming'} is open, so only ${showPast ? 'trips before today' : 'trips from today on'} are searched. Switch above, or clear the dates.` : 'Open a booking and press Send itinerary. It fills in from the booking and the tour package, so most of it is ready before you start.'}
      />
    ) : (
      <ul class="m-0 grid list-none gap-3 p-0 md:grid-cols-2 2xl:grid-cols-3">
        {rows.map((r) => {
          const cover = r.draft.photos[0] ?? r.draft.days.find((x) => x.photo)?.photo;
          return (
            <li class="a-card flex overflow-hidden">
              {cover ? <img src={thumb(cover)} alt="" width="400" height="267" loading="lazy" onerror="this.replaceWith(Object.assign(document.createElement('span'),{className:this.className+' bg-mist'}))" class="w-[104px] shrink-0 object-cover sm:w-[128px]" /> : <span class="w-[104px] shrink-0 bg-mist sm:w-[128px]"></span>}
              <div class="flex min-w-0 flex-1 flex-col gap-1 p-4">
                <span class="flex flex-wrap items-center gap-2">
                  <a href={`/admin/bookings/${r.ref}/`} class="font-mono text-sm font-bold text-ink">{r.ref}</a>
                  <span class:list={['a-badge', r.sentAt ? TONE.lime : TONE.amber]}>{r.sentAt ? (r.sentCount > 1 ? `Sent · ${r.sentCount - 1} ${r.sentCount === 2 ? 'update' : 'updates'}` : 'Sent') : 'Draft'}</span>
                </span>
                <a href={`/admin/bookings/${r.ref}/?do=itinerary`} class="truncate font-semibold text-ink no-underline hover:underline">{r.draft.name} · {r.draft.title}</a>
                <span class="text-sm text-body">{dateRange(r.draft.start, r.draft.end)} · {r.draft.days.length} {r.draft.days.length === 1 ? 'day' : 'days'}</span>
                <span class="text-[13px] text-muted">{r.sentAt ? `Last sent ${atFmt.format(r.sentAt)}${r.by ? ` by ${r.by}` : ''}` : `Saved ${atFmt.format(r.updatedAt)}`}</span>
                <span class="mt-2 flex flex-wrap gap-2">
                  <a href={`/admin/bookings/${r.ref}/?do=itinerary`} class="btn-book min-h-10 px-4 py-1.5 text-sm">Open</a>
                  <a href={r.sentAt ? new URL(tripPath(r), origin).href : `/admin/bookings/${r.ref}/trip/`} target="_blank" rel="noopener" class="btn-ghost min-h-10 px-4 py-1.5 text-sm">{r.sentAt ? 'Customer’s page' : 'Preview'}</a>
                  <button type="button" data-open="dlg-delete" data-booking={r.id} data-what={`${r.draft.title} for ${r.draft.name} (${r.ref})`} data-sent={r.sentAt ? '1' : ''} class="btn-ghost min-h-10 px-4 py-1.5 text-sm text-[#b42318] hover:border-[#b42318] hover:text-[#b42318]">Delete</button>
                </span>
              </div>
            </li>
          );
        })}
      </ul>
    )}

    <Pager prev={list.newer} next={list.older} start={list.start} prevLabel={showPast ? 'More recent' : 'Sooner'} nextLabel={showPast ? 'Earlier' : 'Later'} />
  </div>

  <dialog id="dlg-delete" class="a-dialog a-dialog-sm" aria-labelledby="dlg-delete-h">
    <form method="post" class="a-dialog-body">
      <input type="hidden" name="intent" value="delete" />
      <input type="hidden" name="bookingId" value="" data-delete-id />
      <header class="a-dialog-head">
        <h2 id="dlg-delete-h" class="m-0 font-display text-xl font-bold">Delete this itinerary?</h2>
        <button type="button" data-close class="a-icon-btn" aria-label="Close"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12" /></svg></button>
      </header>
      <div class="a-dialog-main flex flex-col gap-3 text-body">
        <p class="m-0"><strong class="text-ink" data-delete-what></strong>: the day-by-day plan, photos and message are removed. This cannot be undone.</p>
        <p class="m-0" data-delete-sent>It was sent to the customer. Their link keeps working but shows only the booking and payment, so tell them if they are expecting the plan.</p>
        <p class="m-0 text-sm text-muted">The booking, its payments and its timeline stay.</p>
      </div>
      <footer class="a-dialog-foot">
        <button type="button" data-close class="btn-ghost">Keep it</button>
        <button type="submit" class="btn-book bg-[#b42318] hover:bg-[#8f1d14]">Delete itinerary</button>
      </footer>
    </form>
  </dialog>
</AdminLayout>

<script>
  import { openDialogs } from '../../../lib/admin-client';

  openDialogs();
  // Carry the chosen itinerary into the confirmation.
  document.querySelectorAll<HTMLButtonElement>('[data-open=dlg-delete]').forEach((b) =>
    b.addEventListener('click', () => {
      const dlg = document.getElementById('dlg-delete')!;
      dlg.querySelector<HTMLInputElement>('[data-delete-id]')!.value = b.dataset.booking!;
      dlg.querySelector<HTMLElement>('[data-delete-what]')!.textContent = b.dataset.what!;
      dlg.querySelector<HTMLElement>('[data-delete-sent]')!.hidden = !b.dataset.sent;
    }),
  );
</script>
