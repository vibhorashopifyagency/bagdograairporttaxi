---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileActionBar from '../components/MobileActionBar.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import JsonLd from '../components/JsonLd.astro';
import { PRE_LAUNCH, SITE, BUSINESS } from '../data/site';
import { businessGraph, breadcrumbs as crumbSchema } from '../lib/schema';

interface Props {
  /** Full <title>. Lead with the keyword; the brand is appended. */
  title: string;
  description: string;
  /** Keep a route out of the index (404, thank-you). Never nofollow. */
  noindex?: boolean;
  /** Extra JSON-LD nodes for this page; merged into the site graph. */
  schema?: unknown[];
  crumbs?: { name: string; path: string }[];
  ogType?: 'website' | 'article';
  ogImage?: string;
}

const { title, description, noindex = false, schema = [], crumbs, ogType = 'website', ogImage = '/og/default.png' } = Astro.props;
// Append the brand only when it fits in ~65 characters; the keyword matters more.
const withBrand = `${title} | ${SITE.name}`;
const fullTitle = title.includes(SITE.name) || withBrand.length > 65 ? title : withBrand;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const ogImageUrl = new URL(ogImage, SITE.url).href;
const robots = PRE_LAUNCH
  ? 'noindex, nofollow'
  : noindex
    ? 'noindex, follow'
    : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';
const allCrumbs = crumbs ? [{ name: 'Home', path: '/' }, ...crumbs] : undefined;
const nodes = [...businessGraph(), ...(allCrumbs ? [crumbSchema(allCrumbs)] : []), ...schema];
---

<!doctype html>
<html lang={SITE.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    {!noindex && <link rel="canonical" href={canonical} />}
    <link rel="preload" href="/fonts/bricolage-latin-variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-latin-variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#111111" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />

    <!-- Local SEO geo tags (Bagdogra, West Bengal) -->
    <meta name="geo.region" content="IN-WB" />
    <meta name="geo.placename" content="Bagdogra, Siliguri" />
    <meta name="geo.position" content={`${BUSINESS.geo.lat};${BUSINESS.geo.lng}`} />
    <meta name="ICBM" content={`${BUSINESS.geo.lat}, ${BUSINESS.geo.lng}`} />

    <!-- Open Graph / social -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE.name}: fixed-fare taxis from Bagdogra to Darjeeling, Gangtok and Sikkim`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="format-detection" content="telephone=no" />

    <JsonLd nodes={nodes} />
  </head>
  <body class="min-h-screen">
    <Header />
    {allCrumbs && <Breadcrumbs items={allCrumbs} />}
    <main id="main">
      <slot />
    </main>
    <Footer />
    <MobileActionBar />
  </body>
</html>
