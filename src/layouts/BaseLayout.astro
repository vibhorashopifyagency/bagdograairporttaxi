---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileActionBar from '../components/MobileActionBar.astro';
import WelcomePopup from '../components/WelcomePopup.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import JsonLd from '../components/JsonLd.astro';
import IconSprite from '../components/IconSprite.astro';
import { PRE_LAUNCH, SITE, BUSINESS } from '../data/site';
import { businessGraph, breadcrumbs as crumbSchema, webPage } from '../lib/schema';

interface Props {
  /** Full <title>. Lead with the keyword; the brand is appended. */
  title: string;
  description: string;
  /** Keep a route out of the index (404, thank-you). Never nofollow. */
  noindex?: boolean;
  /** Extra JSON-LD nodes for this page; merged into the site graph. */
  schema?: unknown[];
  crumbs?: { name: string; path: string }[];
  ogType?: 'website' | 'article';
  ogImage?: string;
  /** ISO date the page's facts last changed. Falls back to any Article node's dateModified. */
  modified?: string;
  /** CSS selectors of the answer-first passages an assistant may quote or read aloud. */
  speakable?: string[];
  /** The welcome popup 15 seconds in; off on the booking form. */
  welcome?: boolean;
}

const { title, description, noindex = false, schema = [], crumbs, ogType = 'website', ogImage = '/og/default.png', speakable, welcome = true } = Astro.props;
const articleModified = (schema as { '@type'?: string; dateModified?: string }[]).find((n) => n?.['@type'] === 'Article')?.dateModified;
const modified = Astro.props.modified ?? articleModified;
// Append the brand only when it fits in ~65 characters; the keyword matters more.
const withBrand = `${title} | ${SITE.name}`;
const fullTitle = title.includes(SITE.name) || withBrand.length > 65 ? title : withBrand;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const ogImageUrl = new URL(ogImage, SITE.url).href;
const robots = PRE_LAUNCH
  ? 'noindex, nofollow'
  : noindex
    ? 'noindex, follow'
    : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';
const allCrumbs = crumbs ? [{ name: 'Home', path: '/' }, ...crumbs] : undefined;
// Pages with a photo header pass it as `slot="hero"`, so the breadcrumb can sit on the photo instead of above it.
const hasHero = Astro.slots.has('hero');
const nodes = [
  ...businessGraph(),
  webPage({ path: Astro.url.pathname, name: fullTitle, description, image: ogImageUrl, modified, speakable }),
  ...(allCrumbs ? [crumbSchema(allCrumbs)] : []),
  ...schema,
];
---

<!doctype html>
<html lang={SITE.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    {!noindex && !PRE_LAUNCH && <link rel="canonical" href={canonical} />}
    <link rel="preload" href="/fonts/bricolage-latin-variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-latin-variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/logo-192.png" sizes="192x192" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#111111" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />
    <link rel="alternate" type="text/plain" href="/llms-full.txt" title="llms-full.txt" />
    <link rel="alternate" type="application/rss+xml" href="/feed.xml" title={`${SITE.name}: travel guides`} />
    {modified && <meta property="article:modified_time" content={`${modified}T00:00:00+05:30`} />}

    <!-- Local SEO geo tags (Bagdogra, West Bengal) -->
    <meta name="geo.region" content="IN-WB" />
    <meta name="geo.placename" content="Bagdogra, Siliguri" />
    <meta name="geo.position" content={`${BUSINESS.geo.lat};${BUSINESS.geo.lng}`} />
    <meta name="ICBM" content={`${BUSINESS.geo.lat}, ${BUSINESS.geo.lng}`} />

    <!-- Open Graph / social -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE.name}: fixed-fare taxis from Bagdogra to Darjeeling, Gangtok and Sikkim`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="format-detection" content="telephone=no" />

    <JsonLd nodes={nodes} />
    <!-- Marks the document as scripted before first paint, so reveal animations never hide content without JS. -->
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body id="top" class="min-h-screen">
    <IconSprite />
    <Header />
    {allCrumbs && !hasHero && <Breadcrumbs items={allCrumbs} />}
    <main id="main">
      {hasHero && (
        <div class="relative">
          <slot name="hero" />
          {allCrumbs && <Breadcrumbs items={allCrumbs} tone="light" class="absolute inset-x-0 top-0 z-10" />}
        </div>
      )}
      <slot />
    </main>
    <Footer />
    <MobileActionBar />
    {welcome && <WelcomePopup />}
    <script>
      // Scroll reveal and count-up numbers. Both are decoration: without this
      // script everything is visible and every number is already in the HTML.
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const counters = document.querySelectorAll<HTMLElement>('[data-count]');
      const countUp = (el: HTMLElement) => {
        const end = Number(el.dataset.count); const suffix = el.dataset.suffix ?? '';
        if (reduce || !Number.isFinite(end)) { el.textContent = end + suffix; return; }
        const t0 = performance.now(); const dur = 1100;
        const step = (t: number) => {
          const k = Math.min(1, (t - t0) / dur); const e = 1 - Math.pow(1 - k, 3);
          el.textContent = Math.round(end * e) + suffix;
          if (k < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
      };
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => {
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            e.target.classList.add('in');
            if ((e.target as HTMLElement).dataset.count !== undefined) countUp(e.target as HTMLElement);
            io.unobserve(e.target);
          }
        }, { rootMargin: '0px 0px -6% 0px', threshold: 0.08 });
        document.querySelectorAll('[data-reveal], [data-reveal-stagger]').forEach((el) => io.observe(el));
        counters.forEach((el) => io.observe(el));
      } else {
        document.querySelectorAll('[data-reveal], [data-reveal-stagger]').forEach((el) => el.classList.add('in'));
      }
    </script>
    {/* Retries a booking the booking page could not save (no network, server down, too many requests). Does nothing when the queue is empty. */}
    <script is:inline>
      (function () {
        try {
          var k = 'bat-pending-bookings';
          var q = JSON.parse(localStorage.getItem(k) || '[]');
          if (!q.length) return;
          localStorage.removeItem(k);
          q.filter(function (p) { return Date.now() - (p.savedAt || 0) < 7 * 864e5; }).forEach(function (p) {
            fetch('/api/bookings/', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(p), keepalive: true })
              .then(function (r) { if (r.status >= 500 || r.status === 429) throw 0; })
              .catch(function () {
                var c = JSON.parse(localStorage.getItem(k) || '[]');
                c.push(p);
                localStorage.setItem(k, JSON.stringify(c.slice(-10)));
              });
          });
        } catch (e) {}
      })();
    </script>
  </body>
</html>
