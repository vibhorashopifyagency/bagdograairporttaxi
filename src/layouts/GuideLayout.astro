---
/**
 * The page frame for every travel guide. The body of the guide goes in the
 * default slot; this layout wraps it with the photo hero, a facts strip, a
 * sticky sidebar (contents and ask-the-team), the FAQ, related
 * tour packages, the "more guides" band and the booking call to action.
 *
 * The contents list is built from the h2s in the body: each gets an id if it
 * has none, so no page has to maintain anchors by hand.
 */
import BaseLayout from './BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import FaqList from '../components/FaqList.astro';
import BookCta from '../components/BookCta.astro';
import GuideCard from '../components/GuideCard.astro';
import PackageCard from '../components/PackageCard.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import { GUIDES, GUIDES_START } from '../data/guides';
import { PACKAGES } from '../data/packages';
import { BUSINESS, waLink } from '../data/site';
import type { Faq } from '../data/routes';
import { guidePhoto } from '../lib/photos';
import { article, faqPage } from '../lib/schema';
import { photoFile } from '../data/photo-library';

interface Props {
  guide: (typeof GUIDES)[number];
  /** The <title>, which is usually tighter than the guide heading. */
  title: string;
  /** Short breadcrumb label. */
  crumb: string;
  faqs: Faq[];
  /** Two to four facts shown as a strip under the short answer. */
  facts?: { label: string; value: string }[];
  /** Slugs of tour packages to show after the article. */
  packages?: string[];
  /** Short line for the sidebar card, e.g. "Send us your ID photos and we apply for the permit." */
  askNote?: string;
  waText: string;
  bookHref?: string;
  ctaHeading: string;
}
const { guide: g, title, crumb, faqs, facts = [], packages = [], askNote, waText, bookHref = '/book/', ctaHeading } = Astro.props;
const path = `/guides/${g.slug}/`;
const photo = guidePhoto(g.slug);

// Render the body once, give every h2 an id and collect them for the contents list.
const raw = await Astro.slots.render('default');
const toc: { id: string; label: string }[] = [];
const slugify = (s: string) => s.toLowerCase().replace(/<[^>]+>/g, '').replace(/&[a-z]+;/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
const body = raw.replace(/<h2([^>]*)>([\s\S]*?)<\/h2>/g, (_m, attrs: string, inner: string) => {
  const label = inner.replace(/<[^>]+>/g, '').trim();
  const existing = attrs.match(/\sid="([^"]+)"/);
  const id = existing ? existing[1] : slugify(label) || `section-${toc.length + 1}`;
  toc.push({ id, label });
  return existing ? `<h2${attrs}>${inner}</h2>` : `<h2 id="${id}"${attrs}>${inner}</h2>`;
});
toc.push({ id: 'faq-h', label: 'Frequently asked questions' });
const words = body.replace(/<[^>]+>/g, ' ').split(/\s+/).filter(Boolean).length + faqs.reduce((n, f) => n + f.a.split(/\s+/).length, 0);
const readMinutes = Math.max(2, Math.round(words / 200));

// One hue per fact tile: lime, amber, teal, coral. Each shows as a soft shadow and fills the tile on hover.
const TINTS = ['#a1e005', '#ffb300', '#14b8a6', '#fb7185'];
const summaryEdited = g.summary !== GUIDES_START.find((x) => x.slug === g.slug)?.summary;
const others = GUIDES.filter((x) => x.slug !== g.slug);
const pkgs = packages.map((s) => PACKAGES.find((p) => p.slug === s)).filter(Boolean) as typeof PACKAGES;
---

<BaseLayout
  title={title}
  description={g.description}
  crumbs={[{ name: 'Travel guides', path: '/guides/' }, { name: crumb, path }]}
  schema={[article({ headline: g.title, description: g.description, path, modified: g.updated, published: g.published, image: photoFile(photo, 1600) }), faqPage(faqs, path)]}
  ogType="article"
  ogImage={photoFile(photo, 1600)}
>
  <PageHero slot="hero" image={photo} eyebrow="Travel guide" title={g.title} edit={`guide:${g.slug}`} editTitle="title" editPhoto={false}>
    <div class="mt-5 flex flex-wrap gap-2">
      <span class="chip-light"><Icon name="clock" class="h-4 w-4" /> {readMinutes} min read</span>
      <span class="chip-light"><Icon name="check" class="h-4 w-4" /> Updated <time datetime={g.updated}>{g.updatedLabel}</time></span>
      <a href="/about/" class="chip-light no-underline hover:bg-white/25"><Icon name="car" class="h-4 w-4" /> Written by our drivers</a>
    </div>
  </PageHero>

  <article class="wrap mt-10 grid grid-cols-1 gap-10 lg:grid-cols-[minmax(0,1fr)_360px] lg:gap-14">
    <div class="min-w-0">
      <p class="eyebrow">The short answer</p>
      {/* The page's own answer, until the admin rewrites the guide's summary in the dashboard. */}
      {summaryEdited ? <p class="answer mt-3" data-edit={`guide:${g.slug}:summary`}>{g.summary}</p> : <div class="mt-3" data-edit={`guide:${g.slug}:summary`}><slot name="answer" /></div>}

      {facts.length > 0 && (
        <dl class="mt-6 grid gap-4 sm:grid-cols-2 xl:grid-cols-4" data-reveal-stagger data-pop>
          {facts.map((f, i) => (
            <div class="fact" style={`--tint: ${TINTS[i % TINTS.length]}`}>
              <dt class="fact-label">{f.label}</dt>
              <dd class="mt-2 font-[family-name:var(--font-display)] text-lg leading-snug font-bold text-ink">{f.value}</dd>
            </div>
          ))}
        </dl>
      )}

      <div class="prose-site prose-flow mt-4" set:html={body} />

      <FaqList faqs={faqs} />
    </div>

    <aside class="min-w-0 space-y-5">
      <slot name="aside" />
      <div class="space-y-5 lg:sticky lg:top-24 lg:max-h-[calc(100vh-7rem)] lg:overflow-y-auto">
        {toc.length > 1 && (
          <nav class="card p-5" aria-labelledby="toc-h">
            <h2 id="toc-h" class="text-base font-bold">In this guide</h2>
            <ol class="mt-3 space-y-1">
              {toc.map((t, i) => (
                <li>
                  <a href={`#${t.id}`} class="group flex items-start gap-3 rounded-lg px-2 py-1.5 text-sm text-body no-underline transition-colors hover:bg-cream hover:text-ink">
                    <span class="mt-0.5 w-5 shrink-0 font-[family-name:var(--font-display)] text-xs font-bold text-lime-text">{String(i + 1).padStart(2, '0')}</span>
                    <span class="leading-snug">{t.label}</span>
                  </a>
                </li>
              ))}
            </ol>
          </nav>
        )}


        <section class="relative overflow-hidden rounded-[var(--radius-card)] bg-ink p-5 text-white" aria-labelledby="ask-h">
          <Photo name={photo} class="absolute inset-0 h-full w-full object-cover opacity-25" sizes="360px" alt="" />
          <div class="absolute inset-0 bg-gradient-to-br from-ink via-ink/90 to-ink/60" aria-hidden="true"></div>
          <div class="relative">
            <p class="inline-flex items-center gap-2 text-xs font-semibold tracking-[0.14em] text-white/70 uppercase"><span class="live-dot"></span> Team on duty now</p>
            <h2 id="ask-h" class="mt-2 text-xl font-extrabold text-white">Ask our local team, not a call centre</h2>
            <p class="mt-2 text-sm leading-relaxed text-white/75">{askNote ?? 'Send your dates on WhatsApp and we reply with the current road, permit and weather position.'}</p>
            <div class="mt-4 grid gap-2">
              <a class="btn-lime w-full" href={waLink(waText)} rel="noopener"><Icon name="whatsapp" /> WhatsApp us</a>
              <a class="btn-light w-full" href={BUSINESS.phoneHref}><Icon name="phone" /> {BUSINESS.phone}</a>
            </div>
          </div>
        </section>
      </div>

    </aside>
  </article>

  {pkgs.length > 0 && (
    <section class="wrap mt-16" aria-labelledby="pk-h">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div><p class="eyebrow">Book it as a trip</p><h2 id="pk-h" class="mt-2 text-3xl font-extrabold sm:text-[2.5rem] sm:leading-[1.1]">Packages that use this guide</h2></div>
        <a href="/tour-packages/" class="inline-flex items-center gap-1.5 font-semibold text-ink no-underline hover:text-lime-text">All {PACKAGES.length} packages <Icon name="arrow" class="h-4 w-4" /></a>
      </div>
      <div class="mt-8 grid gap-5 md:grid-cols-2 xl:grid-cols-3" data-reveal-stagger>{pkgs.slice(0, 3).map((p) => <PackageCard pkg={p} />)}</div>
    </section>
  )}

  <section class="mt-16 bg-cream py-14 sm:py-16" aria-labelledby="more-h">
    <div class="wrap">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div><p class="eyebrow">Keep reading</p><h2 id="more-h" class="mt-2 text-3xl font-extrabold sm:text-[2.5rem] sm:leading-[1.1]">More from the drivers’ seat</h2></div>
        <a href="/guides/" class="inline-flex items-center gap-1.5 font-semibold text-ink no-underline hover:text-lime-text">All guides <Icon name="arrow" class="h-4 w-4" /></a>
      </div>
      <div class="mt-8 grid gap-5 sm:grid-cols-2 xl:grid-cols-4" data-reveal-stagger>{others.map((o) => <GuideCard guide={o} />)}</div>
    </div>
  </section>

  <div class="wrap">
    <BookCta bookHref={bookHref} waText={waText} heading={ctaHeading} image={photo} />
  </div>
</BaseLayout>
