---
/**
 * Every travel guide (src/pages/guides/[slug].astro): the photo hero, the
 * short answer, a facts strip, the guide's main text, its questions, a sticky
 * sidebar (contents and ask-the-team), related tour packages, the "more
 * guides" band and the booking call to action. All of a guide's words are its
 * data (src/data/guides.ts, editable in the dashboard); the fixed lines around
 * them are the "Every travel guide" page words.
 *
 * The contents list is built from the headings in the main text: each gets
 * an id, so no guide has to maintain anchors by hand.
 */
import BaseLayout from './BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import FaqList from '../components/FaqList.astro';
import BookCta from '../components/BookCta.astro';
import GuideCard from '../components/GuideCard.astro';
import PackageCard from '../components/PackageCard.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import Words from '../components/Words.astro';
import { GUIDES, type Guide } from '../data/guides';
import { PACKAGES } from '../data/packages';
import { GLOBAL_VARS, editAttr, guideVars, words, wordsText } from '../data/page-text';
import { BUSINESS, waLink } from '../data/site';
import { guidePhoto } from '../lib/photos';
import { guideBodyHtml } from '../lib/guide-body';
import { wordsToHtml, wordsToText } from '../lib/rich-text';
import { article, faqPage } from '../lib/schema';
import { photoFile } from '../data/photo-library';

interface Props {
  guide: Guide;
}
const { guide: g } = Astro.props;
const path = `/guides/${g.slug}/`;
const photo = guidePhoto(g.slug);
const own = guideVars(g);
const vars = { ...GLOBAL_VARS, ...own };
const html = (s: string) => wordsToHtml(s, vars);
const text = (s: string) => wordsToText(s, vars);
const edit = (field: string) => `guide:${g.slug}:${field}`;
const faqs = g.faqs.map((f) => ({ q: text(f.q), a: text(f.a) }));

// Give every heading in the main text an id and collect them for the contents list.
const toc: { id: string; label: string }[] = [];
const slugify = (s: string) => s.toLowerCase().replace(/<[^>]+>/g, '').replace(/&[a-z]+;/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
const body = guideBodyHtml(g.body, vars).replace(/<h2([^>]*)>([\s\S]*?)<\/h2>/g, (_m, attrs: string, inner: string) => {
  const label = inner.replace(/<[^>]+>/g, '').trim();
  let id = slugify(label) || `section-${toc.length + 1}`;
  while (toc.some((t) => t.id === id)) id += '-2';
  toc.push({ id, label });
  return `<h2 id="${id}"${attrs}>${inner}</h2>`;
});
toc.push({ id: 'faq-h', label: wordsText('guide-page', 'faqTitle') });

// One hue per fact tile: lime, amber, teal, coral. Each shows as a soft shadow and fills the tile on hover.
const TINTS = ['#a1e005', '#ffb300', '#14b8a6', '#fb7185'];
const others = GUIDES.filter((x) => x.slug !== g.slug);
const pkgs = g.packages.map((s) => PACKAGES.find((p) => p.slug === s)).filter(Boolean) as typeof PACKAGES;
const waText = text(g.waText);
---

<BaseLayout
  title={g.seoTitle}
  description={g.description}
  crumbs={[{ name: 'Travel guides', path: '/guides/' }, { name: g.short, path }]}
  schema={[article({ headline: g.title, description: g.description, path, modified: g.updated, published: g.published, image: photoFile(photo, 1600) }), faqPage(faqs, path)]}
  ogType="article"
  ogImage={photoFile(photo, 1600)}
>
  <PageHero slot="hero" image={photo} words="guide-page" vars={own} title={g.title} edit={`guide:${g.slug}`} editTitle="title" editPhoto={false}>
    <div class="mt-5 flex flex-wrap gap-2">
      <span class="chip-light"><Icon name="clock" class="h-4 w-4" /> <Words page="guide-page" field="readTime" vars={own} /></span>
      <span class="chip-light"><Icon name="check" class="h-4 w-4" /> <Words page="guide-page" field="updatedChip" vars={own} /></span>
      <a href="/about/" class="chip-light no-underline hover:bg-white/25"><Icon name="car" class="h-4 w-4" /> <Words page="guide-page" field="writers" vars={own} /></a>
    </div>
  </PageHero>

  <article class="wrap mt-10 grid grid-cols-1 gap-10 lg:grid-cols-[minmax(0,1fr)_360px] lg:gap-14">
    <div class="min-w-0">
      <Words page="guide-page" field="answerEyebrow" vars={own} as="p" class="eyebrow" />
      <p class="answer mt-3" data-edit={edit('summary')} set:html={html(g.summary)} />

      {g.facts.length > 0 && (
        <dl class="mt-6 grid gap-4 sm:grid-cols-2 xl:grid-cols-4" data-reveal-stagger data-pop data-edit={edit('facts')}>
          {g.facts.map((f, i) => (
            <div class="fact" style={`--tint: ${TINTS[i % TINTS.length]}`}>
              <dt class="fact-label">{f.label}</dt>
              <dd class="mt-2 font-[family-name:var(--font-display)] text-lg leading-snug font-bold text-ink" set:html={html(f.value)} />
            </div>
          ))}
        </dl>
      )}

      <div class="prose-site prose-flow mt-4" data-edit={edit('body')} set:html={body} />

      <FaqList faqs={faqs} heading={words('guide-page', 'faqTitle', own)} headingEdit={editAttr('guide-page', 'faqTitle')} edit={edit('faqs')} />
    </div>

    <aside class="min-w-0 space-y-5">
      <slot name="aside" />
      <div class="space-y-5 lg:sticky lg:top-24 lg:max-h-[calc(100vh-7rem)] lg:overflow-y-auto">
        {toc.length > 1 && (
          <nav class="card p-5" aria-labelledby="toc-h">
            <Words page="guide-page" field="contents" vars={own} as="h2" id="toc-h" class="text-base font-bold" />
            <ol class="mt-3 space-y-1">
              {toc.map((t, i) => (
                <li>
                  <a href={`#${t.id}`} class="group flex items-start gap-3 rounded-lg px-2 py-1.5 text-sm text-body no-underline transition-colors hover:bg-cream hover:text-ink">
                    <span class="mt-0.5 w-5 shrink-0 font-[family-name:var(--font-display)] text-xs font-bold text-lime-text">{String(i + 1).padStart(2, '0')}</span>
                    <span class="leading-snug">{t.label}</span>
                  </a>
                </li>
              ))}
            </ol>
          </nav>
        )}


        <section class="relative overflow-hidden rounded-[var(--radius-card)] bg-ink p-5 text-white" aria-labelledby="ask-h">
          <Photo name={photo} class="absolute inset-0 h-full w-full object-cover opacity-25" sizes="360px" alt="" />
          <div class="absolute inset-0 bg-gradient-to-br from-ink via-ink/90 to-ink/60" aria-hidden="true"></div>
          <div class="relative">
            <p class="inline-flex items-center gap-2 text-xs font-semibold tracking-[0.14em] text-white/70 uppercase"><span class="live-dot"></span> <Words page="guide-page" field="askEyebrow" vars={own} /></p>
            <Words page="guide-page" field="askTitle" vars={own} as="h2" id="ask-h" class="mt-2 text-xl font-extrabold text-white" />
            <p class="mt-2 text-sm leading-relaxed text-white/75" data-edit={edit('askNote')} set:html={html(g.askNote)} />
            <div class="mt-4 grid gap-2">
              <a class="btn-lime w-full" href={waLink(waText)} rel="noopener"><Icon name="whatsapp" /> <Words page="guide-page" field="askWhatsapp" vars={own} /></a>
              <a class="btn-light w-full" href={BUSINESS.phoneHref}><Icon name="phone" /> {BUSINESS.phone}</a>
            </div>
          </div>
        </section>
      </div>

    </aside>
  </article>

  {pkgs.length > 0 && (
    <section class="wrap mt-16" aria-labelledby="pk-h">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div><Words page="guide-page" field="packagesEyebrow" vars={own} as="p" class="eyebrow" /><Words page="guide-page" field="packagesTitle" vars={own} as="h2" id="pk-h" class="mt-2 text-3xl font-extrabold sm:text-[2.5rem] sm:leading-[1.1]" /></div>
        <a href="/tour-packages/" class="inline-flex items-center gap-1.5 font-semibold text-ink no-underline hover:text-lime-text"><Words page="guide-page" field="packagesLink" vars={own} /> <Icon name="arrow" class="h-4 w-4" /></a>
      </div>
      <div class="mt-8 grid gap-5 md:grid-cols-2 xl:grid-cols-3" data-reveal-stagger>{pkgs.slice(0, 3).map((p) => <PackageCard pkg={p} />)}</div>
    </section>
  )}

  <section class="mt-16 bg-cream py-14 sm:py-16" aria-labelledby="more-h">
    <div class="wrap">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div><Words page="guide-page" field="moreEyebrow" vars={own} as="p" class="eyebrow" /><Words page="guide-page" field="moreTitle" vars={own} as="h2" id="more-h" class="mt-2 text-3xl font-extrabold sm:text-[2.5rem] sm:leading-[1.1]" /></div>
        <a href="/guides/" class="inline-flex items-center gap-1.5 font-semibold text-ink no-underline hover:text-lime-text"><Words page="guide-page" field="moreLink" vars={own} /> <Icon name="arrow" class="h-4 w-4" /></a>
      </div>
      <div class="mt-8 grid gap-5 sm:grid-cols-2 xl:grid-cols-4" data-reveal-stagger>{others.map((o) => <GuideCard guide={o} />)}</div>
    </div>
  </section>

  <div class="wrap">
    <BookCta bookHref={g.bookHref} waText={waText} heading={text(g.ctaHeading)} headingEdit={edit('ctaHeading')} image={photo} />
  </div>
</BaseLayout>
