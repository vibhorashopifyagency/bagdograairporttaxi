# Apache / cPanel hosting
ErrorDocument 404 /404.html
Options -Indexes
RewriteEngine On
# Force https and the bare domain
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://bagdograairporttaxi.com%{REQUEST_URI} [L,R=301]
# Old site URLs: every page and image Google had indexed, 301 to its new
# equivalent (old-site photos with no counterpart are left to 404). Keep
# these permanently: Google says at least a year. vercel.json is the master
# copy and scripts/verify-build.mjs fails the build if this file drifts.
RewriteRule ^index\.php$ / [L,R=301]
RewriteRule ^about\.php$ /about/ [L,R=301]
RewriteRule ^contact\.php$ /contact/ [L,R=301]
RewriteRule ^darjeeling\.php$ /destinations/darjeeling/ [L,R=301]
RewriteRule ^gangtok\.php$ /destinations/gangtok/ [L,R=301]
RewriteRule ^mirik\.php$ /destinations/mirik/ [L,R=301]
RewriteRule ^dooars\.php$ /destinations/dooars/ [L,R=301]
RewriteRule ^north_sikkim\.php$ /destinations/north-sikkim/ [L,R=301]
RewriteRule ^taxi\.php$ /taxi/ [L,R=301]
RewriteRule ^service\.php$ /tour-packages/ [L,R=301]
RewriteRule ^bagdogra-airport-taxi-gallery\.php$ /gallery/ [L,R=301]
RewriteRule ^kalimpong\.php$ /destinations/kalimpong/ [L,R=301]
RewriteRule ^bhutan\.php$ /destinations/bhutan/ [L,R=301]
RewriteRule ^lachung\.php$ /destinations/north-sikkim/ [L,R=301]
RewriteRule ^lachen\.php$ /destinations/north-sikkim/ [L,R=301]
RewriteRule ^sittong\.php$ /tour-packages/kolakham-sittong-offbeat-tour-package/ [L,R=301]
RewriteRule ^assets/img/custom/darjeeling\.jpg$ /img/hero-1600.webp [L,R=301]
RewriteRule ^assets/img/custom/Mirik\.jpg$ /img/mirik-1600.webp [L,R=301]
