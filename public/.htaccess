RewriteRule ^assets/img/logo/BTS_Logo_Final_BlackBase\.png$ /logo.png [L,R=301]
RewriteRule ^assets/img/logo/BTS_Logo_Final_WhiteBase\.png$ /logo.png [L,R=301]
RewriteRule ^assets/img/logo/og-image\.jpg$ /og/default.png [L,R=301]
RewriteRule ^assets/img/logo/twitter-image\.jpg$ /og/default.png [L,R=301]
RewriteRule ^assets/img/icon/apple-touch-icon\.png$ /apple-touch-icon.png [L,R=301]
# The old error page is gone: a real 404, not a redirect home
RewriteRule ^404\.php$ - [R=404,L]
RewriteRule ^(.+)\.php$ / [L,R=301]
<IfModule mod_headers.c>
  <FilesMatch "\.(woff2|png|svg|webp|js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
</IfModule>
