RewriteRule ^assets/img/destinations/dooars/buxa_tiger\.jpg$ /img/rhino-1600.webp [L,R=301]
RewriteRule ^assets/img/destinations/dooars/rainforest-dooars\.jpg$ /img/rhino-1600.webp [L,R=301]
