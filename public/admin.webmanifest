{
  "id": "/admin/",
  "name": "Bagdogra Airport Taxi office",
  "short_name": "Taxi office",
  "description": "Bookings, pickups, payments and itineraries for the Bagdogra Airport Taxi team.",
  "start_url": "/admin/",
  "scope": "/admin/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#f4f5f7",
  "theme_color": "#111111",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/admin-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/admin-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "New booking", "url": "/admin/bookings/new/", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Bookings", "url": "/admin/bookings/", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Payments", "url": "/admin/payments/", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] }
  ]
}
