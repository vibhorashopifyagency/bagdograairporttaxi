{
  "name": "bagdograairporttaxi",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "bagdograairporttaxi.com: airport taxi and tour packages across North Bengal and Sikkim.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node scripts/fetch-google-reviews.mjs && node --env-file-if-exists=.env scripts/db-migrate.mjs --if-configured && node --env-file-if-exists=.env scripts/content-pull.mjs && node --env-file-if-exists=.env scripts/content-photos.mjs",
    "build": "astro build",
    "postbuild": "node scripts/verify-build.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "og": "node scripts/make-og.mjs",
    "reviews": "node scripts/fetch-google-reviews.mjs",
    "photos": "node scripts/fetch-photos.mjs",
    "audit:google": "node .claude/skills/google-search-docs/scripts/audit-site.mjs dist",
    "check:live": "node scripts/check-live.mjs https://bagdograairporttaxi.com",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env scripts/db-migrate.mjs",
    "db:local": "node scripts/db-local.mjs",
    "db:seed": "node --env-file-if-exists=.env scripts/db-seed.mjs",
    "db:backup": "node --env-file-if-exists=.env scripts/db-backup.mjs",
    "db:restore": "node --env-file-if-exists=.env scripts/db-restore.mjs",
    "content:pull": "node --env-file-if-exists=.env scripts/content-pull.mjs && node --env-file-if-exists=.env scripts/content-photos.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/vercel": "^11.0.16",
    "@tailwindcss/vite": "^4.3.3",
    "@vercel/blob": "^2.8.1",
    "astro": "^7.2.4",
    "better-auth": "^1.7.12",
    "drizzle-orm": "^0.45.4",
    "jsqr": "^1.4.0",
    "pg": "^8.23.1",
    "tailwindcss": "^4.3.3",
    "uqr": "^0.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.11",
    "@electric-sql/pglite": "^0.5.10",
    "@electric-sql/pglite-socket": "^0.2.13",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "sharp": "^0.35.3",
    "typescript": "^6.0.3"
  }
}
